---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLangFromUrl, useTranslations } from '../utils/i18n';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<header class="fixed top-0 left-0 right-0 z-50 bg-white/75 backdrop-blur-2xl border-b border-black/5">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
    <div class="h-[76px] flex items-center justify-between">
      <a href={`/${lang}/`} class="flex items-center shrink-0" aria-label="Banggai Wonderland home">
        <img src="/images/logo.png" alt="Banggai Wonderland" class="h-[64px] md:h-[72px] w-auto object-contain" />
      </a>
      <nav class="hidden lg:flex items-center gap-8">
        <a href={`/${lang}/destinations/`} class="text-[13px] font-medium text-ocean-900/75 hover:text-ocean-900 transition">{t('nav.destinations')}</a>
        <a href={`/${lang}/packages/`} class="text-[13px] font-medium text-ocean-900/75 hover:text-ocean-900 transition">{t('nav.packages')}</a>
        <a href={`/${lang}/gallery/`} class="text-[13px] font-medium text-ocean-900/75 hover:text-ocean-900 transition">{t('nav.gallery')}</a>
        <a href={`/${lang}/blog/`} class="text-[13px] font-medium text-ocean-900/75 hover:text-ocean-900 transition">{t('nav.blog')}</a>
        <a href={`/${lang}/about/`} class="text-[13px] font-medium text-ocean-900/75 hover:text-ocean-900 transition">{t('nav.about')}</a>
      </nav>
      <div class="hidden lg:flex items-center gap-5"><LanguageSwitcher /><a href="https://wa.me/6285820830530" target="_blank" rel="noopener noreferrer" class="rounded-full bg-ocean-900 text-white px-5 py-2.5 text-[13px] font-semibold hover:bg-ocean-800 transition">{t('btn.book')}</a></div>
      <button id="mobile-menu-btn" type="button" class="lg:hidden text-ocean-900 p-2" aria-label="Toggle menu" aria-expanded="false"><svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path id="menu-icon-path" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M4 7h16M4 12h16M4 17h16"/></svg></button>
    </div>
  </div>
  <div id="mobile-menu" class="hidden lg:hidden bg-white/95 backdrop-blur-2xl border-t border-black/5">
    <div class="px-5 pt-4 pb-7 space-y-1">
      <a href={`/${lang}/destinations/`} class="block py-3 text-base font-medium">{t('nav.destinations')}</a><a href={`/${lang}/packages/`} class="block py-3 text-base font-medium">{t('nav.packages')}</a><a href={`/${lang}/gallery/`} class="block py-3 text-base font-medium">{t('nav.gallery')}</a><a href={`/${lang}/blog/`} class="block py-3 text-base font-medium">{t('nav.blog')}</a><a href={`/${lang}/about/`} class="block py-3 text-base font-medium">{t('nav.about')}</a>
      <div class="pt-4 mt-2 border-t border-black/5"><LanguageSwitcher mobile={true} /></div>
      <a href="https://wa.me/6285820830530" target="_blank" rel="noopener noreferrer" class="mt-5 block text-center rounded-full bg-ocean-900 text-white py-3.5 font-semibold">{t('btn.book')}</a>
    </div>
  </div>
</header>
<script>
const btn=document.getElementById('mobile-menu-btn');const menu=document.getElementById('mobile-menu');const path=document.getElementById('menu-icon-path');
if(btn&&menu&&path){btn.addEventListener('click',()=>{const open=menu.classList.toggle('hidden')===false;btn.setAttribute('aria-expanded',String(open));path.setAttribute('d',open?'M6 18L18 6M6 6l12 12':'M4 7h16M4 12h16M4 17h16')})}
</script>
