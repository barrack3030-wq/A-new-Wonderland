---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLangFromUrl, useTranslations } from '../utils/i18n';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<header class="bw-site-header fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-xl border-b border-black/5">
  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
    <div class="bw-site-header-row h-[72px] md:h-[84px] flex items-center justify-between">
      <a href={'/' + lang + '/'} class="bw-header-home flex items-center shrink-0" aria-label="Banggai Wonderland home">
        <img src="/images/logo.png" alt="Banggai Wonderland" class="h-[58px] md:h-[72px] w-auto object-contain" />
      </a>

      <nav class="bw-desktop-nav hidden lg:flex items-center gap-8" aria-label="Main navigation">
        <a href={'/' + lang + '/destinations/'} class="text-[13px] font-medium text-ocean-900/75 hover:text-ocean-900 transition">{t('nav.destinations')}</a>
        <a href={'/' + lang + '/jasa-tour-luwuk-banggai/'} class="text-[13px] font-medium text-ocean-900/75 hover:text-ocean-900 transition">{lang === 'id' ? 'Paket & Jasa Tour' : lang === 'es' ? 'Paquetes y Tours' : lang === 'fr' ? 'Forfaits & Tours' : 'Packages & Tours'}</a>
        <a href={'/' + lang + '/gallery/'} class="text-[13px] font-medium text-ocean-900/75 hover:text-ocean-900 transition">{t('nav.gallery')}</a>
        <a href={'/' + lang + '/blog/'} class="text-[13px] font-medium text-ocean-900/75 hover:text-ocean-900 transition">{t('nav.blog')}</a>
        <a href={'/' + lang + '/about/'} class="text-[13px] font-medium text-ocean-900/75 hover:text-ocean-900 transition">{t('nav.about')}</a>
      </nav>

      <div class="bw-desktop-actions hidden lg:flex items-center gap-5">
        <LanguageSwitcher />
        <a href="https://wa.me/6285820830530" target="_blank" rel="noopener noreferrer" class="rounded-full bg-ocean-900 text-white px-5 py-2.5 text-[13px] font-semibold hover:bg-ocean-800 transition">Travel with us</a>
      </div>

      <div class="bw-mobile-controls" aria-label="Mobile navigation controls">
        <LanguageSwitcher mobileHeader={true} />
        <details id="mobile-menu-disclosure" class="bw-mobile-menu-disclosure">
          <summary class="bw-mobile-menu-button" aria-label="Buka atau tutup menu navigasi" aria-controls="mobile-menu">
            <svg class="bw-menu-icon bw-hamburger-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
            <svg class="bw-menu-icon bw-close-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
              <path d="M6 6l12 12M18 6L6 18" />
            </svg>
          </summary>
          <div id="mobile-menu" class="bw-mobile-menu-panel">
            <nav aria-label="Mobile navigation links">
              <a href={'/' + lang + '/destinations/'}>{t('nav.destinations')}</a>
              <a href={'/' + lang + '/jasa-tour-luwuk-banggai/'}>{lang === 'id' ? 'Paket & Jasa Tour' : lang === 'es' ? 'Paquetes y Tours' : lang === 'fr' ? 'Forfaits & Tours' : 'Packages & Tours'}</a>
              <a href={'/' + lang + '/gallery/'}>{t('nav.gallery')}</a>
              <a href={'/' + lang + '/blog/'}>{t('nav.blog')}</a>
              <a href={'/' + lang + '/about/'}>{t('nav.about')}</a>
              <div class="bw-mobile-language-links">
                <LanguageSwitcher mobile={true} />
              </div>
              <a href="https://wa.me/6285820830530" target="_blank" rel="noopener noreferrer" class="bw-mobile-whatsapp">Travel with us</a>
            </nav>
          </div>
        </details>
      </div>
    </div>
  </div>
</header>

<style>
  .bw-site-header {
    --bw-header-height: 72px;
    height: var(--bw-header-height);
    min-height: var(--bw-header-height);
    border-radius: 0 !important;
    overflow: visible !important;
    box-shadow: none !important;
  }

  .bw-site-header > .max-w-7xl { height: var(--bw-header-height); }
  .bw-site-header-row { min-height: var(--bw-header-height); }
  .bw-mobile-controls { display: none; }

  .bw-mobile-menu-disclosure { position: static; }
  .bw-mobile-menu-button {
    list-style: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    margin: 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: #062d3a;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .bw-mobile-menu-button::-webkit-details-marker { display: none; }
  .bw-mobile-menu-button:focus-visible {
    outline: 2px solid rgba(20, 139, 158, 0.65);
    outline-offset: 2px;
  }
  .bw-menu-icon { display: block; width: 27px; height: 27px; }
  .bw-close-icon { display: none; }
  .bw-mobile-menu-disclosure[open] .bw-hamburger-icon { display: none; }
  .bw-mobile-menu-disclosure[open] .bw-close-icon { display: block; }

  .bw-mobile-menu-panel { display: none; }
  .bw-mobile-menu-disclosure[open] .bw-mobile-menu-panel {
    display: block;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    bottom: auto;
    z-index: 102;
    width: 100%;
    max-height: calc(100vh - var(--bw-header-height));
    max-height: calc(100dvh - var(--bw-header-height));
    overflow-y: auto;
    overscroll-behavior: contain;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(6, 45, 58, 0.1);
    background: #ffffff;
  }
  .bw-mobile-menu-panel nav { display: block; padding: 12px 20px 28px; }
  .bw-mobile-menu-panel nav > a:not(.bw-mobile-whatsapp) {
    display: block;
    padding: 15px 0;
    border-bottom: 1px solid rgba(6, 45, 58, 0.1);
    color: #062d3a;
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
  }
  .bw-mobile-language-links {
    padding: 18px 0 10px;
    border-bottom: 1px solid rgba(6, 45, 58, 0.1);
  }
  .bw-mobile-whatsapp {
    display: block;
    margin-top: 18px;
    padding: 14px 16px;
    border-radius: 9999px;
    background: #062d3a;
    color: #ffffff;
    text-align: center;
    text-decoration: none;
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .bw-site-header { --bw-header-height: 84px; }
  }

  @media screen and (max-width: 1023px), screen and (hover: none) and (pointer: coarse) {
    .bw-desktop-nav,
    .bw-desktop-actions { display: none !important; }
    .bw-mobile-controls {
      display: flex !important;
      align-items: center;
      justify-content: flex-end;
      gap: 8px;
      flex: 0 0 auto;
      position: relative;
      z-index: 103;
    }
  }

  @media screen and (min-width: 1024px) and (hover: hover) and (pointer: fine) {
    .bw-mobile-controls { display: none !important; }
  }

  @media (max-width: 767px) {
    .bw-site-header > .max-w-7xl { padding-left: 16px; padding-right: 16px; }
    .bw-site-header .bw-header-home img { max-height: 58px; width: auto; }
  }
</style>
