---
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../utils/i18n';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const slugParts = post.slug.split('/');
const postSlug = slugParts.slice(1).join('/');

const formattedDate = new Intl.DateTimeFormat(lang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(post.data.pubDate);

// Keep Blog Cards consistent with the article detail page.
// Some existing AI-generated articles may contain an outdated or generic
// image path in frontmatter, while the detail page resolves the correct
// destination-specific image.
const postText = `${post.data.title} ${post.data.description} ${(post.data.tags || []).join(' ')}`.toLowerCase();
const isMbuangMbuang = postText.includes('mbuang-mbuang') || postText.includes('mbuang mbuang');
const resolvedImage = isMbuangMbuang
  ? 'https://upload.wikimedia.org/wikipedia/commons/6/64/Pantai_Pasir_Panjang_-_Banggai_Laut.jpg'
  : post.data.image;
const resolvedImageAlt = isMbuangMbuang
  ? 'Pasir Panjang Beach on Mbuang-Mbuang Island, Banggai Laut, Central Sulawesi'
  : (post.data.imageAlt || post.data.title);
---

<a href={`/${lang}/blog/${postSlug}/`} class={`group flex flex-col bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 border border-sand-200 overflow-hidden h-full ${featured ? 'lg:flex-row lg:min-h-[390px]' : ''}`}>
  <div class={`relative overflow-hidden ${featured ? 'h-64 sm:h-80 lg:h-auto lg:w-[54%] lg:min-h-[390px]' : 'h-56'}`}>
    <img 
      src={resolvedImage} 
      alt={resolvedImageAlt} 
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      loading={featured ? 'eager' : 'lazy'}
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ocean-950/45 via-transparent to-transparent opacity-70"></div>
    <div class="absolute top-4 left-4 flex flex-wrap gap-2">
      {post.data.tags?.slice(0, 2).map(tag => (
        <span class="bg-white/90 backdrop-blur-sm text-ocean-900 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide">
          {tag}
        </span>
      ))}
    </div>
  </div>
  
  <div class={`${featured ? 'p-7 sm:p-9 lg:p-10 lg:w-[46%] lg:flex lg:flex-col lg:justify-center' : 'p-6 flex-grow flex flex-col'}`}>
    <div class="flex items-center text-xs text-ocean-500 mb-3 uppercase tracking-wider font-semibold">
      <span>{formattedDate}</span>
      <span class="mx-2">•</span>
      <span>{post.data.author}</span>
    </div>

    <h3 class={`${featured ? 'font-serif text-2xl sm:text-3xl lg:text-4xl leading-tight mb-4' : 'font-serif text-xl mb-3'} font-bold text-ocean-900 group-hover:text-turquoise-600 transition-colors ${featured ? '' : 'line-clamp-2'}`}>
      {post.data.title}
    </h3>
    
    <p class={`${featured ? 'text-base leading-relaxed mb-7' : 'text-sm line-clamp-3 mb-6'} text-ocean-600 flex-grow`}>
      {post.data.description}
    </p>
    
    <div class="mt-auto flex items-center text-turquoise-600 font-bold group-hover:text-turquoise-500 transition-colors text-sm uppercase tracking-wider">
      {t('blog.read_more')}
      <svg class="w-4 h-4 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
    </div>
  </div>
</a>
