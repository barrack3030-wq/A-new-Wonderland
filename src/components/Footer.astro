---
import { getLangFromUrl, useTranslations } from '../utils/i18n';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="bg-ocean-800 text-white pt-14 pb-7 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-tr from-ocean-900 via-ocean-800 to-ocean-600 opacity-90"></div>
  <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-12 relative z-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12 mb-10">
      <div class="min-w-0">
        <a href={`/${lang}/`} class="inline-block">
          <h2 class="text-xl font-serif font-bold text-white tracking-wide">Banggai Wonderland</h2>
        </a>
        <p class="text-ocean-100 text-sm leading-relaxed mt-4 max-w-xs">{t('footer.desc')}</p>
      </div>

      <div>
        <h3 class="font-serif text-lg font-semibold mb-5 text-white">{t('footer.nav')}</h3>
        <ul class="space-y-2.5">
          <li><a href={`/${lang}/destinations/`} class="text-ocean-100 hover:text-turquoise-400 text-sm transition-colors">{t('nav.destinations')}</a></li>
          <li><a href={`/${lang}/packages/`} class="text-ocean-100 hover:text-turquoise-400 text-sm transition-colors">{t('nav.packages')}</a></li>
          <li><a href={`/${lang}/blog/`} class="text-ocean-100 hover:text-turquoise-400 text-sm transition-colors">{t('nav.blog')}</a></li>
          <li><a href={`/${lang}/about/`} class="text-ocean-100 hover:text-turquoise-400 text-sm transition-colors">{t('nav.about')}</a></li>
          <li><a href={`/${lang}/contact/`} class="text-ocean-100 hover:text-turquoise-400 text-sm transition-colors">{t('nav.contact')}</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-serif text-lg font-semibold mb-5 text-white">{t('footer.contact')}</h3>
        <ul class="space-y-3">
          <li class="flex items-start text-sm text-ocean-100">
            <svg class="w-5 h-5 mr-3 mt-0.5 text-turquoise-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            <span>Luwuk, Banggai,<br/>Central Sulawesi, Indonesia</span>
          </li>
          <li class="flex items-center text-sm text-ocean-100">
            <svg class="w-5 h-5 mr-3 text-turquoise-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            <a href="mailto:zulaji33@gmail.com" class="hover:text-turquoise-400 transition-colors">zulaji33@gmail.com</a>
          </li>
          <li class="flex items-center text-sm text-ocean-100">
            <svg class="w-5 h-5 mr-3 text-turquoise-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.11 17.205c-.275-.137-1.627-.802-1.88-.894-.252-.092-.435-.137-.618.138-.183.275-.71.894-.87 1.077-.16.183-.32.206-.595.069-.275-.138-1.162-.428-2.214-1.365-.818-.73-1.37-1.632-1.531-1.907-.16-.275-.017-.423.12-.56.123-.122.275-.32.413-.48.137-.16.183-.275.275-.458.092-.183.046-.343-.023-.48-.069-.138-.618-1.49-.847-2.04-.223-.535-.45-.463-.618-.471-.16-.008-.343-.01-.526-.01s-.48.069-.732.343c-.252.275-.962.94-.962 2.293s.985 2.66 1.122 2.844c.138.183 1.94 2.963 4.7 4.154.657.284 1.17.454 1.57.581.66.21 1.26.18 1.735.109.53-.079 1.627-.665 1.856-1.306.229-.642.229-1.191.16-1.306-.068-.114-.252-.183-.526-.32z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.52 3.48A11.82 11.82 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.423-8.421z"></path></svg>
            <a href="https://wa.me/6285820830530" class="hover:text-turquoise-400 transition-colors">+62 858-2083-0530</a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="font-serif text-lg font-semibold mb-5 text-white">{t('footer.follow')}</h3>
        <a href="https://www.instagram.com/banggaiwonderland/" target="_blank" rel="noopener noreferrer" class="instagram-link w-11 h-11 rounded-full bg-ocean-800 inline-flex items-center justify-center hover:bg-turquoise-500 transition-colors text-white" aria-label="Instagram">
          <svg class="w-6 h-6 block" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.9"></rect>
            <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.9"></circle>
            <circle cx="17.4" cy="6.7" r="1.15" fill="currentColor"></circle>
          </svg>
        </a>
      </div>
    </div>

    <div class="border-t border-white/10 pt-6 flex flex-col md:flex-row justify-between items-center gap-3">
      <p class="text-ocean-200 text-xs md:text-sm">&copy; {new Date().getFullYear()} Banggai Wonderland. All rights reserved.</p>
    </div>
  </div>
</footer>
