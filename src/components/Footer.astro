---
import { getLangFromUrl, useTranslations } from '../utils/i18n';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<footer class="bg-ocean-800 text-white pt-16 pb-8 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-tr from-ocean-900 via-ocean-800 to-ocean-600 opacity-90"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <div class="space-y-4">
        <a href={`/${lang}/`} class="inline-block"><h2 class="text-2xl font-serif font-bold text-white tracking-wide">Banggai Wonderland</h2></a>
        <p class="text-ocean-100 text-sm leading-relaxed mt-4">{t('footer.desc')}</p>
      </div>
      <div>
        <h3 class="font-serif text-lg font-semibold mb-6 text-white">{t('footer.nav')}</h3>
        <ul class="space-y-3">
          <li><a href={`/${lang}/destinations/`} class="text-ocean-100 hover:text-turquoise-400 text-sm transition-colors">{t('nav.destinations')}</a></li>
          <li><a href={`/${lang}/packages/`} class="text-ocean-100 hover:text-turquoise-400 text-sm transition-colors">{t('nav.packages')}</a></li>
          <li><a href={`/${lang}/blog/`} class="text-ocean-100 hover:text-turquoise-400 text-sm transition-colors">{t('nav.blog')}</a></li>
          <li><a href={`/${lang}/about/`} class="text-ocean-100 hover:text-turquoise-400 text-sm transition-colors">{t('nav.about')}</a></li>
          <li><a href={`/${lang}/contact/`} class="text-ocean-100 hover:text-turquoise-400 text-sm transition-colors">{t('nav.contact')}</a></li>
        </ul>
      </div>
      <div>
        <h3 class="font-serif text-lg font-semibold mb-6 text-white">{t('footer.contact')}</h3>
        <ul class="space-y-4">
          <li class="flex items-start text-sm text-ocean-100"><svg class="w-5 h-5 mr-3 text-turquoise-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg><span>Luwuk, Banggai,<br/>Central Sulawesi, Indonesia</span></li>
          <li class="flex items-center text-sm text-ocean-100"><svg class="w-5 h-5 mr-3 text-turquoise-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 00-2-2h14"></path></svg><a href="mailto:zulaji33@gmail.com" class="hover:text-turquoise-400 transition-colors">zulaji33@gmail.com</a></li>
          <li class="flex items-center text-sm text-ocean-100"><svg class="w-5 h-5 mr-3 text-turquoise-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a11.815 11.815 0 012.893 6.994c0 5.45-4.437 9.884-9.885 9.884h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c0 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 01-8.413Z"></path></svg><a href="https://wa.me/6285820830530" class="hover:text-turquoise-400 transition-colors">+62 858-2083-0530</a></li>
        </ul>
      </div>
      <div>
        <h3 class="font-serif text-lg font-semibold mb-6 text-white">{t('footer.follow')}</h3>
        <a href="https://www.instagram.com/aji_zulficar?stkn=ZWVxM216cWY3Nno0" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-ocean-800 inline-flex items-center justify-center hover:bg-turquoise-500 transition-colors text-white" aria-label="Instagram">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.01-4.043-.06-.975-.045-1.504-.207-1.857-.344-.467-.182-.8-.398-1.15-.748-.35-.35-.566-.683-.748-1.15-.137-.353-.3-.882-.344-1.857-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247.8-.398 1.15-.748.35-.35.683-.566 1.15-.748.353-.137.882-.3 1.857-.344 1.023-.047 1.351-.058 3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" /></svg>
        </a>
      </div>
    </div>
    <div class="border-t border-ocean-800 pt-8 flex flex-col md:flex-row justify-between items-center"><p class="text-ocean-200 text-sm">&copy; {new Date().getFullYear()} Banggai Wonderland. All rights reserved.</p></div>
  </div>
</footer>
