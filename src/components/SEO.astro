---
import { getCollection } from 'astro:content';
import { languages } from '../utils/i18n';

interface Props {
  title: string;
  description: string;
  seoTitle?: string;
  seoDescription?: string;
  ogImage?: string;
  imageAlt?: string;
  schema?: any;
}

const {
  title,
  description,
  seoTitle,
  seoDescription,
  ogImage = '/images/og-default.jpg',
  imageAlt,
  schema
} = Astro.props;

const finalTitle = seoTitle || title;
const finalDescription = seoDescription || description;
const finalImageAlt = imageAlt || finalTitle;
const siteUrl = Astro.site || new URL(Astro.url.origin);
const normalizedPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const currentUrl = new URL(normalizedPath, siteUrl).href;

const pathParts = Astro.url.pathname.split('/').filter(Boolean);
const currentLangCode = pathParts[0] && Object.keys(languages).includes(pathParts[0]) ? pathParts[0] : 'id';
const section = pathParts[1] || '';

// Only emit hreflang links for language versions that actually exist.
let alternateLinks: { lang: string; href: string }[] = [];
const contentSections = ['destinations', 'packages', 'blog'];

if (!section) {
  alternateLinks = Object.keys(languages).map(langCode => ({
    lang: langCode,
    href: new URL(`/${langCode}/`, siteUrl).href
  }));
} else if (!contentSections.includes(section)) {
  // Core routes currently share the same route structure across supported languages.
  alternateLinks = Object.keys(languages).map(langCode => ({
    lang: langCode,
    href: new URL(`/${langCode}/${pathParts.slice(1).join('/')}/`, siteUrl).href
  }));
} else {
  let entries: any[] = [];
  if (section === 'destinations') entries = await getCollection('destinations');
  if (section === 'packages') entries = await getCollection('packages');
  if (section === 'blog') entries = await getCollection('blog');

  const currentEntry = entries.find(entry => {
    const [entryLang, ...slugParts] = entry.slug.split('/');
    return entryLang === currentLangCode && slugParts.join('/') === pathParts.slice(2).join('/');
  });

  if (currentEntry) {
    const currentImage = currentEntry.data?.image;
    const currentLocation = currentEntry.data?.location;

    alternateLinks = Object.keys(languages)
      .map(langCode => {
        const candidates = entries.filter(entry => {
          const [entryLang] = entry.slug.split('/');
          if (entryLang !== langCode) return false;
          const sameImage = currentImage && entry.data?.image === currentImage;
          const sameLocation = currentLocation && entry.data?.location === currentLocation;
          return sameImage && (!currentLocation || !entry.data?.location || sameLocation);
        });
        const match = candidates[0];
        if (!match) return null;
        const [, ...slugParts] = match.slug.split('/');
        return {
          lang: langCode,
          href: new URL(`/${langCode}/${section}/${slugParts.join('/')}/`, siteUrl).href
        };
      })
      .filter(Boolean) as { lang: string; href: string }[];
  }
}

const localeMap: Record<string, string> = {
  id: 'id_ID',
  en: 'en_US',
  es: 'es_ES',
  fr: 'fr_FR',
  zh: 'zh_CN',
  it: 'it_IT'
};

const baseSchema = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: 'Banggai Wonderland',
  image: new URL('/images/logo.png', siteUrl).href,
  '@id': siteUrl.href,
  url: siteUrl.href,
  telephone: '+6285820830530',
  description: 'Travel experiences and private trips in Banggai Islands, Indonesia.',
  mainEntityOfPage: currentUrl
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Banggai Wonderland',
  url: siteUrl.href,
  inLanguage: currentLangCode
};

const finalSchema = schema ? [baseSchema, websiteSchema, schema] : [baseSchema, websiteSchema];
const defaultLink = alternateLinks.find(link => link.lang === 'en') || alternateLinks.find(link => link.lang === 'id');
---

<title>{finalTitle}</title>
<meta name="description" content={finalDescription} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="author" content="Banggai Wonderland" />
<link rel="canonical" href={currentUrl} />

{alternateLinks.map(link => (
  <link rel="alternate" hreflang={link.lang} href={link.href} />
))}
{defaultLink && <link rel="alternate" hreflang="x-default" href={defaultLink.href} />}

<meta property="og:type" content="website" />
<meta property="og:url" content={currentUrl} />
<meta property="og:title" content={finalTitle} />
<meta property="og:description" content={finalDescription} />
<meta property="og:image" content={new URL(ogImage, siteUrl).href} />
<meta property="og:image:alt" content={finalImageAlt} />
<meta property="og:site_name" content="Banggai Wonderland" />
<meta property="og:locale" content={localeMap[currentLangCode] || 'en_US'} />
{alternateLinks.filter(link => link.lang !== currentLangCode).map(link => (
  <meta property="og:locale:alternate" content={localeMap[link.lang] || link.lang} />
))}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={currentUrl} />
<meta name="twitter:title" content={finalTitle} />
<meta name="twitter:description" content={finalDescription} />
<meta name="twitter:image" content={new URL(ogImage, siteUrl).href} />

<script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />
