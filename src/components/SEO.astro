---
import { getCollection } from 'astro:content';
import { languages } from '../utils/i18n';

interface Props {
  title: string;
  description: string;
  seoTitle?: string;
  seoDescription?: string;
  ogImage?: string;
  imageAlt?: string;
  schema?: any;
}

const { title, description, seoTitle, seoDescription, ogImage = '/images/og-default.jpg', imageAlt, schema } = Astro.props;
// Canonical production origin: keep every canonical, hreflang, OG URL, and schema URL on the same non-www host.
const siteUrl = new URL('https://banggaiwonderland.my.id');
const normalizedPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const currentUrl = new URL(normalizedPath, siteUrl).href;
const pathParts = Astro.url.pathname.split('/').filter(Boolean);
const currentLangCode = pathParts[0] && Object.keys(languages).includes(pathParts[0]) ? pathParts[0] : 'id';
const section = pathParts[1] || '';
// Booking query parameters only prefill the form; they are not separate SEO pages.
const isParameterizedBookingUrl = section === 'book' && Astro.url.searchParams.toString().length > 0;

const homepageSeo: Record<string, { title: string; description: string }> = {
  en: { title: 'Banggai Islands Travel Guide & Private Trips | Banggai Wonderland', description: 'Discover the Banggai Islands in Central Sulawesi with private trips to Paisu Pok, Piala Waterfall, Pulo Dua, Kamumu and other hidden destinations around Luwuk and Banggai.' },
  id: { title: 'Wisata Kepulauan Banggai & Private Trip | Banggai Wonderland', description: 'Jelajahi Kepulauan Banggai, Sulawesi Tengah melalui private trip ke Paisu Pok, Air Terjun Piala, Pulo Dua, Kamumu dan destinasi tersembunyi di sekitar Luwuk dan Banggai.' },
  es: { title: 'Islas Banggai: Viajes Privados y Guía de Viaje | Banggai Wonderland', description: 'Descubre las Islas Banggai en Sulawesi Central con viajes privados a Paisu Pok, la cascada Piala, Pulo Dua, Kamumu y otros destinos cerca de Luwuk y Banggai.' },
  fr: { title: 'Îles Banggai : Voyages Privés et Guide | Banggai Wonderland', description: 'Découvrez les îles Banggai à Sulawesi central avec des voyages privés vers Paisu Pok, la cascade de Piala, Pulo Dua, Kamumu et d’autres destinations autour de Luwuk et Banggai.' },
  zh: { title: '邦盖群岛旅行与私人定制之旅 | Banggai Wonderland', description: '探索印度尼西亚中苏拉威西的邦盖群岛，体验前往 Paisu Pok、Piala 瀑布、Pulo Dua、Kamumu 以及 Luwuk 和 Banggai 周边秘境的私人旅行。' }
};

const isHomepage = !section;
const effectiveSeoTitle = seoTitle || (isHomepage ? homepageSeo[currentLangCode]?.title : undefined) || title;
const effectiveDescription = seoDescription || (isHomepage ? homepageSeo[currentLangCode]?.description : undefined) || description;
const finalImageAlt = imageAlt || effectiveSeoTitle;

let alternateLinks: { lang: string; href: string }[] = [];
const contentSections = ['destinations', 'packages', 'blog'];
const idOnlySections = ['banggai-travel', 'banggai-trip', 'banggai-open-trip'];

if (!section) {
  alternateLinks = Object.keys(languages).map(langCode => ({ lang: langCode, href: new URL(`/${langCode}/`, siteUrl).href }));
} else if (idOnlySections.includes(section)) {
  // These SEO landing pages currently exist only in Indonesian. Never emit hreflang URLs that do not exist.
  alternateLinks = currentLangCode === 'id' ? [{ lang: 'id', href: currentUrl }] : [];
} else if (!contentSections.includes(section)) {
  alternateLinks = Object.keys(languages).map(langCode => ({ lang: langCode, href: new URL(`/${langCode}/${pathParts.slice(1).join('/')}/`, siteUrl).href }));
} else {
  let entries: any[] = [];
  if (section === 'destinations') entries = await getCollection('destinations');
  if (section === 'packages') entries = await getCollection('packages');
  if (section === 'blog') entries = await getCollection('blog');

  const currentEntry = entries.find(entry => {
    const [entryLang, ...slugParts] = entry.slug.split('/');
    return entryLang === currentLangCode && slugParts.join('/') === pathParts.slice(2).join('/');
  });

  if (currentEntry) {
    const [, ...currentSlugParts] = currentEntry.slug.split('/');
    const currentSlug = currentSlugParts.join('/');
    const translationKey = currentEntry.data?.translationKey || (section === 'blog' ? manualBlogTranslationKeys[currentSlug] : undefined);

    alternateLinks = Object.keys(languages).map(langCode => {
      const match = entries.find(entry => {
        const [entryLang, ...slugParts] = entry.slug.split('/');
        if (entryLang !== langCode) return false;
        if (translationKey && entry.data?.translationKey) return entry.data.translationKey === translationKey;
        return slugParts.join('/') === currentSlug;
      });
      if (!match) return null;
      const [, ...slugParts] = match.slug.split('/');
      return { lang: langCode, href: new URL(`/${langCode}/${section}/${slugParts.join('/')}/`, siteUrl).href };
    }).filter(Boolean) as { lang: string; href: string }[];
  }
}

const manualBlogTranslationKeys: Record<string, string> = {
  'cara-ke-paisu-pok-dari-luwuk': '2026-09-18-cara-ke-paisu-pok-dari-luwuk',
  'how-to-get-to-paisu-pok-from-luwuk': '2026-09-18-cara-ke-paisu-pok-dari-luwuk',
  'como-llegar-a-paisu-pok-desde-luwuk': '2026-09-18-cara-ke-paisu-pok-dari-luwuk',
  'comment-se-rendre-a-paisu-pok-depuis-luwuk': '2026-09-18-cara-ke-paisu-pok-dari-luwuk',
  'how-to-get-to-banggai-islands-from-luwuk': '2026-09-18-cara-menuju-kepulauan-banggai-dari-luwuk',
  'cara-menuju-kepulauan-banggai-dari-luwuk': '2026-09-18-cara-menuju-kepulauan-banggai-dari-luwuk',
  'como-llegar-islas-banggai-desde-luwuk': '2026-09-18-cara-menuju-kepulauan-banggai-dari-luwuk',
  'comment-rejoindre-les-iles-banggai-depuis-luwuk': '2026-09-18-cara-menuju-kepulauan-banggai-dari-luwuk',
  'luwuk-itinerary-1-3-4-5-days': '2026-09-18-itinerary-luwuk-1-3-4-5-hari',
  'itinerary-luwuk-1-3-4-5-hari': '2026-09-18-itinerary-luwuk-1-3-4-5-hari',
  'itinerario-luwuk-1-3-4-5-dias': '2026-09-18-itinerary-luwuk-1-3-4-5-hari',
  'itineraire-luwuk-1-3-4-5-jours': '2026-09-18-itinerary-luwuk-1-3-4-5-hari',
  'danau-paisu-pok-panduan-wisata-lengkap': '2026-09-18-danau-paisu-pok-panduan-wisata-lengkap',
  'paisu-pok-lake-complete-travel-guide': '2026-09-18-danau-paisu-pok-panduan-wisata-lengkap',
  'lago-paisu-pok-guia-de-viaje-completa': '2026-09-18-danau-paisu-pok-panduan-wisata-lengkap',
  'lac-paisu-pok-guide-de-voyage-complet': '2026-09-18-danau-paisu-pok-panduan-wisata-lengkap',
  'paisu-pok-hu-wan-zheng-lu-xing-gong-lue': '2026-09-18-danau-paisu-pok-panduan-wisata-lengkap',
};

const localeMap: Record<string, string> = { id: 'id_ID', en: 'en_US', es: 'es_ES', fr: 'fr_FR', zh: 'zh_CN' };
const baseSchema = {
  '@context': 'https://schema.org', '@type': 'TravelAgency', name: 'Banggai Wonderland',
  image: new URL('/images/logo.png', siteUrl).href, '@id': siteUrl.href, url: siteUrl.href,
  telephone: '+6285820830530', description: 'Travel experiences and private trips in Banggai Islands, Indonesia.', mainEntityOfPage: currentUrl
};
const websiteSchema = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Banggai Wonderland', url: siteUrl.href, inLanguage: currentLangCode };
const finalSchema = schema ? [baseSchema, websiteSchema, schema] : [baseSchema, websiteSchema];
const defaultLink = alternateLinks.find(link => link.lang === 'en') || alternateLinks.find(link => link.lang === 'id');
---
<title>{effectiveSeoTitle}</title>
<meta name="description" content={effectiveDescription} />
<meta name="robots" content={isParameterizedBookingUrl ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
<meta name="author" content="Banggai Wonderland" />
<link rel="canonical" href={currentUrl} />
{alternateLinks.map(link => <link rel="alternate" hreflang={link.lang} href={link.href} />)}
{defaultLink && <link rel="alternate" hreflang="x-default" href={defaultLink.href} />}
<meta property="og:type" content="website" />
<meta property="og:url" content={currentUrl} />
<meta property="og:title" content={effectiveSeoTitle} />
<meta property="og:description" content={effectiveDescription} />
<meta property="og:image" content={new URL(ogImage, siteUrl).href} />
<meta property="og:image:alt" content={finalImageAlt} />
<meta property="og:site_name" content="Banggai Wonderland" />
<meta property="og:locale" content={localeMap[currentLangCode] || 'en_US'} />
{alternateLinks.filter(link => link.lang !== currentLangCode).map(link => <meta property="og:locale:alternate" content={localeMap[link.lang] || link.lang} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={currentUrl} />
<meta name="twitter:title" content={effectiveSeoTitle} />
<meta name="twitter:description" content={effectiveDescription} />
<meta name="twitter:image" content={new URL(ogImage, siteUrl).href} />
<script type="application/ld+json" set:html={JSON.stringify(finalSchema)} />