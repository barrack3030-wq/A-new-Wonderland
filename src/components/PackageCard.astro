---
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../utils/i18n';

interface Props {
  pkg: CollectionEntry<'packages'>;
}

const { pkg } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Extract the actual slug without the language prefix
const slugParts = pkg.slug.split('/');
const pkgSlug = slugParts.slice(1).join('/');
---

<a href={`/${lang}/packages/${pkgSlug}/`} class="group flex flex-col md:flex-row bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 border border-sand-200 overflow-hidden mb-8">
  <div class="relative md:w-2/5 h-64 md:h-auto overflow-hidden">
    <img 
      src={pkg.data.image} 
      alt={pkg.data.imageAlt || pkg.data.title} 
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
      loading="lazy"
    />
    <div class="absolute top-4 left-4">
      <span class="bg-turquoise-500/90 backdrop-blur-sm text-ocean-900 text-xs font-bold px-3 py-1 rounded-full tracking-wide">
        {pkg.data.duration}
      </span>
    </div>
  </div>
  
  <div class="p-6 md:p-8 flex-grow flex flex-col md:w-3/5">
    <h3 class="font-serif text-2xl md:text-3xl font-bold text-ocean-900 mb-2 group-hover:text-turquoise-600 transition-colors">
      {pkg.data.title}
    </h3>
    
    <div class="flex items-center text-sm text-ocean-500 mb-4">
      <svg class="w-4 h-4 mr-2 flex-shrink-0 text-turquoise-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <span class="truncate font-medium">{pkg.data.destination}</span>
    </div>
    
    <p class="text-ocean-600 line-clamp-3 mb-6 flex-grow">
      {pkg.data.description}
    </p>

    <div class="flex flex-wrap gap-2 mb-6">
      {pkg.data.activities?.slice(0, 3).map(activity => (
        <span class="bg-sand-100 text-ocean-700 text-xs px-3 py-1 rounded-full border border-sand-200">
          {activity}
        </span>
      ))}
    </div>
    
    <div class="mt-auto flex items-center text-turquoise-600 font-bold group-hover:text-turquoise-500 transition-colors">
      {t('btn.explore')}
      <svg class="w-5 h-5 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
    </div>
  </div>
</a>
