---
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../utils/i18n';
interface Props { destination: CollectionEntry<'destinations'>; }
const { destination } = Astro.props;
const lang = getLangFromUrl(Astro.url); const t = useTranslations(lang);
const slugParts = destination.slug.split('/'); const destinationSlug = slugParts.slice(1).join('/');
---
<a href={`/${lang}/destinations/${destinationSlug}/`} class="group block overflow-hidden rounded-[1.75rem] bg-white border border-black/[0.06] shadow-[0_8px_30px_rgba(6,43,61,0.05)] hover:shadow-[0_18px_50px_rgba(6,43,61,0.12)] transition-all duration-500 h-full">
  <div class="relative aspect-[4/5] overflow-hidden">
    <img src={destination.data.image} alt={destination.data.imageAlt || destination.data.title} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.045]" loading="lazy" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-transparent to-black/10"></div>
    <span class="absolute left-5 top-5 rounded-full bg-white/85 backdrop-blur-xl px-3 py-1.5 text-[10px] font-bold tracking-[0.18em] uppercase text-ocean-900">{destination.data.category}</span>
    <div class="absolute left-5 right-5 bottom-5 text-white">
      <p class="text-[11px] text-white/70 mb-1">{destination.data.location}</p>
      <h3 class="font-serif text-2xl leading-tight font-medium tracking-[-0.02em]">{destination.data.title}</h3>
      <div class="max-h-0 overflow-hidden opacity-0 group-hover:max-h-20 group-hover:opacity-100 transition-all duration-500"><p class="text-xs text-white/80 leading-relaxed mt-2 line-clamp-2">{destination.data.description}</p></div>
    </div>
  </div>
</a>
