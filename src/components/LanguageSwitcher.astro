---
import { getLangFromUrl } from '../utils/i18n';

interface Props {
  mobile?: boolean;
}

const { mobile = false } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);

const languages = [
  { code: 'id', label: 'ID' },
  { code: 'en', label: 'EN' },
  { code: 'es', label: 'ES' },
  { code: 'fr', label: 'FR' },
  { code: 'zh', label: '中文' }
];

// Blog posts may use localized slugs, so simply replacing the language
// segment can lead to 404s. Keep a translation map for localized blog URLs.
const blogSlugTranslations: Record<string, Record<string, string>> = {
  '10-destinasi-wisata-terbaik-luwuk-banggai': {
    id: '10-destinasi-wisata-terbaik-luwuk-banggai',
    en: '10-best-destinations-in-luwuk-and-banggai',
    es: '10-mejores-destinos-luwuk-banggai',
    fr: '10-meilleurs-destinations-luwuk-banggai',
    zh: '10-best-destinations-luwuk-banggai'
  },
  '10-best-destinations-in-luwuk-and-banggai': {
    id: '10-destinasi-wisata-terbaik-luwuk-banggai',
    en: '10-best-destinations-in-luwuk-and-banggai',
    es: '10-mejores-destinos-luwuk-banggai',
    fr: '10-meilleurs-destinations-luwuk-banggai',
    zh: '10-best-destinations-luwuk-banggai'
  },
  '10-mejores-destinos-luwuk-banggai': {
    id: '10-destinasi-wisata-terbaik-luwuk-banggai',
    en: '10-best-destinations-in-luwuk-and-banggai',
    es: '10-mejores-destinos-luwuk-banggai',
    fr: '10-meilleurs-destinations-luwuk-banggai',
    zh: '10-best-destinations-luwuk-banggai'
  },
  '10-meilleurs-destinations-luwuk-banggai': {
    id: '10-destinasi-wisata-terbaik-luwuk-banggai',
    en: '10-best-destinations-in-luwuk-and-banggai',
    es: '10-mejores-destinos-luwuk-banggai',
    fr: '10-meilleurs-destinations-luwuk-banggai',
    zh: '10-best-destinations-luwuk-banggai'
  }
};

const getPath = (newLang: string) => {
  const pathParts = Astro.url.pathname.split('/');
  const currentSlug = pathParts[3] || '';
  const isBlogPost = pathParts[2] === 'blog' && currentSlug;

  if (isBlogPost && blogSlugTranslations[currentSlug]) {
    pathParts[1] = newLang;
    pathParts[3] = blogSlugTranslations[currentSlug][newLang] || currentSlug;
    return pathParts.join('/');
  }

  if (pathParts.length > 1 && languages.map(l => l.code).includes(pathParts[1])) {
    pathParts[1] = newLang;
  } else if (pathParts.length > 1 && pathParts[1] !== '') {
    pathParts.splice(1, 0, newLang);
  } else {
    pathParts[1] = newLang;
  }

  return pathParts.join('/') || '/';
}
---

{mobile ? (
  <div class="flex items-center space-x-2 flex-wrap gap-y-2">
    {languages.map((lang) => (
      <a
        href={getPath(lang.code)}
        class={`px-2 py-1 text-sm font-medium rounded transition-colors ${currentLang === lang.code ? 'bg-sand-200 text-ocean-900' : 'text-ocean-600 hover:bg-sand-100 hover:text-ocean-900'}`}
        aria-label={`Change language to ${lang.label}`}
      >
        {lang.label}
      </a>
    ))}
  </div>
) : (
  <div class="flex items-center space-x-1 border-r border-sand-200 pr-6">
    {languages.map((lang) => (
      <a
        href={getPath(lang.code)}
        class={`px-2 py-1 text-xs font-bold rounded transition-colors ${currentLang === lang.code ? 'bg-ocean-50 text-turquoise-600' : 'text-ocean-400 hover:text-ocean-900'}`}
        aria-label={`Change language to ${lang.label}`}
      >
        {lang.label}
      </a>
    ))}
  </div>
)}
