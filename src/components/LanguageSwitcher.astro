---
import { getCollection } from 'astro:content';
import { getLangFromUrl } from '../utils/i18n';

interface Props {
  mobile?: boolean;
}

const { mobile = false } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);

const languages = [
  { code: 'id', label: 'ID' },
  { code: 'en', label: 'EN' },
  { code: 'es', label: 'ES' },
  { code: 'fr', label: 'FR' },
  { code: 'zh', label: '中文' }
];

const blogPosts = await getCollection('blog');

const pathParts = Astro.url.pathname.split('/').filter(Boolean);
const pathLang = pathParts[0] || currentLang;
const isBlogPost = pathParts[1] === 'blog' && Boolean(pathParts[2]);
const currentSlug = isBlogPost ? pathParts.slice(2).join('/') : '';

const currentPost = isBlogPost
  ? blogPosts.find((post) => post.slug === `${pathLang}/${currentSlug}`)
  : undefined;

const normalize = (value: string) =>
  value
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, ' ')
    .trim();

const getFallbackTranslation = (newLang: string) => {
  if (!currentPost) return undefined;

  const currentTitle = normalize(currentPost.data.title);
  const currentDescription = normalize(currentPost.data.description || '');
  const currentTags = (currentPost.data.tags || []).map((tag) => normalize(tag));
  const currentWords = currentTitle.split(' ').filter((word) => word.length >= 5);
  const currentDate = currentPost.data.pubDate?.toISOString().slice(0, 10);

  const candidates = blogPosts.filter((post) => {
    if (!post.slug.startsWith(`${newLang}/`)) return false;
    const date = post.data.pubDate?.toISOString().slice(0, 10);
    return date === currentDate;
  });

  let best;
  let bestScore = 0;

  for (const candidate of candidates) {
    const title = normalize(candidate.data.title);
    const description = normalize(candidate.data.description || '');
    const tags = (candidate.data.tags || []).map((tag) => normalize(tag));
    let score = 0;

    // Strong destination anchors shared across translations.
    for (const word of currentWords) {
      if (title.includes(word)) score += 6;
      if (description.includes(word)) score += 2;
    }

    for (const tag of currentTags) {
      if (tags.includes(tag)) score += 8;
      if (title.includes(tag)) score += 3;
    }

    if (title.includes('mbuang') && currentTitle.includes('mbuang')) score += 30;
    if (title.includes('paisu') && currentTitle.includes('paisu')) score += 30;
    if (title.includes('piala') && currentTitle.includes('piala')) score += 30;

    if (score > bestScore) {
      bestScore = score;
      best = candidate;
    }
  }

  return bestScore >= 12 ? best : undefined;
};

const getPath = (newLang: string) => {
  if (isBlogPost) {
    const translationKey = currentPost?.data?.translationKey;

    if (translationKey) {
      const translatedPost = blogPosts.find(
        (post) =>
          post.data.translationKey === translationKey &&
          post.slug.startsWith(`${newLang}/`)
      );

      if (translatedPost) {
        const translatedSlug = translatedPost.slug.split('/').slice(1).join('/');
        return `/${newLang}/blog/${translatedSlug}/`;
      }
    }

    // Legacy articles created before translationKey: identify the matching
    // translation by date + destination/topic words instead of guessing a slug.
    const fallbackPost = getFallbackTranslation(newLang);
    if (fallbackPost) {
      const translatedSlug = fallbackPost.slug.split('/').slice(1).join('/');
      return `/${newLang}/blog/${translatedSlug}/`;
    }

    // Never create a guessed 404 URL.
    return `/${newLang}/blog/`;
  }

  const supportedCodes = languages.map((language) => language.code);
  const parts = [...pathParts];

  if (supportedCodes.includes(parts[0])) {
    parts[0] = newLang;
  } else {
    parts.unshift(newLang);
  }

  return `/${parts.join('/')}${parts.length ? '/' : ''}`;
};
---

{mobile ? (
  <div class="flex items-center space-x-2 flex-wrap gap-y-2">
    {languages.map((lang) => (
      <a
        href={getPath(lang.code)}
        class={`px-2 py-1 text-sm font-medium rounded transition-colors ${currentLang === lang.code ? 'bg-sand-200 text-ocean-900' : 'text-ocean-600 hover:bg-sand-100 hover:text-ocean-900'}`}
        aria-label={`Change language to ${lang.label}`}
      >
        {lang.label}
      </a>
    ))}
  </div>
) : (
  <div class="flex items-center space-x-1 border-r border-sand-200 pr-6">
    {languages.map((lang) => (
      <a
        href={getPath(lang.code)}
        class={`px-2 py-1 text-xs font-bold rounded transition-colors ${currentLang === lang.code ? 'bg-ocean-50 text-turquoise-600' : 'text-ocean-400 hover:text-ocean-900'}`}
        aria-label={`Change language to ${lang.label}`}
      >
        {lang.label}
      </a>
    ))}
  </div>
)}
