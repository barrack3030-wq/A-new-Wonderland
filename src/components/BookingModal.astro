---
import { getLangFromUrl, useTranslations } from '../utils/i18n';
import { getCollection } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const allPackages = await getCollection('packages');
const packages = allPackages.filter(p => p.id.startsWith(`${lang}/`));
---
<div id="booking-modal" class="fixed inset-0 z-[100] flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
  <div class="absolute inset-0 bg-ocean-900/60 backdrop-blur-sm" id="booking-modal-overlay"></div>
  
  <div class="relative bg-white w-full max-w-lg mx-4 max-h-[90vh] overflow-y-auto rounded-2xl shadow-2xl border border-sand-200 transform scale-95 transition-transform duration-300" id="booking-modal-content">
    <div class="sticky top-0 bg-white/90 backdrop-blur-md px-5 py-4 border-b border-sand-200 flex justify-between items-center z-10">
      <h2 class="text-xl font-serif font-bold text-ocean-900">Form Pemesanan</h2>
      <button id="booking-modal-close" class="text-ocean-500 hover:text-red-500 transition-colors p-2 rounded-full hover:bg-sand-100">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>
    
    <div class="p-5 md:p-6">
      <form id="global-booking-form" class="space-y-4">
        <div class="grid grid-cols-1 gap-4">
          <div>
            <label for="modal-name" class="block text-xs font-bold text-ocean-900 mb-1.5">Nama Lengkap / Full Name *</label>
            <input type="text" id="modal-name" required class="w-full px-4 py-2.5 rounded-lg border border-sand-300 focus:ring-2 focus:ring-turquoise-500 focus:border-turquoise-500 outline-none transition-all bg-sand-50/50 text-sm" placeholder="John Doe">
          </div>
          <div>
            <label for="modal-country" class="block text-xs font-bold text-ocean-900 mb-1.5">Asal Negara / Country of Origin *</label>
            <input type="text" id="modal-country" required class="w-full px-4 py-2.5 rounded-lg border border-sand-300 focus:ring-2 focus:ring-turquoise-500 focus:border-turquoise-500 outline-none transition-all bg-sand-50/50 text-sm" placeholder="Indonesia">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="modal-date" class="block text-xs font-bold text-ocean-900 mb-1.5">Tanggal / Date *</label>
            <input type="date" id="modal-date" required class="w-full px-4 py-2.5 rounded-lg border border-sand-300 focus:ring-2 focus:ring-turquoise-500 focus:border-turquoise-500 outline-none transition-all bg-sand-50/50 text-sm">
          </div>
          <div>
            <label for="modal-participants" class="block text-xs font-bold text-ocean-900 mb-1.5">Jumlah / People *</label>
            <input type="number" id="modal-participants" min="1" required class="w-full px-4 py-2.5 rounded-lg border border-sand-300 focus:ring-2 focus:ring-turquoise-500 focus:border-turquoise-500 outline-none transition-all bg-sand-50/50 text-sm" placeholder="2">
          </div>
        </div>
        
        <div class="grid grid-cols-1 gap-4">
          <div>
            <label for="modal-package" class="block text-xs font-bold text-ocean-900 mb-1.5">Pilihan Paket / Package Choice *</label>
            <select id="modal-package" required class="w-full px-4 py-2.5 rounded-lg border border-sand-300 focus:ring-2 focus:ring-turquoise-500 focus:border-turquoise-500 outline-none transition-all bg-sand-50/50 text-sm">
              <option value="" disabled selected>-- Select Package --</option>
              {packages.map(pkg => (
                <option value={pkg.data.title}>{pkg.data.title}</option>
              ))}
              <option value="Custom">Custom Package / Other</option>
            </select>
          </div>
        </div>
        
        <button type="submit" class="w-full bg-[#25D366] text-white font-bold text-base py-3 rounded-xl hover:bg-[#1ebe57] transition-colors shadow-md flex justify-center items-center mt-2">
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.489-1.761-1.663-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          Kirim via WhatsApp
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('booking-modal');
    const overlay = document.getElementById('booking-modal-overlay');
    const modalContent = document.getElementById('booking-modal-content');
    const closeBtn = document.getElementById('booking-modal-close');
    const form = document.getElementById('global-booking-form');
    
    // Function to open modal
    window.openBookingModal = function(e) {
      if (e) e.preventDefault();
      modal.classList.remove('hidden');
      // small delay to allow display:block to apply before animating opacity
      setTimeout(() => {
        modal.classList.remove('opacity-0');
        modalContent.classList.remove('scale-95');
        modalContent.classList.add('scale-100');
      }, 10);
    };

    // Function to close modal
    function closeModal() {
      modal.classList.add('opacity-0');
      modalContent.classList.remove('scale-100');
      modalContent.classList.add('scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 300);
    }

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (overlay) overlay.addEventListener('click', closeModal);

    // Intercept ALL WhatsApp links
    document.body.addEventListener('click', (e) => {
      const link = e.target.closest('a[href^="https://wa.me"]');
      if (link) {
        e.preventDefault();
        window.openBookingModal();
      }
    });

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        
        const name = (document.getElementById('modal-name') as HTMLInputElement).value;
        const country = (document.getElementById('modal-country') as HTMLInputElement).value;
        const date = (document.getElementById('modal-date') as HTMLInputElement).value;
        const participants = (document.getElementById('modal-participants') as HTMLInputElement).value;
        const packageSelected = (document.getElementById('modal-package') as HTMLSelectElement).value;
        
        const waNumber = '6285820830530'; // Admin WhatsApp number
        
        let message = `*Halo Banggai Wonderland!* 👋\nSaya ingin memesan paket wisata.\n\n`;
        message += `*Detail Pesanan:*\n`;
        message += `- Nama: ${name}\n`;
        message += `- Asal Negara: ${country}\n`;
        message += `- Tanggal Kedatangan: ${date}\n`;
        message += `- Jumlah Orang: ${participants} Orang\n`;
        message += `- Pilihan Paket: *${packageSelected}*\n`;
        
        const encodedMessage = encodeURIComponent(message);
        const waUrl = `https://wa.me/${waNumber}?text=${encodedMessage}`;
        
        window.open(waUrl, '_blank');
        closeModal();
      });
    }
  });
</script>
