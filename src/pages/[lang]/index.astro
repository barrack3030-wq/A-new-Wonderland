---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import DestinationCard from '../../components/DestinationCard.astro';
import BlogCard from '../../components/BlogCard.astro';
import { languages, useTranslations } from '../../utils/i18n';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as any);
const featuredSlugs = ['paisu-pok-lake', 'piala-waterfall', 'oyama-beach', 'pulau-dua-balantak'];
const allDestinations = await getCollection('destinations');
const featuredDestinations = featuredSlugs
  .map(slug => allDestinations.find(d => d.slug === `${lang}/${slug}`))
  .filter(Boolean);

const allBlogs = await getCollection('blog');
const latestBlogs = allBlogs
  .filter(b => b.id.startsWith(`${lang}/`))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const homeSeo = {
  en: {
    title: 'Banggai Islands Travel & Private Trips | Indonesia',
    description: 'Discover the Banggai Islands in Central Sulawesi with private trips to Paisu Pok, Piala Waterfall, Pulo Dua, Kamumu and other destinations around Luwuk and Banggai.'
  },
  id: {
    title: 'Wisata Kepulauan Banggai & Private Trip | Banggai Wonderland',
    description: 'Jelajahi Kepulauan Banggai, Sulawesi Tengah melalui private trip ke Paisu Pok, Air Terjun Piala, Pulo Dua, Kamumu dan destinasi menarik di sekitar Luwuk dan Banggai.'
  },
  es: {
    title: 'Viajes privados por las Islas Banggai | Indonesia',
    description: 'Descubre las Islas Banggai en Sulawesi Central con viajes privados a Paisu Pok, la cascada Piala, Pulo Dua, Kamumu y otros destinos de Luwuk y Banggai.'
  },
  fr: {
    title: 'Voyage privé aux îles Banggai | Indonésie',
    description: 'Découvrez les îles Banggai, dans le centre de Sulawesi, avec des voyages privés vers Paisu Pok, la cascade de Piala, Pulo Dua, Kamumu et les environs de Luwuk et Banggai.'
  },
  zh: {
    title: '邦盖群岛旅行与私人旅行 | Banggai Wonderland',
    description: '探索印度尼西亚中苏拉威西的邦盖群岛，前往 Paisu Pok、Piala 瀑布、Pulo Dua、Kamumu 以及 Luwuk 和 Banggai 周边目的地。'
  }
} as const;

const seo = homeSeo[lang as keyof typeof homeSeo] || homeSeo.en;
---

<BaseLayout title={seo.title} description={seo.description} seoTitle={seo.title} seoDescription={seo.description}>
  <main class="home-page">
    <section id="home" class="bw-hero">
      <div id="hero-media" class="bw-hero-media" aria-hidden="true">
        <iframe
          src="https://giphy.com/embed/86bAGxmMCGQU34Y"
          title="Banggai Islands ocean scene"
          class="bw-hero-frame"
          allow="autoplay; fullscreen"
          allowFullScreen
        ></iframe>
      </div>
      <div class="bw-hero-shade"></div>
      <div class="bw-hero-bottom"></div>

      <div class="bw-hero-top">
        <span>BANGGAI · INDONESIA</span>
        <span>PRIVATE JOURNEYS</span>
      </div>

      <div class="bw-hero-content">
        <p class="bw-eyebrow bw-eyebrow-light">{t('hero.welcome')}</p>
        <h1><span>{t('hero.title.1')}</span> <em>{t('hero.title.2')}</em></h1>
        <p class="bw-hero-description">{t('hero.desc')}</p>
        <div class="bw-hero-actions">
          <a href={`/${lang}/jasa-tour-luwuk-banggai/#packages`} class="bw-button bw-button-light">{t('btn.view_packages')} <span>↗</span></a>
          <a href={`/${lang}/destinations/`} class="bw-text-link bw-text-link-light">{t('btn.explore')} <span>→</span></a>
        </div>
      </div>

      <a href="#destinations" class="bw-scroll">SCROLL TO EXPLORE <span>↓</span></a>
      <div class="bw-hero-index">01 / 05</div>
    </section>

    <section id="destinations" class="bw-section bw-destinations">
      <div class="bw-container">
        <div class="bw-intro-row">
          <div>
            <p class="bw-eyebrow">THE BANGGAI ISLANDS</p>
            <h2>Not Bali. Not Raja Ampat.<br/><em>Something quieter.</em></h2>
          </div>
          <p class="bw-intro-copy">A different side of Indonesia: clear lagoons, quiet islands and coastal roads made for travelling slowly.</p>
        </div>

        {featuredDestinations.length > 0 && (
          <div class="bw-destination-grid">
            {featuredDestinations.slice(0, 3).map((destination, index) => (
              <div class={`bw-destination-item item-${index + 1}`}>
                <DestinationCard destination={destination} />
                <span class="bw-card-number">0{index + 1}</span>
              </div>
            ))}
          </div>
        )}

        <div class="bw-section-footer">
          <span>PLACES WORTH TRAVELLING FOR</span>
          <a href={`/${lang}/destinations/`} class="bw-text-link">Explore all destinations <span>→</span></a>
        </div>
      </div>
    </section>

    <section class="bw-proof">
      <div class="bw-container bw-proof-grid">
        <div class="bw-proof-title">
          <p class="bw-eyebrow bw-eyebrow-light">THE PROOF</p>
          <h2>Banggai has<br/><em>more than you think.</em></h2>
        </div>
        <div class="bw-stat">
          <strong>20<span>+</span></strong>
          <p>islands, beaches,<br/>lagoons & waterfalls</p>
        </div>
        <div class="bw-stat">
          <strong>01</strong>
          <p>local team,<br/>one-to-one planning</p>
        </div>
        <div class="bw-proof-note">
          <p>We design private journeys from Luwuk into the Banggai Islands, with routes built around your pace rather than a fixed group schedule.</p>
          <a href={`/${lang}/jasa-tour-luwuk-banggai/`} class="bw-text-link bw-text-link-light">See how we travel <span>→</span></a>
        </div>
      </div>
    </section>

    <section class="bw-section bw-way">
      <div class="bw-container bw-way-grid">
        <div>
          <p class="bw-eyebrow">THE WAY OF TRAVELING</p>
          <h2>Travel slowly.<br/><em>See more.</em></h2>
        </div>
        <div class="bw-way-list">
          <div><span>01</span><strong>Slow boat</strong><p>Let the islands set the rhythm.</p></div>
          <div><span>02</span><strong>Local stay</strong><p>Stay closer to the people and places.</p></div>
          <div><span>03</span><strong>Flexible pace</strong><p>Less rushing. More time in each place.</p></div>
          <div><span>04</span><strong>Private only</strong><p>A journey arranged around your trip.</p></div>
        </div>
      </div>
    </section>

    <section class="bw-section bw-journeys">
      <div class="bw-container">
        <div class="bw-section-heading">
          <div>
            <p class="bw-eyebrow">PRIVATE JOURNEYS</p>
            <h2>Choose your way<br/><em>through Banggai.</em></h2>
          </div>
          <a href={`/${lang}/jasa-tour-luwuk-banggai/#packages`} class="bw-text-link">View all journeys <span>→</span></a>
        </div>

        <div class="bw-journey-grid">
          <a href={`/${lang}/packages/luwuk-stopover/`} class="bw-journey-card">
            <img src="/images/asasa.jpg" alt="Luwuk private trip" loading="lazy"/>
            <div class="bw-journey-shade"></div>
            <div class="bw-journey-copy"><span>02 DAYS · 01 NIGHT</span><h3>Luwuk Stopover</h3><p>A short escape built around Luwuk and its coast.</p></div>
          </a>
          <a href={`/${lang}/packages/banggai-wonderland/`} class="bw-journey-card">
            <img src="/images/wonder.jpg" alt="Banggai Wonderland private trip" loading="lazy"/>
            <div class="bw-journey-shade"></div>
            <div class="bw-journey-copy"><span>04 DAYS · 03 NIGHTS</span><h3>Banggai Wonderland</h3><p>An island journey to the places you came for.</p></div>
          </a>
          <a href={`/${lang}/packages/ultimate-banggai/`} class="bw-journey-card">
            <img src="/images/Gemini_Generated_Image_xxtet3xxtet3xxte (4).jpg" alt="Ultimate Banggai private trip" loading="lazy"/>
            <div class="bw-journey-shade"></div>
            <div class="bw-journey-copy"><span>06 DAYS · 05 NIGHTS</span><h3>Ultimate Banggai</h3><p>Go deeper across the islands, without backtracking.</p></div>
          </a>
        </div>
      </div>
    </section>

    <section class="bw-journal">
      <div class="bw-container">
        <div class="bw-section-heading bw-journal-heading">
          <div>
            <p class="bw-eyebrow bw-eyebrow-light">THE JOURNAL</p>
            <h2>Travel deeper.</h2>
          </div>
          <a href={`/${lang}/blog/`} class="bw-text-link bw-text-link-light">All stories <span>→</span></a>
        </div>

        {latestBlogs.length > 0 && (
          <div class="bw-journal-grid">
            {latestBlogs.map((post, index) => (
              <a href={`/${lang}/blog/${post.slug.split('/').slice(1).join('/')}/`} class={`bw-story story-${index + 1}`}>
                <img src={post.data.image} alt={post.data.title} loading="lazy"/>
                <div class="bw-story-overlay"></div>
                <div class="bw-story-copy">
                  <span>{post.data.pubDate.toLocaleDateString(lang, { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                  <h3>{post.data.title}</h3>
                  <p>Read the story →</p>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>

    <section class="bw-knowledge">
      <div class="bw-container bw-knowledge-grid">
        <div>
          <p class="bw-eyebrow">PLAN WITH CONFIDENCE</p>
          <h2>Know where<br/><em>you are going.</em></h2>
        </div>
        <div class="bw-knowledge-copy">
          <p>Start with our practical guides for destinations, routes and trip planning across Luwuk and the Banggai Islands.</p>
          <div class="bw-knowledge-links">
            <a href={`/${lang}/destinations/paisu-pok-lake/`}>Paisu Pok guide <span>↗</span></a>
            <a href={`/${lang}/destinations/piala-waterfall/`}>Piala Waterfall <span>↗</span></a>
            <a href={`/${lang}/blog/`}>Banggai travel journal <span>↗</span></a>
            <a href={`/${lang}/jasa-tour-luwuk-banggai/`}>Luwuk Banggai tour service <span>↗</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="bw-cta">
      <div class="bw-container bw-cta-inner">
        <p class="bw-eyebrow bw-eyebrow-light">BANGGAI WONDERLAND</p>
        <h2>Your Banggai story<br/><em>starts here.</em></h2>
        <p>Tell us your dates, interests and preferred pace. We will shape the route with you.</p>
        <a href="https://wa.me/6285820830530" target="_blank" rel="noopener noreferrer" class="bw-button bw-button-light">{t('btn.book')} <span>→</span></a>
      </div>
    </section>
  </main>

  <nav class="bw-mobile-nav" aria-label="Mobile navigation">
    <a href="#home"><span>⌂</span><small>Home</small></a>
    <a href="#destinations"><span>◉</span><small>Places</small></a>
    <a href="#journeys"><span>↗</span><small>Journeys</small></a>
    <a href="#journal"><span>▤</span><small>Journal</small></a>
    <a href="#contact"><span>→</span><small>Book</small></a>
  </nav>

  <WhatsAppButton />

  <style>
    .home-page { background: #f7f7f5; color: #062f3d; }
    .bw-container { width: min(1180px, calc(100% - 64px)); margin: 0 auto; }
    .bw-eyebrow { margin: 0 0 20px; color: #4f7b88; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: .24em; text-transform: uppercase; }
    .bw-eyebrow-light { color: rgba(255,255,255,.48); }
    .bw-hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; overflow: hidden; background: #062f3d; color: white; }
    .bw-hero-media { position: absolute; inset: 0; transform-origin: center; will-change: transform, opacity; }
    .bw-hero-frame { position: absolute; left: 50%; top: 50%; width: 177.777778vh; height: 100vw; min-width: 100%; min-height: 100%; transform: translate(-50%, -50%); border: 0; }
    .bw-hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.16) 0%, rgba(0,0,0,.12) 38%, rgba(0,0,0,.74) 100%); }
    .bw-hero-bottom { position: absolute; inset: auto 0 0; height: 22%; background: linear-gradient(180deg, transparent, rgba(247,247,245,.08)); }
    .bw-hero-top { position: absolute; top: 30px; left: 0; right: 0; display: flex; justify-content: space-between; padding: 0 40px; color: rgba(255,255,255,.72); font-size: 9px; font-weight: 700; letter-spacing: .22em; }
    .bw-hero-content { position: relative; z-index: 2; width: min(1180px, calc(100% - 64px)); margin: 0 auto; padding: 150px 0 74px; }
    .bw-hero-content h1 { margin: 0; max-width: 1120px; font-family: 'Playfair Display', serif; font-size: clamp(3.4rem, 5.6vw, 5.75rem); font-weight: 500; line-height: .94; letter-spacing: -.045em; text-wrap: balance; }
    .bw-hero-content h1 span { color: white; } .bw-hero-content h1 em { color: rgba(255,255,255,.63); font-style: normal; }
    .bw-hero-description { max-width: 510px; margin: 34px 0 28px; color: rgba(255,255,255,.78); font-family: 'Plus Jakarta Sans', sans-serif; font-size: 15px; line-height: 1.7; }
    .bw-hero-actions { display: flex; gap: 24px; align-items: center; flex-wrap: wrap; }
    .bw-button { display: inline-flex; align-items: center; gap: 11px; min-height: 50px; padding: 0 23px; border-radius: 999px; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 12px; font-weight: 700; text-decoration: none; transition: .3s ease; }
    .bw-button:hover { transform: translateY(-2px); }
    .bw-button-light { background: white; color: #062f3d; }
    .bw-text-link { display: inline-flex; align-items: center; gap: 9px; color: #062f3d; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 12px; font-weight: 700; text-decoration: none; border-bottom: 1px solid rgba(6,47,61,.22); padding-bottom: 4px; }
    .bw-text-link span { transition: transform .3s ease; }
    .bw-text-link:hover span { transform: translateX(4px); }
    .bw-text-link-light { color: rgba(255,255,255,.86); border-color: rgba(255,255,255,.24); }
    .bw-scroll { position: absolute; left: 40px; bottom: 28px; z-index: 2; color: rgba(255,255,255,.45); font-size: 9px; font-weight: 700; letter-spacing: .2em; text-decoration: none; }
    .bw-scroll span { margin-left: 8px; }
    .bw-hero-index { position: absolute; right: 40px; bottom: 28px; z-index: 2; color: rgba(255,255,255,.4); font-size: 9px; letter-spacing: .15em; }
    .bw-section { padding: 120px 0; }
    .bw-destinations { background: #f7f7f5; }
    .bw-intro-row { display: grid; grid-template-columns: 1.35fr .65fr; gap: 80px; align-items: end; margin-bottom: 58px; }
    .bw-intro-row h2, .bw-section-heading h2, .bw-way h2, .bw-proof h2, .bw-knowledge h2, .bw-cta h2 { margin: 0; font-family: 'Playfair Display', serif; font-size: clamp(3rem, 5.2vw, 5.1rem); line-height: .96; letter-spacing: -.045em; font-weight: 500; }
    .bw-intro-row h2 em, .bw-section-heading h2 em, .bw-way h2 em, .bw-proof h2 em, .bw-knowledge h2 em, .bw-cta h2 em { color: #7f9aa2; font-style: normal; }
    .bw-intro-copy { max-width: 365px; margin: 0 0 6px; color: #65848d; font-size: 15px; line-height: 1.7; }
    .bw-destination-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; align-items: end; }
    .bw-destination-item { position: relative; }
    .bw-destination-item.item-2 { padding-bottom: 62px; }
    .bw-destination-item.item-3 { padding-bottom: 118px; }
    .bw-destination-item :global(a) { border-radius: 0; box-shadow: none; border: 0; }
    .bw-destination-item :global(.group) { border-radius: 0 !important; }
    .bw-destination-item :global(.group > div) { aspect-ratio: 0.76 !important; border-radius: 0 !important; }
    .bw-destination-item :global(.group > div > span) { left: 18px !important; top: 18px !important; }
    .bw-card-number { position: absolute; top: 14px; right: 14px; z-index: 2; color: rgba(255,255,255,.72); font-size: 9px; font-weight: 700; letter-spacing: .15em; }
    .bw-section-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 42px; padding-top: 18px; border-top: 1px solid rgba(6,47,61,.12); color: #6c8990; font-size: 9px; font-weight: 700; letter-spacing: .2em; }
    .bw-proof { padding: 115px 0; background: #062f3d; color: white; }
    .bw-proof-grid { display: grid; grid-template-columns: 1.4fr .6fr .6fr 1fr; gap: 44px; align-items: end; }
    .bw-proof-title h2 { font-size: clamp(3rem, 5vw, 4.8rem); }
    .bw-stat { padding-left: 28px; border-left: 1px solid rgba(255,255,255,.16); }
    .bw-stat strong { display: block; font-family: 'Playfair Display', serif; font-size: 4.5rem; line-height: 1; font-weight: 500; }
    .bw-stat strong span { color: rgba(255,255,255,.45); }
    .bw-stat p, .bw-proof-note p { margin: 12px 0 0; color: rgba(255,255,255,.52); font-size: 12px; line-height: 1.7; }
    .bw-proof-note { align-self: center; }
    .bw-proof-note p { margin: 0 0 22px; font-size: 13px; }
    .bw-way { background: white; }
    .bw-way-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 100px; }
    .bw-way-list { border-top: 1px solid rgba(6,47,61,.13); }
    .bw-way-list > div { display: grid; grid-template-columns: 48px 1fr 1fr; gap: 18px; align-items: center; padding: 19px 0; border-bottom: 1px solid rgba(6,47,61,.13); }
    .bw-way-list span { color: #88a0a7; font-size: 9px; font-weight: 700; letter-spacing: .12em; }
    .bw-way-list strong { font-size: 14px; }
    .bw-way-list p { margin: 0; color: #78939b; font-size: 12px; }
    .bw-journeys { background: #f7f7f5; }
    .bw-section-heading { display: flex; justify-content: space-between; gap: 40px; align-items: flex-end; margin-bottom: 50px; }
    .bw-journey-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .bw-journey-card, .bw-story { position: relative; overflow: hidden; display: block; background: #062f3d; text-decoration: none; color: white; }
    .bw-journey-card { aspect-ratio: .78; }
    .bw-journey-card img, .bw-story img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s cubic-bezier(.2,.7,.2,1); }
    .bw-journey-card:hover img, .bw-story:hover img { transform: scale(1.045); }
    .bw-journey-shade, .bw-story-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,.76), rgba(0,0,0,.08) 62%); }
    .bw-journey-copy, .bw-story-copy { position: absolute; left: 24px; right: 24px; bottom: 22px; }
    .bw-journey-copy span, .bw-story-copy span { display: block; margin-bottom: 8px; color: rgba(255,255,255,.55); font-size: 9px; font-weight: 700; letter-spacing: .16em; }
    .bw-journey-copy h3, .bw-story-copy h3 { margin: 0; font-family: 'Playfair Display', serif; font-size: 2rem; line-height: 1; font-weight: 500; letter-spacing: -.03em; }
    .bw-journey-copy p, .bw-story-copy p { margin: 10px 0 0; color: rgba(255,255,255,.65); font-size: 11px; line-height: 1.55; max-width: 28ch; }
    .bw-journal { padding: 120px 0; background: #071d27; color: white; }
    .bw-journal-heading { margin-bottom: 45px; }
    .bw-journal-heading h2 { color: white; }
    .bw-journal-grid { display: grid; grid-template-columns: 1.25fr .75fr .75fr; gap: 18px; align-items: stretch; }
    .bw-story-1 { min-height: 520px; }
    .bw-story-2, .bw-story-3 { min-height: 420px; }
    .bw-story-copy h3 { max-width: 19ch; }
    .bw-knowledge { background: white; padding: 100px 0; }
    .bw-knowledge-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 100px; }
    .bw-knowledge-copy > p { max-width: 510px; margin: 0 0 28px; color: #6c8991; font-size: 15px; line-height: 1.75; }
    .bw-knowledge-links { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid rgba(6,47,61,.13); }
    .bw-knowledge-links a { display: flex; justify-content: space-between; gap: 20px; padding: 15px 0; color: #062f3d; text-decoration: none; font-size: 12px; font-weight: 700; border-bottom: 1px solid rgba(6,47,61,.13); }
    .bw-knowledge-links a:nth-child(odd) { padding-right: 25px; }
    .bw-knowledge-links a:nth-child(even) { padding-left: 25px; border-left: 1px solid rgba(6,47,61,.13); }
    .bw-cta { padding: 120px 0 135px; background: #062f3d; color: white; text-align: center; }
    .bw-cta-inner { max-width: 900px; }
    .bw-cta h2 { color: white; font-size: clamp(3.3rem, 6vw, 6rem); }
    .bw-cta p { max-width: 480px; margin: 24px auto 30px; color: rgba(255,255,255,.57); font-size: 14px; line-height: 1.7; }
    .bw-mobile-nav { display: none; }
    @media (max-width: 900px) {
      .bw-container, .bw-hero-content { width: min(100% - 40px, 680px); }
      .bw-hero-top { padding: 0 20px; }
      .bw-scroll { left: 20px; }
      .bw-hero-index { right: 20px; }
      .bw-intro-row, .bw-proof-grid, .bw-way-grid, .bw-knowledge-grid { grid-template-columns: 1fr; gap: 42px; }
      .bw-destination-grid, .bw-journey-grid { grid-template-columns: 1fr 1fr; }
      .bw-destination-item.item-2, .bw-destination-item.item-3 { padding-bottom: 0; }
      .bw-destination-item:nth-child(3) { display: none; }
      .bw-proof-grid { gap: 28px; }
      .bw-stat { border-left: 0; border-top: 1px solid rgba(255,255,255,.16); padding: 22px 0 0; }
      .bw-proof-note { max-width: 560px; }
      .bw-journal-grid { grid-template-columns: 1fr 1fr; }
      .bw-story-1 { grid-column: 1 / -1; min-height: 460px; }
    }
    @media (max-width: 767px) {
      body { padding-bottom: 5.4rem; }
      .bw-container, .bw-hero-content { width: calc(100% - 32px); }
      .bw-hero { min-height: 92svh; }
      .bw-hero-content { padding: 135px 0 52px; }
