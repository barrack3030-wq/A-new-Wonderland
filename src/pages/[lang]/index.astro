---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import DestinationCard from '../../components/DestinationCard.astro';
import BlogCard from '../../components/BlogCard.astro';
import { languages, useTranslations } from '../../utils/i18n';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as any);
const featuredSlugs = ['paisu-pok-lake', 'piala-waterfall', 'oyama-beach', 'pulau-dua-balantak'];
const allDestinations = await getCollection('destinations');
const featuredDestinations = featuredSlugs.map(slug => allDestinations.find(d => d.slug === `${lang}/${slug}`)).filter(Boolean);
const allBlogs = await getCollection('blog');
const latestBlogs = allBlogs.filter(b => b.id.startsWith(`${lang}/`)).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0,3);
---

<BaseLayout title="Banggai Wonderland | Discover Hidden Paradise of Banggai">
  <section class="relative min-h-[100svh] flex items-end overflow-hidden bg-ocean-900">
    <div id="hero-media" class="absolute inset-0 will-change-transform overflow-hidden">
      <div class="hero-giphy absolute inset-0 overflow-hidden">
        <iframe
          src="https://giphy.com/embed/86bAGxmMCGQU34Y"
          title="Ocean scene"
          class="hero-giphy-frame border-0"
          style="border:0;"
          allow="autoplay; fullscreen"
          allowFullScreen
        ></iframe>
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-black/15 pointer-events-none"></div>
      <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-[#f7f7f5] via-[#f7f7f5]/25 to-transparent opacity-90 pointer-events-none"></div>
    </div>
    <div class="relative z-10 w-full max-w-7xl mx-auto px-6 sm:px-10 lg:px-12 pb-16 md:pb-24 pt-40">
      <div class="max-w-4xl">
        <p class="text-white/80 text-xs md:text-sm font-semibold tracking-[0.28em] uppercase mb-6">{t('hero.welcome')}</p>
        <h1 class="font-serif text-white text-5xl sm:text-6xl md:text-8xl lg:text-[7.5rem] leading-[0.92] tracking-[-0.045em] font-medium mb-8">
          {t('hero.title.1')}<br/><span class="text-white/80">{t('hero.title.2')}</span>
        </h1>
        <p class="text-white/85 text-base md:text-xl leading-relaxed max-w-2xl mb-10">{t('hero.desc')}</p>
        <div class="flex flex-wrap gap-3">
          <a href={`/${lang}/destinations/`} class="inline-flex items-center justify-center rounded-full bg-white text-ocean-900 px-7 py-3.5 text-sm font-semibold hover:bg-white/90 transition-all hover:-translate-y-0.5">{t('btn.explore')} <span class="ml-2">→</span></a>
          <a href={`/${lang}/packages/`} class="inline-flex items-center justify-center rounded-full bg-white/10 backdrop-blur-xl border border-white/25 text-white px-7 py-3.5 text-sm font-semibold hover:bg-white/20 transition-all">{t('btn.view_packages')}</a>
        </div>
      </div>
    </div>
    <div class="absolute bottom-7 right-8 md:right-12 z-10 text-white/60 text-[10px] tracking-[0.25em] uppercase hidden md:block">Banggai · Indonesia</div>
  </section>

  <section class="bg-[#f7f7f5] py-20 md:py-36">
    <div class="max-w-7xl mx-auto">
      <div class="px-6 sm:px-10 lg:px-12 max-w-3xl mb-12 md:mb-20">
        <p class="text-ocean-600 text-xs font-bold tracking-[0.24em] uppercase mb-5">Explore Banggai</p>
        <h2 class="font-serif text-ocean-900 text-4xl md:text-6xl leading-tight tracking-[-0.035em] font-medium mb-6">Places worth<br class="hidden md:block"/> travelling for.</h2>
        <p class="text-ocean-600 text-base md:text-lg leading-relaxed max-w-2xl">{t('home.featured.destinations.desc') || 'Discover quiet islands, clear lagoons, hidden waterfalls and untouched coastlines across the Banggai archipelago.'}</p>
      </div>

      {featuredDestinations.length > 0 && (
        <>
          <div class="desktop-destinations-grid px-6 sm:px-10 lg:px-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
            {featuredDestinations.map(destination => <DestinationCard destination={destination} />)}
          </div>

          <div class="mobile-destination-swiper" data-destination-swiper>
            <div class="mobile-destination-stage" data-swipe-stage>
              {featuredDestinations.map((destination, index) => (
                <div class="mobile-destination-slide" data-slide={index}>
                  <DestinationCard destination={destination} />
                </div>
              ))}
            </div>
            <div class="mobile-destination-controls">
              <button type="button" class="mobile-destination-arrow" data-prev aria-label="Previous destination">‹</button>
              <div class="mobile-destination-dots" aria-label="Destination position">
                {featuredDestinations.map((_, index) => (
                  <button type="button" class="mobile-destination-dot" data-dot={index} aria-label={`Destination ${index + 1}`} aria-current={index === 0 ? 'true' : 'false'}></button>
                ))}
              </div>
              <button type="button" class="mobile-destination-arrow" data-next aria-label="Next destination">›</button>
            </div>
          </div>
        </>
      )}

      <div class="px-6 sm:px-10 lg:px-12 mt-8 md:mt-12">
        <a href={`/${lang}/destinations/`} class="text-ocean-900 text-sm font-semibold border-b border-ocean-900/30 pb-1 hover:border-ocean-900 transition-colors">{t('btn.explore')} <span class="ml-1">→</span></a>
      </div>
    </div>
  </section>

  <section class="bg-white py-24 md:py-36">
    <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-12">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-8 mb-16">
        <div class="max-w-2xl"><p class="text-ocean-600 text-xs font-bold tracking-[0.24em] uppercase mb-5">The Journal</p><h2 class="font-serif text-ocean-900 text-4xl md:text-6xl tracking-[-0.035em] font-medium">Travel deeper.</h2></div>
        <a href={`/${lang}/blog/`} class="text-ocean-900 text-sm font-semibold border-b border-ocean-900/30 pb-1 self-start md:self-auto">{t('nav.blog')} <span class="ml-1">→</span></a>
      </div>
      {latestBlogs.length > 0 && <div class="grid grid-cols-1 md:grid-cols-3 gap-6">{latestBlogs.map(post => <BlogCard post={post} />)}</div>}
    </div>
  </section>

  <section class="bg-ocean-900 text-white py-24 md:py-32">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <p class="text-white/55 text-xs font-bold tracking-[0.25em] uppercase mb-6">Banggai Wonderland</p>
      <h2 class="font-serif text-4xl md:text-7xl leading-tight tracking-[-0.04em] font-medium mb-7">Your next escape<br/>starts here.</h2>
      <p class="text-white/65 max-w-xl mx-auto leading-relaxed mb-9">Private journeys through the hidden paradise of Banggai, designed around your time, interests and pace.</p>
      <a href="https://wa.me/6285820830530" target="_blank" rel="noopener noreferrer" class="inline-flex rounded-full bg-white text-ocean-900 px-8 py-4 text-sm font-semibold hover:bg-white/90 transition-all">{t('btn.book')} <span class="ml-2">→</span></a>
    </div>
  </section>

  <WhatsAppButton />

  <style>
    .hero-giphy-frame {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 177.777778vh;
      height: 100vw;
      min-width: 100%;
      min-height: 100%;
      transform: translate(-50%, -50%);
    }

    .mobile-destination-swiper {
      display: none;
    }

    @media (max-width: 767px) {
      .hero-giphy-frame {
        width: 177.777778svh;
        height: 100svw;
      }

      .desktop-destinations-grid {
        display: none;
      }

      .mobile-destination-swiper {
        display: block;
        width: 100%;
        padding: 0 1rem;
      }

      .mobile-destination-stage {
        position: relative;
        width: 100%;
        height: min(118vw, 560px);
        overflow: hidden;
        border-radius: 1.75rem;
        touch-action: pan-y;
        user-select: none;
        -webkit-user-select: none;
      }

      .mobile-destination-slide {
        position: absolute;
        inset: 0;
        width: 100%;
        opacity: 0;
        transform: translate3d(105%, 0, 0) scale(.985);
        transition: transform 360ms cubic-bezier(.22,.61,.36,1), opacity 260ms ease;
        pointer-events: none;
        will-change: transform, opacity;
      }

      .mobile-destination-slide.active {
        opacity: 1;
        transform: translate3d(0, 0, 0) scale(1);
        pointer-events: auto;
      }

      .mobile-destination-slide.prev {
        transform: translate3d(-105%, 0, 0) scale(.985);
      }

      .mobile-destination-slide.is-dragging {
        transition: none !important;
      }

      .mobile-destination-slide > a {
        height: 100%;
        display: block;
      }

      .mobile-destination-controls {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        margin-top: 1rem;
      }

      .mobile-destination-arrow {
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 999px;
        border: 1px solid rgba(6,43,61,.12);
        background: white;
        color: #062f3d;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
        line-height: 1;
        box-shadow: 0 8px 24px rgba(6,43,61,.08);
      }

      .mobile-destination-dots {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .45rem;
        flex: 1;
      }

      .mobile-destination-dot {
        width: .45rem;
        height: .45rem;
        padding: 0;
        border: 0;
        border-radius: 999px;
        background: rgba(6,43,61,.18);
        transition: all 220ms ease;
      }

      .mobile-destination-dot[aria-current="true"] {
        width: 1.5rem;
        background: #062f3d;
      }
    }
  </style>

  <script is:inline>
    const heroMedia = document.getElementById('hero-media');
    if (heroMedia) {
      let ticking = false;
      const updateHeroFade = () => {
        const progress = Math.min(window.scrollY / (window.innerHeight * 0.7), 1);
        heroMedia.style.opacity = String(1 - progress * 0.72);
        heroMedia.style.transform = `scale(${1 + progress * 0.025})`;
        ticking = false;
      };
      updateHeroFade();
      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(updateHeroFade);
          ticking = true;
        }
      }, { passive: true });
    }

    const destinationSwiper = document.querySelector('[data-destination-swiper]');
    if (destinationSwiper) {
      const slides = Array.from(destinationSwiper.querySelectorAll('[data-slide]'));
      const dots = Array.from(destinationSwiper.querySelectorAll('[data-dot]'));
      const prevButton = destinationSwiper.querySelector('[data-prev]');
      const nextButton = destinationSwiper.querySelector('[data-next]');
      const stage = destinationSwiper.querySelector('[data-swipe-stage]');

      let current = 0;
      let startX = 0;
      let startY = 0;
      let deltaX = 0;
      let dragging = false;
      let horizontalDrag = false;
      let moved = false;
      let pointerId = null;

      const clampIndex = (index) => (index + slides.length) % slides.length;

      const setIndicator = () => {
        dots.forEach((dot, i) => {
          dot.setAttribute('aria-current', i === current ? 'true' : 'false');
        });
      };

      const positionSlides = () => {
        if (!slides.length) return;
        slides.forEach((slide, i) => {
          slide.classList.remove('active', 'prev', 'is-dragging');
          slide.style.removeProperty('transform');
          slide.style.removeProperty('opacity');

          if (i === current) {
            slide.classList.add('active');
          } else if (i === clampIndex(current - 1)) {
            slide.classList.add('prev');
          } else {
            slide.style.transform = 'translate3d(105%,0,0) scale(.985)';
          }
        });
        setIndicator();
      };

      const goTo = (index) => {
        if (!slides.length) return;
        current = clampIndex(index);
        positionSlides();
      };

      const finishGesture = () => {
        if (!dragging) return;
        dragging = false;
        pointerId = null;

        const width = stage?.clientWidth || 320;
        const shouldChange = Math.abs(deltaX) > Math.max(55, width * 0.18);
        const direction = deltaX < 0 ? 1 : -1;
        const activeSlide = slides[current];

        if (activeSlide) {
          activeSlide.classList.remove('is-dragging');
          activeSlide.style.removeProperty('transform');
          activeSlide.style.removeProperty('opacity');
        }

        if (horizontalDrag && shouldChange) {
          goTo(current + direction);
        } else {
          positionSlides();
        }

        deltaX = 0;
        horizontalDrag = false;
      };

      positionSlides();

      prevButton?.addEventListener('click', () => goTo(current - 1));
      nextButton?.addEventListener('click', () => goTo(current + 1));
      dots.forEach((dot, index) => dot.addEventListener('click', () => goTo(index)));

      stage?.addEventListener('pointerdown', (event) => {
        if (event.pointerType === 'mouse' && event.button !== 0) return;
        dragging = true;
        horizontalDrag = false;
        moved = false;
        pointerId = event.pointerId;
        startX = event.clientX;
        startY = event.clientY;
        deltaX = 0;

        try { stage.setPointerCapture(event.pointerId); } catch {}

        const activeSlide = slides[current];
        activeSlide?.classList.add('is-dragging');
      });

      stage?.addEventListener('pointermove', (event) => {
        if (!dragging) return;

        const dx = event.clientX - startX;
        const dy = event.clientY - startY;

        if (!horizontalDrag && Math.abs(dx) < 8 && Math.abs(dy) < 8) return;

        if (!horizontalDrag) {
          if (Math.abs(dy) > Math.abs(dx)) {
            finishGesture();
            return;
          }
          horizontalDrag = true;
        }

        moved = true;
        deltaX = dx;
        event.preventDefault();

        const activeSlide = slides[current];
        if (!activeSlide) return;

        const width = stage.clientWidth || 320;
        const percent = Math.max(-100, Math.min(100, (dx / width) * 100));
        const scale = 1 - Math.min(Math.abs(percent), 30) / 1000;
        const opacity = 1 - Math.min(Math.abs(percent), 100) / 900;
        activeSlide.style.transform = `translate3d(${percent}%,0,0) scale(${scale})`;
        activeSlide.style.opacity = String(opacity);
      }, { passive: false });

      stage?.addEventListener('pointerup', finishGesture);
      stage?.addEventListener('pointercancel', finishGesture);
      stage?.addEventListener('lostpointercapture', finishGesture);

      stage?.addEventListener('click', (event) => {
        if (moved) {
          event.preventDefault();
          event.stopPropagation();
          moved = false;
        }
      }, true);
    }
  </script>
</BaseLayout>
