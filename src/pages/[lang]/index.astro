---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import DestinationCard from '../../components/DestinationCard.astro';
import BlogCard from '../../components/BlogCard.astro';
import { languages, useTranslations } from '../../utils/i18n';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as any);
const featuredSlugs = ['paisu-pok-lake', 'piala-waterfall', 'oyama-beach', 'pulau-dua-balantak'];
const allDestinations = await getCollection('destinations');
const featuredDestinations = featuredSlugs.map(slug => allDestinations.find(d => d.slug === `${lang}/${slug}`)).filter(Boolean);
const allBlogs = await getCollection('blog');
const latestBlogs = allBlogs.filter(b => b.id.startsWith(`${lang}/`)).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0,3);

const homeSeo = {
  en: {
    title: 'Banggai Islands Travel & Private Trips | Indonesia',
    description: 'Discover the Banggai Islands in Central Sulawesi with private trips to Paisu Pok, Piala Waterfall, Pulo Dua, Kamumu and other destinations around Luwuk and Banggai.'
  },
  id: {
    title: 'Wisata Kepulauan Banggai & Private Trip | Banggai Wonderland',
    description: 'Jelajahi Kepulauan Banggai, Sulawesi Tengah melalui private trip ke Paisu Pok, Air Terjun Piala, Pulo Dua, Kamumu dan destinasi menarik di sekitar Luwuk dan Banggai.'
  },
  es: {
    title: 'Viajes privados por las Islas Banggai | Indonesia',
    description: 'Descubre las Islas Banggai en Sulawesi Central con viajes privados a Paisu Pok, la cascada Piala, Pulo Dua, Kamumu y otros destinos de Luwuk y Banggai.'
  },
  fr: {
    title: 'Voyage privé aux îles Banggai | Indonésie',
    description: 'Découvrez les îles Banggai, dans le centre de Sulawesi, avec des voyages privés vers Paisu Pok, la cascade de Piala, Pulo Dua, Kamumu et les environs de Luwuk et Banggai.'
  },
  zh: {
    title: '邦盖群岛旅行与私人旅行 | Banggai Wonderland',
    description: '探索印度尼西亚中苏拉威西的邦盖群岛，前往 Paisu Pok、Piala 瀑布、Pulo Dua、Kamumu 以及 Luwuk 和 Banggai 周边目的地。'
  }
} as const;

const seo = homeSeo[lang as keyof typeof homeSeo] || homeSeo.en;
---

<BaseLayout title={seo.title} description={seo.description} seoTitle={seo.title} seoDescription={seo.description}>
  <section id="home" class="relative min-h-[100svh] flex items-end overflow-hidden bg-ocean-900">
    <div id="hero-media" class="absolute inset-0 will-change-transform overflow-hidden">
      <div class="hero-giphy absolute inset-0 overflow-hidden">
        <iframe
          src="https://giphy.com/embed/86bAGxmMCGQU34Y"
          title="Banggai Islands ocean scene"
          class="hero-giphy-frame border-0"
          style="border:0;"
          allow="autoplay; fullscreen"
          allowFullScreen
        ></iframe>
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-black/15 pointer-events-none"></div>
      <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-[#f7f7f5] via-[#f7f7f5]/25 to-transparent opacity-90 pointer-events-none"></div>
    </div>
    <div class="relative z-10 w-full max-w-7xl mx-auto px-6 sm:px-10 lg:px-12 pb-16 md:pb-24 pt-40">
      <div class="max-w-4xl hero-copy">
        <p class="text-white/80 text-xs md:text-sm font-semibold tracking-[0.28em] uppercase mb-6">{t('hero.welcome')}</p>
        <h1 class="font-serif text-white text-5xl sm:text-6xl md:text-8xl lg:text-[7.5rem] leading-[0.92] tracking-[-0.045em] font-medium mb-8">
          {t('hero.title.1')}<br/><span class="text-white/80">{t('hero.title.2')}</span>
        </h1>
        <p class="text-white/85 text-base md:text-xl leading-relaxed max-w-2xl mb-10">{t('hero.desc')}</p>
        <div class="flex flex-wrap gap-3">
          <a href={`/${lang}/destinations/`} class="inline-flex items-center justify-center rounded-full bg-white text-ocean-900 px-7 py-3.5 text-sm font-semibold hover:bg-white/90 transition-all hover:-translate-y-0.5">{t('btn.explore')} <span class="ml-2">→</span></a>
          <a href={`/${lang}/packages/`} class="hero-secondary-cta inline-flex items-center justify-center rounded-full bg-white/10 backdrop-blur-xl border border-white/25 text-white px-7 py-3.5 text-sm font-semibold hover:bg-white/20 transition-all">{t('btn.view_packages')}</a>
        </div>
        <p class="mobile-hero-scroll">Scroll to explore <span>↓</span></p>
      </div>
    </div>
    <div class="absolute bottom-7 right-8 md:right-12 z-10 text-white/60 text-[10px] tracking-[0.25em] uppercase hidden md:block">Banggai · Indonesia</div>
  </section>

  <section id="destinations" class="bg-[#f7f7f5] py-20 md:py-28">
    <div class="max-w-7xl mx-auto">
      <div class="px-6 sm:px-10 lg:px-12 max-w-3xl mb-12 md:mb-14">
        <p class="text-ocean-600 text-xs font-bold tracking-[0.24em] uppercase mb-5">Explore Banggai Islands</p>
        <h2 class="font-serif text-ocean-900 text-4xl md:text-6xl leading-tight tracking-[-0.035em] font-medium mb-6">Places worth<br class="hidden md:block"/> travelling for.</h2>
        <p class="text-ocean-600 text-base md:text-lg leading-relaxed max-w-2xl">{t('home.featured.destinations.desc') || 'Explore the Banggai Islands through quiet beaches, clear lagoons, waterfalls and coastal landscapes around Luwuk, Peleng and the surrounding islands.'}</p>
      </div>

      {featuredDestinations.length > 0 && (
        <>
          <div class="desktop-destinations-grid px-6 sm:px-10 lg:px-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
            {featuredDestinations.map(destination => <DestinationCard destination={destination} />)}
          </div>

          <div class="mobile-destination-swiper" data-destination-swiper>
            <div class="mobile-destination-stage" data-swipe-stage>
              {featuredDestinations.map((destination, index) => (
                <div class="mobile-destination-slide" data-slide={index}>
                  <DestinationCard destination={destination} />
                </div>
              ))}
            </div>
            <div class="mobile-destination-controls">
              <button type="button" class="mobile-destination-arrow" data-prev aria-label="Previous destination">‹</button>
              <div class="mobile-destination-dots" aria-label="Destination position">
                {featuredDestinations.map((_, index) => (
                  <button type="button" class="mobile-destination-dot" data-dot={index} aria-label={`Destination ${index + 1}`} aria-current={index === 0 ? 'true' : 'false'}></button>
                ))}
              </div>
              <button type="button" class="mobile-destination-arrow" data-next aria-label="Next destination">›</button>
            </div>
          </div>
        </>
      )}

      <div class="px-6 sm:px-10 lg:px-12 mt-8 md:mt-8">
        <a href={`/${lang}/destinations/`} class="text-ocean-900 text-sm font-semibold border-b border-ocean-900/30 pb-1 hover:border-ocean-900 transition-colors">Explore all Banggai destinations <span class="ml-1">→</span></a>
      </div>
    </div>
  </section>

  <section class="mobile-home-section mobile-why">
    <div class="mobile-shell">
      <p class="mobile-eyebrow">Why visit Banggai?</p>
      <h2>Not Bali.<br/>Not Raja Ampat.<br/><span>Something quieter.</span></h2>
      <p class="mobile-muted">The Banggai Islands offer a different kind of Indonesia travel experience: quiet islands, clear lagoons, coastal roads and hidden places to explore at a slower pace.</p>
      <div class="mobile-benefits">
        <div><strong>Hidden</strong><span>Quiet islands and destinations beyond the usual route.</span></div>
        <div><strong>Clear</strong><span>Lagoons, beaches and coastal waters made for slow exploration.</span></div>
        <div><strong>Private</strong><span>Flexible journeys shaped around your time and interests.</span></div>
      </div>
    </div>
  </section>

  <section class="desktop-home-seo bg-white py-20 md:py-24">
    <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-12">
      <div class="max-w-3xl">
        <p class="text-ocean-600 text-xs font-bold tracking-[0.24em] uppercase mb-5">Discover the region</p>
        <h2 class="font-serif text-ocean-900 text-4xl md:text-6xl leading-tight tracking-[-0.035em] font-medium mb-6">Travel beyond the famous places.</h2>
        <p class="text-ocean-600 text-base md:text-lg leading-relaxed mb-5">Banggai Wonderland helps travellers discover the Banggai Islands from Luwuk and beyond, with practical routes to islands, lagoons, waterfalls and coastal destinations. Start with our <a href={`/${lang}/destinations/paisu-pok-lake/`} class="text-ocean-900 font-semibold underline underline-offset-4">Paisu Pok travel guide</a>, explore <a href={`/${lang}/destinations/piala-waterfall/`} class="text-ocean-900 font-semibold underline underline-offset-4">Piala Waterfall</a>, or see what is possible through our <a href={`/${lang}/packages/`} class="text-ocean-900 font-semibold underline underline-offset-4">private trip packages</a>.</p>
        <p class="text-ocean-600 text-base md:text-lg leading-relaxed">If you are planning your first visit, our <a href={`/${lang}/blog/`} class="text-ocean-900 font-semibold underline underline-offset-4">Banggai travel stories and guides</a> can help you understand destinations, routes and practical travel considerations before you arrive.</p>
        <p class="text-ocean-600 text-base md:text-lg leading-relaxed mt-5">For travellers looking for a <a href={`/${lang}/jasa-tour-luwuk-banggai/`} class="text-ocean-900 font-semibold underline underline-offset-4">Luwuk Banggai tour service</a>, explore our private-trip planning page to see available routes and how a custom journey can be arranged from Luwuk.</p>
      </div>
    </div>
  </section>

  <section id="mobile-journeys" class="mobile-home-section mobile-journeys">
    <div class="mobile-shell">
      <div class="mobile-section-head">
        <div>
          <p class="mobile-eyebrow">Choose your escape</p>
          <h2>Journeys made for Banggai.</h2>
        </div>
        <a href={`/${lang}/packages/`}>View all →</a>
      </div>

      <div class="mobile-journey-track">
        <a href={`/${lang}/packages/luwuk-stopover/`} class="mobile-journey-card">
          <img src="/images/packages/luwuk-stopover.webp" alt="Luwuk Stopover private trip in Banggai" loading="lazy" />
          <div class="mobile-journey-overlay"></div>
          <div class="mobile-journey-copy">
            <span>1 day</span>
            <h3>Luwuk Stopover</h3>
            <p>A short introduction to Banggai from Luwuk.</p>
          </div>
        </a>
        <a href={`/${lang}/packages/luwuk-salakan/`} class="mobile-journey-card">
          <img src="/images/packages/luwuk-salakan.webp" alt="Luwuk and Salakan private trip" loading="lazy" />
          <div class="mobile-journey-overlay"></div>
          <div class="mobile-journey-copy">
            <span>3D2N</span>
            <h3>Luwuk &amp; Salakan Escape</h3>
            <p>Island landscapes, lagoons and coastal roads.</p>
          </div>
        </a>
        <a href={`/${lang}/packages/ultimate-banggai/`} class="mobile-journey-card">
          <img src="/images/packages/ultimate-banggai.webp" alt="Ultimate Banggai private island journey" loading="lazy" />
          <div class="mobile-journey-overlay"></div>
          <div class="mobile-journey-copy">
            <span>Ultimate journey</span>
            <h3>Ultimate Banggai</h3>
            <p>A longer route through the hidden islands of Banggai.</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="desktop-journal bg-white py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-12">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-8 mb-12">
        <div class="max-w-2xl"><p class="text-ocean-600 text-xs font-bold tracking-[0.24em] uppercase mb-5">The Journal</p><h2 class="font-serif text-ocean-900 text-4xl md:text-6xl tracking-[-0.035em] font-medium">Travel deeper.</h2></div>
        <a href={`/${lang}/blog/`} class="text-ocean-900 text-sm font-semibold border-b border-ocean-900/30 pb-1 self-start md:self-auto">{t('nav.blog')} <span class="ml-1">→</span></a>
      </div>
      {latestBlogs.length > 0 && <div class="grid grid-cols-1 md:grid-cols-3 gap-6">{latestBlogs.map(post => <BlogCard post={post} />)}</div>}
    </div>
  </section>

  {latestBlogs.length > 0 && (
    <section id="mobile-journal" class="mobile-home-section mobile-journal">
      <div class="mobile-shell">
        <div class="mobile-section-head">
          <div>
            <p class="mobile-eyebrow">The Journal</p>
            <h2>Travel deeper.</h2>
          </div>
          <a href={`/${lang}/blog/`}>All stories →</a>
        </div>
        <a href={`/${lang}/blog/${latestBlogs[0].slug.split('/').slice(1).join('/')}/`} class="mobile-featured-story">
          <img src={latestBlogs[0].data.image} alt={latestBlogs[0].data.title} loading="lazy" />
          <div class="mobile-story-overlay"></div>
          <div class="mobile-story-copy">
            <span>{latestBlogs[0].data.pubDate.toLocaleDateString(lang, { year: 'numeric', month: 'short', day: 'numeric' })}</span>
            <h3>{latestBlogs[0].data.title}</h3>
            <p>Read the story →</p>
          </div>
        </a>
      </div>
    </section>
  )}

  <section class="desktop-cta bg-ocean-900 text-white py-20 md:py-24">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <p class="text-white/55 text-xs font-bold tracking-[0.25em] uppercase mb-6">Banggai Wonderland</p>
      <h2 class="font-serif text-4xl md:text-7xl leading-tight tracking-[-0.04em] font-medium mb-7">Your next escape<br/>starts here.</h2>
      <p class="text-white/65 max-w-xl mx-auto leading-relaxed mb-9">Planning a trip to the Banggai Islands? Tell us your dates, interests and preferred pace, and we can discuss a private journey.</p>
      <a href="https://wa.me/6285820830530" target="_blank" rel="noopener noreferrer" class="inline-flex rounded-full bg-white text-ocean-900 px-8 py-4 text-sm font-semibold hover:bg-white/90 transition-all">{t('btn.book')} <span class="ml-2">→</span></a>
    </div>
  </section>

  <section id="mobile-book" class="mobile-home-section mobile-book">
    <div class="mobile-book-inner">
      <p class="mobile-eyebrow">Banggai Wonderland</p>
      <h2>Your Banggai story starts here.</h2>
      <p>Planning a trip to the Banggai Islands? Share your dates, interests and pace with us and discuss a private journey.</p>
      <a href="https://wa.me/6285820830530" target="_blank" rel="noopener noreferrer">Plan my trip <span>→</span></a>
    </div>
  </section>

  <nav class="mobile-bottom-nav" aria-label="Mobile navigation">
    <a href="#home"><span>⌂</span><small>Home</small></a>
    <a href="#destinations"><span>◉</span><small>Places</small></a>
    <a href="#mobile-journeys"><span>↗</span><small>Journeys</small></a>
    <a href="#mobile-journal"><span>▤</span><small>Journal</small></a>
    <a href="#mobile-book"><span>→</span><small>Book</small></a>
  </nav>

  <WhatsAppButton />

  <style>
    .hero-giphy-frame {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 177.777778vh;
      height: 100vw;
      min-width: 100%;
      min-height: 100%;
      transform: translate(-50%, -50%);
    }

    .mobile-home-section,
    .mobile-bottom-nav,
    .mobile-hero-scroll {
      display: none;
    }

    @media (max-width: 767px) {
      html { scroll-behavior: smooth; }
      body { padding-bottom: 5.25rem; }
      .hero-giphy-frame { width: 177.777778svh; height: 100svw; }
      .hero-copy { padding-bottom: 1.5rem; }
      .hero-copy h1 { font-size: clamp(3rem, 14vw, 4.7rem); line-height: .9; max-width: 9ch; margin-bottom: 1.25rem; }
      .hero-copy > p:not(.mobile-hero-scroll) { font-size: .96rem; line-height: 1.6; max-width: 32rem; margin-bottom: 1.5rem; }
      .hero-secondary-cta { display: none !important; }
      .mobile-hero-scroll { display: flex; align-items: center; gap: .5rem; margin-top: 1.35rem; color: rgba(255,255,255,.65); font-size: .68rem; letter-spacing: .18em; text-transform: uppercase; }
      .desktop-destinations-grid, .desktop-journal, .desktop-cta, .desktop-home-seo { display: none !important; }
      #destinations { padding-top: 4.75rem; padding-bottom: 4rem; overflow: hidden; }
      #destinations > .max-w-7xl > .px-6.sm\\:px-10.lg\\:px-12.max-w-3xl { margin-bottom: 1.4rem; }
      #destinations h2 { font-size: 2.7rem; line-height: .98; margin-bottom: 1rem; }
      #destinations > .max-w-7xl > .px-6.sm\\:px-10.lg\\:px-12.max-w-3xl > p:last-child { font-size: .94rem; line-height: 1.55; }
      .mobile-destination-swiper { display: block; width: 100%; padding: 0 1rem; }
      .mobile-destination-stage { position: relative; width: 100%; height: min(122vw, 580px); overflow: hidden; border-radius: 1.75rem; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
      .mobile-destination-slide { position: absolute; inset: 0; width: 100%; opacity: 0; transform: translate3d(105%,0,0) scale(.985); transition: transform 360ms cubic-bezier(.22,.61,.36,1), opacity 260ms ease; pointer-events: none; will-change: transform, opacity; }
      .mobile-destination-slide.active { opacity: 1; transform: translate3d(0,0,0) scale(1); pointer-events: auto; }
      .mobile-destination-slide.prev { transform: translate3d(-105%,0,0) scale(.985); }
      .mobile-destination-slide.is-dragging { transition: none !important; }
      .mobile-destination-slide > a { height: 100%; display: block; }
      .mobile-destination-controls { display: flex; align-items: center; justify-content: space-between; gap: .7rem; margin: .9rem 0 0; }
      .mobile-destination-arrow { width: 2.5rem; height: 2.5rem; border-radius: 999px; border: 1px solid rgba(6,43,61,.1); background: white; color: #062f3d; display: inline-flex; align-items: center; justify-content: center; font-size: 1.5rem; line-height: 1; box-shadow: 0 8px 24px rgba(6,43,61,.06); }
      .mobile-destination-dots { display: flex; align-items: center; justify-content: center; gap: .4rem; flex: 1; }
      .mobile-destination-dot { width: .42rem; height: .42rem; padding: 0; border: 0; border-radius: 999px; background: rgba(6,43,61,.18); transition: all 220ms ease; }
      .mobile-destination-dot[aria-current="true"] { width: 1.4rem; background: #062f3d; }
      .mobile-home-section { display: block; }
      .mobile-shell { width: 100%; max-width: 32rem; margin: 0 auto; padding: 0 1.25rem; }
      .mobile-eyebrow { margin: 0 0 .7rem; color: #3d7383; font-size: .66rem; line-height: 1; font-weight: 800; letter-spacing: .22em; text-transform: uppercase; }
      .mobile-section-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; margin-bottom: 1.2rem; }
      .mobile-section-head h2 { margin: 0; color: #062f3d; font-family: Georgia, 'Times New Roman', serif; font-size: 2.35rem; line-height: .98; letter-spacing: -.035em; font-weight: 500; }
      .mobile-section-head > a { color: #062f3d; font-size: .72rem; font-weight: 700; white-space: nowrap; padding-bottom: .2rem; border-bottom: 1px solid rgba(6,47,61,.18); }
      .mobile-why { background: #062f3d; color: white; padding: 5rem 0 4.8rem; }
      .mobile-why .mobile-eyebrow { color: rgba(255,255,255,.5); }
      .mobile-why h2 { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: 2.65rem; line-height: .98; letter-spacing: -.04em; font-weight: 500; }
      .mobile-why h2 span { color: rgba(255,255,255,.55); }
      .mobile-muted { max-width: 28rem; margin: 1.2rem 0 0; color: rgba(255,255,255,.66); font-size: .95rem; line-height: 1.65; }
      .mobile-benefits { display: grid; gap: .9rem; margin-top: 2rem; }
      .mobile-benefits > div { display: grid; grid-template-columns: 5.25rem 1fr; gap: .9rem; align-items: start; padding-top: .9rem; border-top: 1px solid rgba(255,255,255,.12); }
      .mobile-benefits strong { font-size: .9rem; letter-spacing: .03em; }
      .mobile-benefits span { color: rgba(255,255,255,.62); font-size: .82rem; line-height: 1.5; }
      .mobile-journeys { background: #f7f7f5; padding: 4.5rem 0 4rem; overflow: hidden; }
      .mobile-journey-track { display: flex; gap: .9rem; overflow-x: auto; scroll-snap-type: x mandatory; padding-right: 2rem; scrollbar-width: none; -ms-overflow-style: none; }
      .mobile-journey-track::-webkit-scrollbar { display: none; }
      .mobile-journey-card { position: relative; flex: 0 0 86%; min-height: 23rem; overflow: hidden; border-radius: 1.7rem; background: #062f3d; scroll-snap-align: start; }
      .mobile-journey-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
      .mobile-journey-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,.78), rgba(0,0,0,.08) 65%, transparent); }
      .mobile-journey-copy { position: absolute; left: 1.25rem; right: 1.25rem; bottom: 1.25rem; color: white; }
      .mobile-journey-copy span { display: block; color: rgba(255,255,255,.66); font-size: .68rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
      .mobile-journey-copy h3 { margin: .45rem 0 .35rem; font-family: Georgia, 'Times New Roman', serif; font-size: 2rem; line-height: .98; font-weight: 500; letter-spacing: -.03em; }
      .mobile-journey-copy p { margin: 0; max-width: 19rem; color: rgba(255,255,255,.7); font-size: .82rem; line-height: 1.5; }
      .mobile-journal { background: white; padding: 4.5rem 0 4rem; }
      .mobile-featured-story { position: relative; display: block; min-height: 28rem; overflow: hidden; border-radius: 1.7rem; background: #062f3d; }
      .mobile-featured-story img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
      .mobile-story-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,.82), rgba(0,0,0,.08) 70%, transparent); }
      .mobile-story-copy { position: absolute; left: 1.25rem; right: 1.25rem; bottom: 1.25rem; color: white; }
      .mobile-story-copy span { display: block; color: rgba(255,255,255,.63); font-size: .68rem; letter-spacing: .13em; text-transform: uppercase; }
      .mobile-story-copy h3 { margin: .55rem 0 .55rem; font-family: Georgia, 'Times New Roman', serif; font-size: 2rem; line-height: 1.04; font-weight: 500; letter-spacing: -.03em; }
      .mobile-story-copy p { margin: 0; color: rgba(255,255,255,.7); font-size: .82rem; }
      .mobile-book { background: #062f3d; color: white; padding: 4.8rem 1.25rem 7rem; }
      .mobile-book-inner { max-width: 30rem; margin: 0 auto; }
