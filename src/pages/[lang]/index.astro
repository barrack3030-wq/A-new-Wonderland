  </style>

  <script is:inline>
    const heroMedia = document.getElementById('hero-media');
    if (heroMedia) {
      let ticking = false;
      const updateHero = () => {
        const progress = Math.min(window.scrollY / (window.innerHeight * 0.72), 1);
        heroMedia.style.opacity = String(1 - progress * 0.7);
        heroMedia.style.transform = `scale(${1 + progress * 0.035})`;
        ticking = false;
      };
      updateHero();
      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(updateHero);
          ticking = true;
        }
      }, { passive: true });
    }
  </script>
