---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { useTranslations } from '../../../utils/i18n';
import { getAccessInfo } from '../../../utils/accessData';

export async function getStaticPaths() {
  const destinations = await getCollection('destinations');
  return destinations.map(entry => {
    const [lang, ...slugParts] = entry.slug.split('/');
    return { params: { lang, slug: slugParts.join('/') }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { lang } = Astro.params;
const t = useTranslations(lang as any);
const { Content } = await entry.render();
const allDestinations = await getCollection('destinations');
const allPackages = await getCollection('packages');
const allBlogs = await getCollection('blog');
const languageDestinations = allDestinations.filter(item => item.slug.startsWith(`${lang}/`) && item.slug !== entry.slug);
const slug = Astro.params.slug as string;

// Prefer explicitly curated relationships from frontmatter. Fall back to
// lightweight relevance matching only when a page has no curated links.
const normalizeRelatedSlug = (value: string) => {
  const clean = value.replace(/^\//, '').replace(/\/$/, '');
  return clean.startsWith(`${lang}/`) ? clean.slice(lang.length + 1) : clean;
};

const curatedRelatedSlugs = (entry.data.relatedDestinations || []).map(normalizeRelatedSlug);
const curatedRelated = curatedRelatedSlugs
  .map(targetSlug => languageDestinations.find(item => item.slug === `${lang}/${targetSlug}`))
  .filter((item): item is typeof languageDestinations[number] => Boolean(item))
  .slice(0, 4);

const slugWords = slug.replace(/-/g, ' ').toLowerCase().split(/\s+/).filter(Boolean);
const relevance = (text: string) => slugWords.reduce((score, word) => score + (text.toLowerCase().includes(word) ? 1 : 0), 0);

const relatedDestinations = curatedRelated.length > 0
  ? curatedRelated
  : languageDestinations
      .map(item => ({ item, score: relevance(`${item.data.title} ${item.data.description} ${item.data.category}`) }))
      .sort((a, b) => b.score - a.score)
      .slice(0, 4)
      .map(x => x.item);

const languagePackages = allPackages.filter(item => item.slug.startsWith(`${lang}/`));
const relatedPackages = languagePackages
  .map(item => ({ item, score: relevance(`${item.data.title} ${item.data.description} ${item.data.destination}`) }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map(x => x.item);

const languageBlogs = allBlogs.filter(item => item.slug.startsWith(`${lang}/`));
const relatedArticles = languageBlogs
  .map(item => ({ item, score: relevance(`${item.data.title} ${item.data.description} ${(item.data.tags || []).join(' ')}`) }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map(x => x.item);

const accessText = getAccessInfo(slug, lang as string);
const youtubeUrl = entry.data.youtube;
const youtubeId = youtubeUrl?.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([^&?/]+)/)?.[1] || null;

const breadcrumbItems = [
  { name: lang === 'id' ? 'Beranda' : 'Home', url: `/${lang}/` },
  { name: t('nav.destinations'), url: `/${lang}/destinations/` },
  { name: entry.data.title, url: `/${lang}/destinations/${slug}/` }
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: entry.data.title,
  description: entry.data.description,
  image: entry.data.image,
  url: new URL(`/${lang}/destinations/${slug}/`, Astro.site).href
};

const labels = ({
  id: { read:'Baca Artikel Lengkap', hide:'Tutup Artikel', related:'Destinasi Terkait', packages:'Paket Private Trip Terkait', articles:'Panduan Perjalanan Terkait', plan:'Rencanakan Perjalanan Ini', video:'Tonton Video', service:'Jasa Tour Luwuk Banggai' },
  en: { read:'Read Full Article', hide:'Hide Full Article', related:'Related Destinations', packages:'Related Private Trips', articles:'Related Travel Guides', plan:'Plan This Trip', video:'Watch Video', service:'Luwuk Banggai Tour Services' },
  es: { read:'Leer el artículo completo', hide:'Cerrar artículo', related:'Destinos relacionados', packages:'Viajes privados relacionados', articles:'Guías de viaje relacionadas', plan:'Planifica este viaje', video:'Ver vídeo', service:'Servicios de tour Luwuk Banggai' },
  fr: { read:'Lire l’article complet', hide:'Réduire l’article', related:'Destinations similaires', packages:'Circuits privés associés', articles:'Guides de voyage associés', plan:'Planifier ce voyage', video:'Voir la vidéo', service:'Services de tour à Luwuk Banggai' },