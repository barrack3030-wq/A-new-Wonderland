---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PackageCard from '../../../components/PackageCard.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { languages, useTranslations } from '../../../utils/i18n';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as any);
const allPackages = await getCollection('packages');
const packages = allPackages.filter(pkg => pkg.slug.startsWith(`${lang}/`));

const copy = ({
  en: {
    title: 'Banggai Tour Packages & Private Trips',
    description: 'Explore Banggai tour packages and private trips from Luwuk to Paisu Pok, Salakan, Peleng and other destinations in Central Sulawesi.',
    intro: 'Choose a Banggai tour or private trip based on your available time, interests and preferred pace. Our routes connect Luwuk with island destinations and natural attractions across the Banggai Islands.',
    guide: 'Compare the tour itineraries below, then explore the destination guides for practical information before planning your Banggai trip.'
  },
  id: {
    title: 'Paket Wisata Banggai | Private Trip Kepulauan Banggai',
    description: 'Jelajahi Kepulauan Banggai melalui paket private trip dari Luwuk dengan rute menuju Paisu Pok, Salakan, Peleng dan destinasi lain di Sulawesi Tengah.',
    intro: 'Pilih perjalanan private di Kepulauan Banggai sesuai waktu, minat, dan ritme perjalanan Anda. Rute yang tersedia menghubungkan Luwuk dengan berbagai destinasi pulau dan wisata alam.',
    guide: 'Bandingkan itinerary di bawah ini dan baca panduan destinasi untuk informasi praktis sebelum menyusun perjalanan.'
  },
  es: {
    title: 'Viajes Privados por las Islas Banggai',
    description: 'Descubre las Islas Banggai con viajes privados desde Luwuk hacia Paisu Pok, Salakan, Peleng y otros destinos de Sulawesi Central.',
    intro: 'Elige un viaje privado según tu tiempo disponible, intereses y ritmo preferido. Las rutas conectan Luwuk con islas y paisajes naturales de Banggai.',
    guide: 'Compara los itinerarios y consulta las guías de destinos para preparar tu viaje.'
  },
  fr: {
    title: 'Circuits privés dans les îles Banggai',
    description: 'Découvrez les îles Banggai avec des circuits privés depuis Luwuk vers Paisu Pok, Salakan, Peleng et d’autres destinations du centre de Sulawesi.',
    intro: 'Choisissez un voyage privé selon votre temps, vos centres d’intérêt et votre rythme. Les itinéraires relient Luwuk aux îles et paysages naturels de Banggai.',
    guide: 'Comparez les itinéraires puis consultez les guides des destinations pour préparer votre voyage.'
  },
  zh: {
    title: '邦盖群岛私人旅行线路',
    description: '从 Luwuk 出发探索邦盖群岛，前往 Paisu Pok、Salakan、Peleng 以及印度尼西亚中苏拉威西的其他目的地。',
    intro: '根据时间、兴趣和旅行节奏选择邦盖群岛私人旅行线路。现有路线连接 Luwuk 与多个岛屿和自然景观。',
    guide: '先比较以下行程，再查看目的地旅行指南，了解实用信息。'
  }
} as const)[lang as keyof typeof copy] || {
  title: 'Banggai Islands Private Trips',
  description: 'Explore private trips across the Banggai Islands from Luwuk.',
  intro: 'Choose a private trip based on your available time and interests.',
  guide: 'Compare itineraries and read destination guides before planning.'
};

const breadcrumbItems = [
  { name: 'Home', url: `/${lang}/` },
  { name: copy.title, url: `/${lang}/packages/` }
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: copy.title,
  description: copy.description,
  url: new URL(`/${lang}/packages/`, Astro.site).href,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: packages.length,
    itemListElement: packages.map((pkg, index) => {
      const [, ...parts] = pkg.slug.split('/');
      return {
        '@type': 'ListItem',
        position: index + 1,
        name: pkg.data.title,
        url: new URL(`/${lang}/packages/${parts.join('/')}/`, Astro.site).href
      };
    })
  }
};
---

<BaseLayout
  title={`${copy.title} | Banggai Wonderland`}
  description={copy.description}
  seoTitle={`${copy.title} | Banggai Wonderland`}
  seoDescription={copy.description}
  schema={schema}
>
  <div class="bg-sand-50 pt-32 pb-20 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumb items={breadcrumbItems} />
      <header class="mb-12 max-w-3xl">
        <p class="text-turquoise-600 text-xs font-bold tracking-[0.22em] uppercase mb-4">Banggai Islands · Indonesia</p>
        <h1 class="font-serif text-4xl md:text-6xl font-medium tracking-[-0.035em] text-ocean-900 mb-5">{copy.title}</h1>
        <p class="text-lg text-ocean-600 leading-relaxed mb-4">{copy.intro}</p>
        <p class="text-base text-ocean-600 leading-relaxed mb-5">{copy.guide}</p>
        <a href={`/${lang}/jasa-tour-luwuk-banggai/`} class="inline-flex items-center text-sm font-semibold text-ocean-900 underline underline-offset-4 hover:text-turquoise-600 transition-colors">{lang === 'id' ? 'Butuh itinerary custom dari Luwuk? Lihat jasa tour Luwuk Banggai' : lang === 'es' ? '¿Necesitas una ruta personalizada desde Luwuk? Ver servicios de tour' : lang === 'fr' ? 'Besoin d’un itinéraire personnalisé depuis Luwuk ? Voir nos services' : lang === 'zh' ? '需要从 Luwuk 定制路线？查看旅游服务' : 'Need a custom route from Luwuk? Explore our tour services'} →</a>
      </header>

      <section class="mb-12 rounded-3xl border border-sand-200 bg-white p-6 md:p-8">
        <div class="max-w-3xl">
          <p class="text-turquoise-600 text-xs font-bold tracking-[0.22em] uppercase mb-3">Trip duration</p>
          <h2 class="font-serif text-2xl md:text-3xl font-medium text-ocean-900 mb-3">{lang === 'id' ? 'Paket Wisata Banggai Berdasarkan Durasi' : lang === 'es' ? 'Elige tu viaje según la duración' : lang === 'fr' ? 'Choisissez votre circuit selon la durée' : lang === 'zh' ? '按旅行天数选择路线' : 'Choose a Trip by Duration'}</h2>
          <p class="text-sm leading-relaxed text-ocean-600 mb-5">{lang === 'id' ? 'Pilih paket wisata Banggai sesuai waktu perjalanan, mulai dari itinerary singkat di Luwuk hingga perjalanan beberapa hari melintasi Kepulauan Banggai.' : lang === 'es' ? 'Desde escapadas cortas en Luwuk hasta viajes de varios días por las islas Banggai.' : lang === 'fr' ? 'Des courtes escapades à Luwuk aux voyages de plusieurs jours dans les îles Banggai.' : lang === 'zh' ? '从 Luwuk 短途旅行到多日邦盖群岛路线，选择适合时间的行程。' : 'From short Luwuk trips to multi-day journeys across the Banggai Islands.'}</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
          <a href={lang === 'id' || lang === 'en' ? "/" + lang + "/packages/luwuk-one-day/" : "/" + lang + "/blog/2026-09-18-itinerary-luwuk-1-3-4-5-hari/"} class="rounded-2xl border border-sand-200 px-5 py-4 hover:border-turquoise-400 transition-colors"><span class="block text-xs font-bold uppercase tracking-[0.16em] text-turquoise-700">1 Day</span><span class="block text-sm font-semibold text-ocean-900 mt-1">{lang === 'id' ? 'Paket Wisata Luwuk 1 Hari' : 'Luwuk 1-Day Private Tour'}</span></a>
          <a href={"/" + lang + "/packages/luwuk-stopover/"} class="rounded-2xl border border-sand-200 px-5 py-4 hover:border-turquoise-400 transition-colors"><span class="block text-xs font-bold uppercase tracking-[0.16em] text-turquoise-700">2D1N</span><span class="block text-sm font-semibold text-ocean-900 mt-1">{lang === 'id' ? 'Paket Wisata Luwuk 2 Hari 1 Malam' : 'Luwuk 2 Days 1 Night'}</span></a>
          {lang !== 'fr' && lang !== 'zh' && <a href={"/" + lang + "/packages/luwuk-salakan/"} class="rounded-2xl border border-sand-200 px-5 py-4 hover:border-turquoise-400 transition-colors"><span class="block text-xs font-bold uppercase tracking-[0.16em] text-turquoise-700">3D2N</span><span class="block text-sm font-semibold text-ocean-900 mt-1">{lang === 'id' ? 'Private Trip Luwuk Salakan' : 'Luwuk Salakan Private Trip'}</span></a>}
          <a href={"/" + lang + "/packages/banggai-wonderland/"} class="rounded-2xl border border-sand-200 px-5 py-4 hover:border-turquoise-400 transition-colors"><span class="block text-xs font-bold uppercase tracking-[0.16em] text-turquoise-700">4D3N</span><span class="block text-sm font-semibold text-ocean-900 mt-1">{lang === 'id' ? 'Paket Wisata Banggai 4 Hari 3 Malam' : 'Banggai 4 Days 3 Nights'}</span></a>
          <a href={lang === 'id' || lang === 'en' ? "/" + lang + "/packages/banggai-5d4n/" : "/" + lang + "/blog/2026-09-18-itinerary-luwuk-1-3-4-5-hari/"} class="rounded-2xl border border-sand-200 px-5 py-4 hover:border-turquoise-400 transition-colors"><span class="block text-xs font-bold uppercase tracking-[0.16em] text-turquoise-700">5D4N</span><span class="block text-sm font-semibold text-ocean-900 mt-1">{lang === 'id' ? 'Paket Wisata Banggai 5 Hari 4 Malam' : 'Banggai 5-Day, 4-Night Tour'}</span></a>
          <a href={"/" + lang + "/packages/ultimate-banggai/"} class="rounded-2xl border border-sand-200 px-5 py-4 hover:border-turquoise-400 transition-colors"><span class="block text-xs font-bold uppercase tracking-[0.16em] text-turquoise-700">6D5N</span><span class="block text-sm font-semibold text-ocean-900 mt-1">{lang === 'id' ? 'Paket Wisata Banggai 6 Hari 5 Malam' : 'Banggai 6 Days 5 Nights'}</span></a>
        </div>
      </section>

      {packages.length > 0 ? (
        <>
          <div class="space-y-8">
            {packages.map(pkg => <PackageCard pkg={pkg} />)}
          </div>
          <div class="mt-14 pt-8 border-t border-sand-200">
            <div class="grid md:grid-cols-2 gap-8">
              <div>
                <h2 class="font-serif text-2xl font-bold text-ocean-900 mb-3">Explore the destinations</h2>
                <p class="text-sm leading-relaxed text-ocean-600">Learn more about Paisu Pok, Piala Waterfall, Pulo Dua, Kamumu, Luwuk and other Banggai destinations before choosing a route.</p>
              </div>
              <div class="flex md:justify-end items-center">
                <a href={`/${lang}/destinations/`} class="inline-flex items-center justify-center rounded-full bg-ocean-900 text-white px-6 py-3 text-sm font-semibold hover:bg-ocean-800 transition-colors">{t('btn.explore')} <span class="ml-2">→</span></a>
              </div>
            </div>
          </div>
        </>
      ) : (
        <div class="text-center py-20 bg-white rounded-2xl border border-sand-200"><p class="text-ocean-600">No packages found for this language yet.</p></div>
      )}
    </div>
  </div>
  <WhatsAppButton />
</BaseLayout>
