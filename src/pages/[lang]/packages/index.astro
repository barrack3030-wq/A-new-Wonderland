---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PackageCard from '../../../components/PackageCard.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { languages, useTranslations } from '../../../utils/i18n';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as any);
const allPackages = await getCollection('packages');
const packages = allPackages.filter(pkg => pkg.slug.startsWith(`${lang}/`));
const hasPackage = (slug: string) => allPackages.some(pkg => pkg.slug === `${lang}/${slug}`);

