---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { useTranslations } from '../../../utils/i18n';

export async function getStaticPaths() {
  const packages = await getCollection('packages');
  return packages.map(entry => {
    const [lang, ...slugParts] = entry.slug.split('/');
    const pkgSlug = slugParts.join('/');
    
    return {
      params: { lang, slug: pkgSlug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { lang } = Astro.params;
const t = useTranslations(lang as any);
const { Content } = await entry.render();

const breadcrumbItems = [
  { name: 'Home', url: `/${lang}/` },
  { name: t('nav.packages'), url: `/${lang}/packages/` },
  { name: entry.data.title, url: `/${lang}/packages/${Astro.params.slug}/` }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "TouristTrip",
  "name": entry.data.title,
  "description": entry.data.description,
  "image": entry.data.image,
  "itinerary": {
    "@type": "ItemList",
    "itemListElement": entry.data.itinerary?.map((item, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "TouristAttraction",
        "name": item.title,
        "description": item.description
      }
    }))
  }
};
---

<BaseLayout 
  title={`${entry.data.title} | Banggai Wonderland`}
  description={entry.data.description}
  seoTitle={entry.data.seoTitle}
  seoDescription={entry.data.seoDescription}
  ogImage={entry.data.image}
  imageAlt={entry.data.imageAlt}
  schema={schema}
>
  
  <section class="relative h-[60vh] min-h-[450px] flex items-end pb-16 pt-32">
    <div class="absolute inset-0 z-0">
      <img src={entry.data.image} alt={entry.data.imageAlt || entry.data.title} class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-ocean-700 via-ocean-800/40 to-transparent"></div>
    </div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <Breadcrumb items={breadcrumbItems} />
      
      <div class="mt-4 max-w-4xl">
        <div class="flex flex-wrap gap-3 mb-4">
          <span class="inline-flex items-center bg-turquoise-500 text-ocean-900 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide">
            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            {entry.data.duration}
          </span>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-bold text-white mb-6 leading-tight">
          {entry.data.title}
        </h1>
        <div class="flex items-center text-ocean-100 text-sm md:text-base bg-ocean-900/40 backdrop-blur-md self-start inline-flex px-4 py-2 rounded-full border border-ocean-700">
          <svg class="w-5 h-5 mr-2 text-turquoise-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          {entry.data.destination}
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row gap-12 lg:gap-16">
        
        <div class="lg:w-2/3 space-y-12">
          
          <!-- Content Overview -->
          <div class="prose prose-lg prose-ocean max-w-none 
            prose-headings:font-serif prose-headings:text-ocean-900 
            prose-p:text-ocean-700 prose-p:leading-relaxed">
            <Content />
          </div>

          <!-- Itinerary -->
          {entry.data.itinerary && entry.data.itinerary.length > 0 && (
            <div class="pt-8 border-t border-sand-200">
              <h2 class="font-serif text-3xl font-bold text-ocean-900 mb-8">{t('tour.itinerary')}</h2>
              <div class="space-y-6">
                {entry.data.itinerary.map((item, index) => (
                  <div class="flex">
                    <div class="flex flex-col items-center mr-6">
                      <div class="w-12 h-12 bg-ocean-50 rounded-full flex items-center justify-center border-2 border-turquoise-200 shadow-sm z-10">
                        <span class="font-bold text-ocean-900 text-sm">{index + 1}</span>
                      </div>
                      {index !== entry.data.itinerary.length - 1 && (
                        <div class="w-0.5 h-full bg-sand-200 mt-2"></div>
                      )}
                    </div>
                    <div class="pb-8 pt-2 flex-grow">
                      <span class="text-xs font-bold tracking-wider text-turquoise-600 uppercase block mb-1">{item.day}</span>
                      <h3 class="font-serif text-xl font-bold text-ocean-900 mb-3">{item.title}</h3>
                      <p class="text-ocean-600 leading-relaxed">{item.description}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

        </div>
        
        <div class="lg:w-1/3">
          <div class="sticky top-32 space-y-8">
            
            <div class="bg-sand-50 p-6 sm:p-8 rounded-3xl border border-sand-200 shadow-sm">
              <div class="mb-8">
                <h3 class="font-serif text-xl font-bold text-ocean-900 mb-4">{t('tour.included')}</h3>
                <ul class="space-y-3">
                  {entry.data.included?.map(item => (
                    <li class="flex items-start">
                      <svg class="w-5 h-5 text-turquoise-500 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                      <span class="text-ocean-700 text-sm">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mb-8">
                <h3 class="font-serif text-xl font-bold text-ocean-900 mb-4">{t('tour.excluded')}</h3>
                <ul class="space-y-3">
                  {entry.data.excluded?.map(item => (
                    <li class="flex items-start">
                      <svg class="w-5 h-5 text-red-400 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                      <span class="text-ocean-700 text-sm">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <a href={`/${lang}/book/?package=${encodeURIComponent(entry.data.title)}`} class="flex items-center justify-center w-full bg-ocean-900 text-white px-6 py-4 rounded-xl font-bold text-base hover:bg-ocean-800 transition-colors shadow-lg shadow-ocean-900/20">
                <svg class="w-6 h-6 mr-2" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                {t('btn.book')}
              </a>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

  <WhatsAppButton />
</BaseLayout>
