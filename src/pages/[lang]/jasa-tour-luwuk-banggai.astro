    routeTitle: 'Rutas y Destinos',
    routeText: 'Desde Luwuk, el viaje puede ser una escapada corta o una ruta de varias islas. El itinerario se adapta al tiempo, los intereses, los horarios marítimos y las condiciones locales.',
    processTitle: 'Cómo Funciona el Viaje Privado',
    process: [
      ['01', 'Comparte tu plan', 'Envía fechas, número de viajeros, duración y destinos preferidos.'],
      ['02', 'Diseñamos la ruta', 'Ayudamos a combinar destinos y ordenar el recorrido.'],
      ['03', 'Ajustamos los detalles', 'Comentamos transporte, alojamiento, actividades y necesidades antes de salir.'],
      ['04', 'Salida desde Luwuk', 'Con los detalles acordados, el viaje se adapta a las condiciones locales.']
    ],
    packageTitle: 'Paquetes de Viaje Privado',
    packageText: 'Usa estos paquetes como punto de partida y consulta los cambios que necesites.',
    destinationTitle: 'Destinos Populares',
    faqTitle: 'Preguntas Frecuentes',
    faqs: [
      ['¿Cuántos días necesito para Luwuk Banggai?', 'Depende de las islas y actividades que quieras incluir. Hay rutas cortas de 1–2 días y viajes de varias jornadas.'],
      ['¿Se puede personalizar el itinerario?', 'Sí. Podemos adaptarlo a tus fechas, número de viajeros, intereses y orden de destinos.'],
      ['¿Los viajes comienzan en Luwuk?', 'Muchas rutas pueden comenzar en Luwuk, especialmente para viajeros que llegan al aeropuerto de Syukuran Aminuddin Amir.'],
      ['¿Los horarios marítimos son siempre fijos?', 'Pueden cambiar por el clima, las condiciones del mar, los operadores y las circunstancias locales.'],
      ['¿Cómo reservo?', 'Contacta con Banggai Wonderland por WhatsApp y envía tus fechas, número de viajeros y necesidades.']
    ],
    closingTitle: 'Planifica tu Viaje a Banggai',
    closingText: 'Cuéntanos tus fechas y los destinos prioritarios para crear un viaje privado acorde con tu tiempo y estilo.'
  },
  fr: {
    title: 'Services de Tour à Luwuk Banggai',
    description: 'Services de tour à Luwuk Banggai pour des voyages privés dans les îles Banggai, de Luwuk à Salakan, Peleng, Paisu Pok et Pulo Dua.',
    eyebrow: 'Voyages privés · Luwuk · Îles Banggai',
    h1: 'Services de Tour à Luwuk Banggai pour Voyages Privés',
    intro: 'Banggai Wonderland aide les voyageurs à organiser des circuits depuis Luwuk vers les îles Banggai avec un itinéraire flexible et une assistance locale.',
    primaryCta: 'Contacter sur WhatsApp',
    secondaryCta: 'Voir les circuits',
    servicesTitle: 'Services de Tour depuis Luwuk',
    services: [
      ['Voyages privés', 'Des voyages privés pour couples, familles, amis et petits groupes.'],
      ['Itinéraires personnalisés', 'Combinez Luwuk, Salakan, Peleng, Banggai Laut et d’autres destinations selon votre temps.'],
      ['Logistique', 'Aide pour les transports terrestres et maritimes selon l’itinéraire et les conditions locales.'],
      ['Guide local', 'Une assistance locale pour garder un voyage pratique et adaptable.']
    ],
    routeTitle: 'Routes et Destinations',
    routeText: 'Depuis Luwuk, le voyage peut être une courte escapade ou un itinéraire de plusieurs jours entre les îles. Le parcours s’adapte au temps disponible, aux intérêts, aux horaires maritimes et aux conditions locales.',
    processTitle: 'Comment Fonctionne le Voyage Privé',
    process: [
      ['01', 'Partagez votre projet', 'Envoyez vos dates, le nombre de voyageurs, la durée et les destinations souhaitées.'],
