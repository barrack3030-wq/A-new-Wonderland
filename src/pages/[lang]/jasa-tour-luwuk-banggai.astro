      ['03', 'Ajustons les détails', 'Transport, hébergement, activités et besoins sont définis avant le départ.'],
      ['04', 'Départ de Luwuk', 'Une fois le parcours confirmé, le voyage reste adaptable aux conditions locales.']
    ],
    packageTitle: 'Circuits Privés',
    packageText: 'Utilisez ces circuits comme base puis échangez avec nous pour les ajuster.',
    destinationTitle: 'Destinations Populaires',
    faqTitle: 'Questions Fréquentes',
    faqs: [
      ['Combien de jours prévoir pour Luwuk Banggai ?', 'Cela dépend des îles et activités souhaitées. Des itinéraires courts de 1 à 2 jours et des voyages de plusieurs jours sont possibles.'],
      ['L’itinéraire peut-il être personnalisé ?', 'Oui. Il peut être adapté aux dates, au groupe, aux intérêts et à l’ordre des destinations.'],
      ['Les voyages commencent-ils à Luwuk ?', 'De nombreux itinéraires commencent à Luwuk, notamment pour les voyageurs arrivant à l’aéroport Syukuran Aminuddin Amir.'],
      ['Les horaires maritimes sont-ils fixes ?', 'Ils peuvent varier selon la météo, l’état de la mer, les opérateurs et les conditions locales.'],
      ['Comment réserver ?', 'Contactez Banggai Wonderland sur WhatsApp avec vos dates, le nombre de voyageurs et vos besoins.']
    ],
    closingTitle: 'Préparez votre Voyage à Banggai',
    closingText: 'Indiquez-nous vos dates et les destinations prioritaires afin de construire un voyage privé adapté à votre temps et à votre style.'
  },
  zh: {
    title: 'Luwuk Banggai 旅游服务',
    description: '提供从 Luwuk 出发的邦盖群岛私人旅行服务，可前往 Salakan、Peleng、Paisu Pok、Pulo Dua 等目的地。',
    eyebrow: '私人旅行 · Luwuk · 邦盖群岛',
    h1: 'Luwuk Banggai 私人旅行与定制旅游服务',
    intro: 'Banggai Wonderland 协助游客从 Luwuk 前往邦盖群岛，提供灵活行程规划和当地协助。',
    primaryCta: 'WhatsApp 咨询',
    secondaryCta: '查看旅游套餐',
    servicesTitle: 'Luwuk 出发的旅游服务',
    services: [
      ['私人旅行', '适合情侣、家庭、朋友和小型团队的私人行程。'],
      ['定制路线', '根据时间安排组合 Luwuk、Salakan、Peleng、Banggai Laut 等目的地。'],
      ['行程交通协助', '根据路线和当地情况安排陆路及海上交通。'],
      ['当地向导', '提供当地协助，让行程更清晰并可根据情况调整。']
    ],
    routeTitle: '路线与目的地',
    routeText: '从 Luwuk 出发，可以安排短途停留，也可以进行多日海岛旅行。路线会根据旅行时间、兴趣、船期和当地情况进行调整。',
    processTitle: '私人旅行如何安排',
    process: [
      ['01', '发送旅行计划', '告诉我们日期、人数、旅行时长和想去的目的地。'],
      ['02', '规划路线', '根据时间和兴趣组合目的地并安排合理顺序。'],
      ['03', '确认细节', '出发前讨论交通、住宿、活动及其他旅行需求。'],
      ['04', '从 Luwuk 出发', '确认后按照当地天气、海况和实际情况进行合理调整。']
    ],
    packageTitle: '私人旅行套餐',
    packageText: '先参考以下套餐，再根据您的需求咨询定制路线。',
    destinationTitle: '热门目的地',
    faqTitle: '常见问题',
    faqs: [
      ['Luwuk Banggai 适合安排几天？', '取决于想去的岛屿和活动。短途可以安排 1–2 天，海岛路线则可以安排多日行程。'],
      ['可以定制行程吗？', '可以。行程可根据日期、人数、兴趣和目的地顺序进行讨论与调整。'],
      ['旅行是否从 Luwuk 开始？', '很多路线可以从 Luwuk 开始，尤其适合从 Syukuran Aminuddin Amir 机场抵达的游客。'],
      ['海上交通时间是否固定？', '天气、海况、运营方和当地情况都可能影响船期，因此行程需要保留一定弹性。'],
      ['如何预订？', '通过 WhatsApp 联系 Banggai Wonderland，并发送日期、人数和行程需求。']
    ],
    closingTitle: '开始规划您的邦盖之旅',
    closingText: '告诉我们旅行日期以及优先想去的目的地，我们将协助您根据时间和旅行方式安排私人行程。'
  }
} as const;

const c = copy[currentLang] || copy.en;

const packages = await getCollection('packages');
const currentPackages = packages.filter(pkg => pkg.slug.startsWith(currentLang + '/'));
const preferredPackageSlugs = ['luwuk-one-day', 'luwuk-stopover', 'luwuk-salakan', 'banggai-wonderland', 'banggai-5d4n', 'ultimate-banggai'];
const selectedPackages = preferredPackageSlugs
  .map(slug => currentPackages.find(pkg => pkg.slug === currentLang + '/' + slug))
  .filter(Boolean);

const destinationData = await getCollection('destinations');
const preferredDestinations = ['paisu-pok-lake', 'piala-waterfall', 'oyama-beach', 'pulau-dua-balantak'];
const selectedDestinations = preferredDestinations
  .map(slug => destinationData.find(item => item.slug === currentLang + '/' + slug))
  .filter(Boolean);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: c.title,
  description: c.description,
  serviceType: currentLang === 'id' ? 'Jasa tour dan private trip Luwuk Banggai' : 'Luwuk Banggai private tour service',
  areaServed: [
    { '@type': 'Place', name: 'Luwuk' },
    { '@type': 'Place', name: 'Banggai Islands' }
  ],
  provider: {
    '@type': 'TravelAgency',
    name: 'Banggai Wonderland',
    url: 'https://banggaiwonderland.my.id/'
  },
  url: new URL('/' + currentLang + '/jasa-tour-luwuk-banggai/', Astro.site).href
};


const isId = currentLang === 'id';

const positioningCopy = isId
  ? {
      eyebrow: 'PRIVATE TRIP DARI LUWUK',
      title: 'Kami bantu atur perjalanan privat dari Luwuk ke Kepulauan Banggai, tanpa harus ribet urus transport antar pulau.',
      paragraphs: [
        'Untuk pasangan, keluarga, atau rombongan kecil. Bukan open trip — 1 grup 1 mobil/kapal, ritme ikut kamu.',
        'Mulai dari Luwuk (Bandara Syukuran Aminuddin Amir), kami bantu koordinasi mobil Luwuk–Salakan, ferry/speed ke Peleng, boat lokal, urutan rute, dan pendampingan lokal. Bisa 1–2 hari di Luwuk atau 4–6 hari sampai Paisu Pok & Pulo Dua.'
      ]
    }
  : null;

const servicesUi = isId
  ? [
      ['Private Trip', 'Satu grup privat, bukan digabung. Lebih fleksibel jam dan durasi.'],
      ['Custom Route', 'Kombinasi Luwuk, Salakan, Peleng, Banggai Laut disusun berdasarkan berapa hari yang kamu punya.'],
      ['Transportasi Perjalanan', 'Bantu atur mobil, ferry/speed, boat lokal sesuai jadwal real di lapangan.'],
      ['Local Guide', 'Orang lokal yang tahu waktu tempuh real, jalur bagus pagi/sore, dan kapan perlu geser jadwal karena cuaca.']
    ]
  : c.services;

const processUi = isId
  ? [
      ['01', 'Kirim rencana perjalanan', 'Sampaikan tanggal, jumlah peserta, lama perjalanan, dan destinasi. Contoh: 20–23 Des, 4 orang, 4 hari, ingin Paisu Pok.'],
      ['02', 'Susun rute', 'Kami cek jadwal kapal dan waktu tempuh real, lalu usulkan urutan yang masuk akal.'],
      ['03', 'Sesuaikan detail', 'Transport, penginapan, aktivitas, dan kebutuhan perjalanan dibahas sebelum berangkat.'],
      ['04', 'Berangkat dari Luwuk', 'Jalan sesuai plan, tetap fleksibel kalau cuaca atau kondisi laut berubah.']
    ]
  : c.process;

const packageMeta: Record<string, { label: string; featured?: boolean }> = {
  'luwuk-one-day': { label: 'SHORT TRIP' },
  'luwuk-stopover': { label: 'CITY + COAST' },
  'luwuk-salakan': { label: 'CROSSING' },
  'banggai-wonderland': { label: 'CLASSIC · Paling sering dipilih', featured: true },
  'banggai-5d4n': { label: 'COMPLETE' },
  'ultimate-banggai': { label: 'EXPEDITION' }
};

const destinationMicro: Record<string, { description: string; micro: string }> = {
  'paisu-pok-lake': {
    description: 'Danau jernih di Peleng yang menjadi salah satu tujuan utama perjalanan Banggai.',
    micro: 'Dari Salakan ±1,5 jam mobil · Jalan ±3 menit · Cocok berenang & foto'
  },
  'piala-waterfall': {
    description: 'Air terjun bertingkat di kawasan Luwuk untuk perjalanan singkat dari kota.',
    micro: '±15 menit dari kota Luwuk · Trek pendek bertingkat'
  },
  'oyama-beach': {
    description: 'Garis pasir panjang di Peleng yang cocok dimasukkan dalam rute pesisir.',
    micro: 'Garis pasir panjang di Peleng · Bagus sore'
  },
  'pulau-dua-balantak': {
    description: 'Kawasan pulau dengan laut jernih dan aktivitas island hopping.',
    micro: 'Butuh boat ±20 menit dari Peleng · Laguna jernih'
  }
};

const breadcrumbItems = [
  { name: 'Home', url: '/' + currentLang + '/' },
  { name: c.title, url: '/' + currentLang + '/jasa-tour-luwuk-banggai/' }
];
---
<BaseLayout
  title={c.title + ' | Banggai Wonderland'}
  description={c.description}
  seoTitle={c.title + ' | Banggai Wonderland'}
  seoDescription={c.description}
  ogImage="/images/Poganda-Beach-Banggai-IndonesiaJuara-Trip.webp"
  imageAlt={currentLang === 'id' ? 'Pantai Poganda di Kepulauan Banggai' : 'Poganda Beach in the Banggai Islands'}
  schema={schema}
>
  <div class="bg-sand-50 pt-28">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-8">
      <Breadcrumb items={breadcrumbItems} />
    </div>
<section class="relative overflow-hidden bg-ocean-900 text-white">
      <div class="absolute inset-0">
        <img src="/images/Poganda-Beach-Banggai-IndonesiaJuara-Trip.webp" alt={currentLang === 'id' ? 'Pantai Poganda Kepulauan Banggai' : 'Poganda Beach, Banggai Islands'} class="w-full h-full object-cover opacity-45" loading="eager" />
        <div class="absolute inset-0 bg-ocean-900/65"></div>
      </div>
      <div class="relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-20 md:py-28">
        <div class="max-w-4xl">
          <p class="text-white/65 text-xs font-bold tracking-[0.24em] uppercase mb-5">{c.eyebrow}</p>
          <h1 class="font-serif text-4xl sm:text-5xl md:text-7xl leading-[0.98] tracking-[-0.04em] font-medium mb-7">{c.h1}</h1>
          <p class="text-white/80 text-base md:text-xl leading-relaxed max-w-3xl mb-9">{c.intro}</p>
          <div class="flex flex-wrap gap-3">
            <a href="https://wa.me/6285820830530" target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-full bg-white text-ocean-900 px-6 py-3.5 text-sm font-semibold">{c.primaryCta} <span class="ml-2">→</span></a>
            <a href="#packages" class="inline-flex items-center rounded-full border border-white/25 bg-white/10 text-white px-6 py-3.5 text-sm font-semibold">{c.secondaryCta}</a>
          </div>
        </div>
      </div>
    </section>

