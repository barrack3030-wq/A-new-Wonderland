  id: { budget: '2026-11-02-biaya-trip-banggai-komponen-anggaran', twoday: '2026-11-02-itinerary-luwuk-2-hari-1-malam-air-terjun-pantai', choose: '2026-10-26-memilih-paket-banggai-tour-private-atau-open-trip', getthere: '2026-09-18-cara-menuju-kepulauan-banggai-dari-luwuk' },
  en: { budget: '2026-11-02-banggai-trip-budget-what-to-plan-for', twoday: '2026-11-02-luwuk-2-days-1-night-itinerary-waterfall-coast', choose: '2026-10-26-how-to-choose-banggai-tour-package', getthere: '2026-09-18-how-to-get-to-banggai-islands-from-luwuk' },
  es: { budget: '2026-11-02-presupuesto-viaje-banggai-que-planificar', twoday: '2026-11-02-itinerario-luwuk-2-dias-1-noche-cascadas-costa', choose: '2026-10-26-como-elegir-paquete-tour-banggai', getthere: '2026-09-18-como-llegar-islas-banggai-desde-luwuk' },
  fr: { budget: '2026-11-02-budget-voyage-banggai-quoi-prevoir', twoday: '2026-11-02-itineraire-luwuk-2-jours-1-nuit-cascades-cote', choose: '2026-10-26-choisir-forfait-tour-banggai', getthere: '2026-09-18-comment-rejoindre-les-iles-banggai-depuis-luwuk' }
} as const;
const guideMap = guideSlugs[currentLang as keyof typeof guideSlugs] || guideSlugs.en;
const waHero = 'https://wa.me/6285820830530?text=' + encodeURIComponent(ui.waGeneral);

const packages = await getCollection('packages');
const currentPackages = packages.filter(pkg => pkg.slug.startsWith(currentLang + '/'));
const preferredPackageSlugs = ['luwuk-one-day', 'luwuk-stopover', 'luwuk-salakan', 'banggai-wonderland', 'banggai-5d4n', 'ultimate-banggai'];
const selectedPackages = preferredPackageSlugs
  .map(slug => currentPackages.find(pkg => pkg.slug === currentLang + '/' + slug))
  .filter(Boolean);

const destinationData = await getCollection('destinations');
const preferredDestinations = ['paisu-pok-lake', 'piala-waterfall', 'oyama-beach', 'pulau-dua-balantak'];
const selectedDestinations = preferredDestinations
  .map(slug => destinationData.find(item => item.slug === currentLang + '/' + slug))
  .filter(Boolean);

const orgRef = { '@id': new URL('/#organization', Astro.site).href };
const pageUrl = new URL('/' + currentLang + '/jasa-tour-luwuk-banggai/', Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': pageUrl + '#service',
      name: pageSeoTitle,
      description: pageSeoDescription,
      serviceType: currentLang === 'id' ? 'Jasa tour dan private trip Luwuk Banggai' : 'Luwuk Banggai private tour service',
      areaServed: [
        { '@type': 'Place', name: 'Luwuk' },
        { '@type': 'Place', name: 'Banggai Islands' }
      ],
      provider: orgRef,
      inLanguage: currentLang,
      url: pageUrl
    },
    {
      '@type': 'FAQPage',
      '@id': pageUrl + '#faq',
      inLanguage: currentLang,
      mainEntity: c.faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } }))
    }
  ]
};

const isId = currentLang === 'id';

const servicesUi = isId
  ? [
      ['Private trip', 'Satu grup sendiri, tidak digabung dengan peserta lain.'],
      ['Rute custom', 'Gabungkan Luwuk, Salakan, Peleng, dan destinasi lain sesuai durasi.'],
      ['Transportasi', 'Bantuan koordinasi mobil, ferry/speedboat, dan boat lokal.'],
      ['Pendamping lokal', 'Bantu arahkan perjalanan dan menyesuaikan rute dengan kondisi lapangan.']
    ]
  : c.services;

const processUi = isId
  ? [
      ['01', 'Kirim rencana', 'Tanggal, jumlah peserta, durasi, dan destinasi prioritas.'],
      ['02', 'Cek rute', 'Kami susun urutan perjalanan dan transportasi yang realistis.'],
      ['03', 'Konfirmasi biaya', 'Detail layanan dan harga disepakati sebelum keberangkatan.'],
      ['04', 'Mulai dari Luwuk', 'Rute dapat menyesuaikan cuaca dan kondisi laut.']
    ]
  : c.process;

const packageMeta: Record<string, { label: string; featured?: boolean }> = {
  'luwuk-one-day': { label: 'SHORT TRIP' },
  'luwuk-stopover': { label: 'CITY + COAST' },
  'luwuk-salakan': { label: 'CROSSING' },
  'banggai-wonderland': { label: 'CLASSIC · Paling sering dipilih', featured: true },
  'banggai-5d4n': { label: 'COMPLETE' },
  'ultimate-banggai': { label: 'EXPEDITION' }
};

const destinationMicro: Record<string, { description: string; micro: string }> = {
  'paisu-pok-lake': {
    description: 'Danau air tawar yang sangat jernih di Peleng dan salah satu tujuan utama perjalanan Banggai.',
    micro: 'Luk Panenteng, Bulagi Utara, Peleng · Cocok berenang & foto'
  },
  'piala-waterfall': {
    description: 'Air terjun bertingkat di kawasan Luwuk untuk perjalanan singkat dari kota.',
    micro: 'Luwuk, Kabupaten Banggai · Trek pendek'
  },
  'oyama-beach': {
    description: 'Pantai pasir putih di ujung utara Pulau Banggai dengan air tenang dan hutan bakau; dijangkau dengan perahu.',
    micro: 'Banggai Utara, Banggai Laut · Dijangkau dengan perahu'
  },
  'pulau-dua-balantak': {
    description: 'Kawasan pulau dengan laut jernih dan aktivitas island hopping.',
    micro: 'Kampangar, Balantak Utara, Kabupaten Banggai'
  }
};

const breadcrumbItems = [
  { name: ui.home, url: '/' + currentLang + '/' },
  { name: pageSeoTitle.split(' | ')[0], url: '/' + currentLang + '/jasa-tour-luwuk-banggai/' }
];
---
<BaseLayout
  title={pageSeoTitle}
  description={pageSeoDescription}
  seoTitle={pageSeoTitle}
  seoDescription={pageSeoDescription}
  ogImage="/images/Poganda-Beach-Banggai-IndonesiaJuara-Trip.webp"
  imageAlt={ui.heroAlt}
  schema={schema}
>
  <div class="bg-sand-50 pt-28">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-8">
      <Breadcrumb items={breadcrumbItems} />
    </div>
<section class="relative overflow-hidden bg-ocean-900 text-white">
      <div class="absolute inset-0">
        <img src="/images/Poganda-Beach-Banggai-IndonesiaJuara-Trip.webp" alt={ui.heroAlt} width="1820" height="1024" class="w-full h-full object-cover opacity-45" loading="eager" fetchpriority="high" />
        <div class="absolute inset-0 bg-ocean-900/65"></div>
      </div>
      <div class="relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-20 md:py-28">
        <div class="max-w-4xl">
          <p class="text-white/65 text-xs font-bold tracking-[0.24em] uppercase mb-5">{c.eyebrow}</p>
          <h1 class="font-serif text-4xl sm:text-5xl md:text-7xl leading-[0.98] tracking-[-0.04em] font-medium mb-7">{c.h1}</h1>
          <p class="text-white/80 text-base md:text-xl leading-relaxed max-w-3xl mb-9">{c.intro}</p>
          <div class="flex flex-wrap gap-3">
            <a href={waHero} target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-full bg-white text-ocean-900 px-6 py-3.5 text-sm font-semibold">{c.primaryCta} <span class="ml-2">→</span></a>
            <a href="#packages" class="inline-flex items-center rounded-full border border-white/25 bg-white/10 text-white px-6 py-3.5 text-sm font-semibold">{c.secondaryCta}</a>
          </div>
        </div>
      </div>
    </section>

    <section id="packages" class="bg-[#F4F5F7] py-14 md:py-20 scroll-mt-24">
      <div id="paket-wisata" class="scroll-mt-24"></div>
      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
        <div class="max-w-3xl mb-8 md:mb-10">
          <p class="text-[#14B8A6] text-xs font-bold tracking-[0.2em] uppercase mb-3">{ui.packages}</p>
          <h2 class="font-serif text-3xl md:text-[44px] text-ocean-900 tracking-[-0.03em] font-medium mb-3">{c.packageTitle}</h2>
          <p class="text-ocean-600 leading-relaxed max-w-2xl">{c.packageText}</p>
        </div>
        <div class="rounded-[28px] bg-white p-4 sm:p-6 md:p-8 shadow-[0_14px_40px_rgba(15,23,42,0.10)]">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3 gap-4 md:gap-5">
            {selectedPackages.map((pkg, index) => {
              const slug = pkg.slug.split('/')[1];
              const meta = packageMeta[slug] || { label: '' };
              const isFeatured = meta.featured === true;
              const photoByPackage = {
                'luwuk-one-day': selectedDestinations.find(item => item.slug.endsWith('/piala-waterfall'))?.data.image || '/images/Poganda-Beach-Banggai-IndonesiaJuara-Trip.webp',
                'luwuk-stopover': selectedDestinations.find(item => item.slug.endsWith('/oyama-beach'))?.data.image || '/images/Poganda-Beach-Banggai-IndonesiaJuara-Trip.webp',
                'luwuk-salakan': selectedDestinations.find(item => item.slug.endsWith('/paisu-pok-lake'))?.data.image || '/images/DSCF7073-5.webp',
                'banggai-wonderland': selectedDestinations.find(item => item.slug.endsWith('/pulau-dua-balantak'))?.data.image || '/images/Poganda-Beach-Banggai-IndonesiaJuara-Trip.webp',
                'banggai-5d4n': selectedDestinations.find(item => item.slug.endsWith('/oyama-beach'))?.data.image || '/images/DSCF7073-5.webp',
                'ultimate-banggai': selectedDestinations.find(item => item.slug.endsWith('/paisu-pok-lake'))?.data.image || '/images/DSCF7073-5.webp'
              };
              const photo = photoByPackage[slug] || pkg.data.image || '/images/Poganda-Beach-Banggai-IndonesiaJuara-Trip.webp';
              const orderText = ui.order;
              const orderMessage = encodeURIComponent(ui.wa(pkg.data.title));
              return (
                <article class="relative flex min-w-0 flex-col overflow-hidden rounded-xl border border-[#E5E7EB] bg-white transition duration-200 hover:-translate-y-1 hover:shadow-lg">
                  {isFeatured && <span class="absolute left-0 top-3 z-10 rounded-r-md bg-[#FACC15] px-3 py-1.5 text-[11px] font-bold text-[#332600] shadow-sm">★ BEST SELLER</span>}
                  <a href={'/' + currentLang + '/packages/' + slug + '/'} class="relative block h-40 sm:h-36 md:h-40 overflow-hidden bg-[#E8EEF2]">
                    <img src={photo} alt={pkg.data.imageAlt || pkg.data.title} class="h-full w-full object-cover transition-transform duration-500 hover:scale-105" loading="lazy" />
                    <span class="absolute bottom-3 left-3 rounded-md bg-white/95 px-2 py-1 text-[11px] font-semibold text-ocean-900 shadow-sm">{pkg.data.duration}</span>
                  </a>
                  <div class="flex flex-1 flex-col p-4">
                    <a href={'/' + currentLang + '/packages/' + slug + '/'} class="text-base font-bold leading-snug text-slate-900 hover:text-ocean-700">{pkg.data.title}</a>
                    <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{pkg.data.description}</p>
                    <div class="mt-3 flex flex-wrap gap-1.5">
                      {(pkg.data.destination || '').split(',').slice(0, 3).map(dest => (
                        <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] text-slate-600">{dest.trim()}</span>
                      ))}
                    </div>
                    <a href={'https://wa.me/6285820830530?text=' + orderMessage} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-[#4D5FA8] px-4 py-3 text-sm font-semibold text-white transition hover:bg-[#39498B] focus:outline-none focus:ring-2 focus:ring-[#4D5FA8] focus:ring-offset-2">{orderText}</a>
                  </div>
                </article>
              );
            })}
          </div>
          <p class="mt-6 text-xs leading-relaxed text-slate-500">{ui.priceNote}</p>
        </div>
      </div>
    </section>


    <section class="bg-white py-12 md:py-16">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
        <p class="text-[#14B8A6] text-xs font-bold tracking-[0.2em] uppercase mb-3">{ui.whyEyebrow}</p>
        <h2 class="font-serif text-3xl md:text-4xl text-ocean-900 leading-tight tracking-[-0.03em] mb-7">{ui.whyTitle}</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
          {ui.why.map(([t, d]) => (
            <article class="rounded-2xl border border-[#E8E2D6] bg-[#FFFEFB] p-5">
              <h3 class="font-semibold text-ocean-900 mb-2">{t}</h3>
              <p class="text-sm text-ocean-600 leading-[1.65]">{d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {isId ? (
      <section class="bg-[#F6F2E9] py-12 md:py-14">
        <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
          <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-7">
            <div>
              <p class="text-[#14B8A6] text-xs font-bold tracking-[0.2em] uppercase mb-3">{ui.private}</p>
              <h2 class="font-serif text-3xl md:text-4xl text-ocean-900 leading-tight tracking-[-0.03em]">{c.servicesTitle}</h2>
            </div>
            <p class="text-ocean-600 text-sm leading-[1.6] max-w-xl">Satu grup privat, rute sesuai durasi, dan bantuan mengatur perjalanan darat maupun laut.</p>
          </div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
            {servicesUi.map(([title, text]) => (
              <article class="rounded-2xl border border-[#E8E2D6] bg-[#FFFEFB] p-5">
                <h3 class="font-semibold text-ocean-900 mb-2">{title}</h3>
                <p class="text-sm text-ocean-600 leading-[1.65]">{text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    ) : (
    <section class="bg-[#F6F2E9] py-16 md:py-20">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
        <div class="max-w-3xl mb-10">
          <p class="text-[#14B8A6] text-xs font-bold tracking-[0.2em] uppercase mb-4">{ui.private}</p>
          <h2 class="font-serif text-3xl md:text-[44px] text-ocean-900 leading-tight tracking-[-0.03em] mb-4">{c.servicesTitle}</h2>
          <p class="text-ocean-600 text-[15px] md:text-base leading-[1.7] max-w-2xl">{isId ? 'Layanan utama untuk mengatur perjalanan privat dari Luwuk ke Kepulauan Banggai dengan rute yang realistis dan mudah diikuti.' : c.intro}</p>
        </div>
        <div class="border-y border-[#E8E2D6] divide-y divide-[#E8E2D6]">
          {servicesUi.map(([title, text], index) => (
            <article class="grid md:grid-cols-[90px_minmax(220px,1fr)_minmax(280px,36ch)] gap-4 md:gap-8 items-start py-7 md:py-8">
              <span class="font-serif text-3xl md:text-4xl text-[#14B8A6] leading-none">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="font-serif text-2xl md:text-3xl text-ocean-900">{title}</h3>
              <p class="text-ocean-600 text-[15px] leading-[1.7]">{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
    )}

    <section class="bg-[#FFFEFB] py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
        <div class="grid lg:grid-cols-[.9fr_1.1fr] gap-12 lg:gap-20 items-start">
          <div>
            <p class="text-[#14B8A6] text-xs font-bold tracking-[0.2em] uppercase mb-4">{ui.route}</p>
            <h2 class="font-serif text-3xl md:text-[44px] text-ocean-900 leading-tight tracking-[-0.03em] mb-5">{c.routeTitle}</h2>
            <div class="mt-10">
              {ui.stops.map(([name, note], index) => (
                <div class="grid grid-cols-[34px_1fr] gap-4">
                  <div class="flex flex-col items-center">
                    <span class={"w-2.5 h-2.5 rounded-full mt-2.5 " + (index === 3 ? 'bg-[#14B8A6] ring-4 ring-turquoise-100' : 'bg-ocean-300')}></span>
                    {index < 5 && <span class="w-px h-12 bg-[#E8E2D6]"></span>}
                  </div>
                  <div class="pb-7">
                    <p class="font-serif text-xl md:text-2xl text-ocean-900">{name}</p>
                    <p class="text-sm text-ocean-500 mt-1">{note}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div class="lg:pt-16">
            <div class="space-y-5">
              <div class="grid sm:grid-cols-3 gap-3">
                {ui.durations.map(([d, t]) => (
                  <div class="border-t border-[#E8E2D6] pt-4"><p class="text-xs font-bold uppercase tracking-[0.16em] text-[#14B8A6] mb-2">{d}</p><p class="text-sm text-ocean-600 leading-[1.7]">{t}</p></div>
                ))}
              </div>
              <div class="rounded-2xl border border-[#E8E2D6] bg-[#F6F2E9] px-5 py-5">
                <p class="font-semibold text-ocean-900 mb-2">{ui.routeNoteTitle}</p>
                <p class="text-sm text-ocean-600 leading-[1.7]">{ui.routeNote}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class class="bg-[#F6F2E9] py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-5 mb-10">
          <div class="max-w-3xl">
            <p class="text-[#14B8A6] text-xs font-bold tracking-[0.2em] uppercase mb-4">{ui.popular}</p>
            <h2 class="font-serif text-3xl md:text-[44px] text-ocean-900 tracking-[-0.03em] font-medium">{c.destinationTitle}</h2>
          </div>
          <a href={'/' + currentLang + '/banggai-travel/'} class="text-sm font-semibold text-ocean-900 underline underline-offset-4">Banggai Travel →</a>
        </div>
        <div class="grid lg:grid-cols-[1.25fr_1fr] gap-5">
          {selectedDestinations.length > 0 && (
            <a href={'/' + currentLang + '/destinations/' + selectedDestinations[0].slug.split('/').slice(1).join('/') + '/'} class="group relative overflow-hidden rounded-[24px] min-h-[560px] bg-[#0A1E3A]">
              <img src={selectedDestinations[0].data.image} alt={selectedDestinations[0].data.imageAlt || selectedDestinations[0].data.title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-ocean-950 via-ocean-950/35 to-transparent"></div>
              <div class="absolute inset-x-0 bottom-0 p-7 md:p-9">
                <p class="text-white/60 text-xs font-semibold uppercase tracking-[0.16em]">{selectedDestinations[0].data.location}</p>
                <h3 class="font-serif text-3xl md:text-4xl text-white mt-2">{selectedDestinations[0].data.title}</h3>
                {isId && destinationMicro['paisu-pok-lake'] && (<><p class="text-white/80 text-sm leading-relaxed mt-3 max-w-xl">{destinationMicro['paisu-pok-lake'].description}</p><p class="text-white/55 text-xs mt-3">{destinationMicro['paisu-pok-lake'].micro}</p></>)}
              </div>
            </a>
          )}
          <div class="grid sm:grid-cols-3 lg:grid-cols-1 gap-5">
            {selectedDestinations.slice(1).map(destination => {
              const slug = destination.slug.split('/').slice(1).join('/');
              const info = destinationMicro[slug];
              return (
                <a href={'/' + currentLang + '/destinations/' + slug + '/'} class="group grid sm:grid-cols-[180px_1fr] lg:grid-cols-[210px_1fr] gap-5 bg-[#FFFEFB] border border-[#E8E2D6] rounded-[20px] overflow-hidden">
                  <img src={destination.data.image} alt={destination.data.imageAlt || destination.data.title} class="w-full h-full min-h-[190px] object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                  <div class="p-5 flex flex-col justify-center">
                    <p class="text-xs uppercase tracking-[0.14em] text-ocean-500">{destination.data.location}</p>
                    <h3 class="font-serif text-2xl text-ocean-900 mt-2">{destination.data.title}</h3>
                    {isId && info ? (<><p class="text-sm text-ocean-600 leading-[1.7] mt-2">{info.description}</p><p class="text-xs text-ocean-500 mt-3">{info.micro}</p></>) : (<p class="text-sm text-ocean-600 leading-relaxed mt-2">{destination.data.location}</p>)}
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-[#F6F2E9] py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
        <div class="max-w-3xl mb-10">
          <p class="text-[#14B8A6] text-xs font-bold tracking-[0.2em] uppercase mb-4">{ui.how}</p>
          <h2 class="font-serif text-3xl md:text-[44px] text-ocean-900 tracking-[-0.03em] font-medium mb-4">{c.processTitle}</h2>
          {isId && <p class="text-ocean-600 leading-[1.7] max-w-2xl">Tidak perlu menyusun semuanya sendiri. Mulai dari tanggal dan jumlah peserta, lalu kita susun rute yang masuk akal.</p>}
        </div>
        <div class="relative">
          <div class="hidden lg:block absolute left-[8%] right-[8%] top-5 border-t border-[#D6D0C0]"></div>
          <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
            {processUi.map(([number, title, text]) => (
              <article class="relative">
                <div class="font-serif text-4xl text-ocean-900 relative bg-[#F6F2E9] w-fit pr-4">{number}</div>
                <h3 class="font-serif text-2xl text-ocean-900 mt-4 mb-3">{title}</h3>
                <p class="text-sm text-ocean-600 leading-[1.7]">{text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white py-14 md:py-20">
      <div class="max-w-5xl mx-auto px-5 sm:px-8">
        <p class="text-[#14B8A6] text-xs font-bold tracking-[0.2em] uppercase mb-3">{ui.guidesEyebrow}</p>
        <h2 class="font-serif text-3xl md:text-4xl text-ocean-900 tracking-[-0.03em] mb-6">{ui.guidesTitle}</h2>
        <ul class="grid sm:grid-cols-2 gap-3">
          {ui.guides.map(([label, key]) => (
            <li><a href={'/' + currentLang + '/blog/' + guideMap[key as keyof typeof guideMap] + '/'} class="block rounded-2xl border border-[#E8E2D6] bg-[#FFFEFB] px-5 py-4 text-ocean-900 font-medium hover:border-[#14B8A6] transition">{label} <span class="text-ocean-400">→</span></a></li>
          ))}
        </ul>
        {ui.landing.length > 0 && (
          <p class="mt-5 text-sm text-ocean-600">
            {ui.landing.map(([label, path], i) => (<><a href={'/' + currentLang + '/' + path + '/'} class="underline underline-offset-4 hover:text-ocean-900">{label}</a>{i < ui.landing.length - 1 ? ' · ' : ''}</>))}
          </p>
        )}
      </div>
    </section>

    <section class="bg-[#F6F2E9] py-16 md:py-24">
      <div class="max-w-4xl mx-auto px-5 sm:px-8">
        <p class="text-[#14B8A6] text-xs font-bold tracking-[0.2em] uppercase mb-4">FAQ</p>
        <h2 class="font-serif text-3xl md:text-[44px] text-ocean-900 tracking-[-0.03em] font-medium mb-8">{c.faqTitle}</h2>
        <div class="border-y border-[#E8E2D6] divide-y divide-[#E8E2D6]">
          {c.faqs.map(([question, answer], index) => (
            <details class="py-5 group" open={index === 0}>
              <summary class="cursor-pointer list-none flex items-start justify-between gap-6 font-serif text-lg md:text-xl text-ocean-900">
                <span>{question}</span><span class="font-sans text-ocean-400 text-xl leading-none transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="text-sm text-ocean-600 leading-[1.7] pt-3 max-w-3xl">{answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-[#0A1E3A] text-white py-20 md:py-24 relative overflow-hidden">
      <div class="absolute -top-32 -right-32 w-[420px] h-[420px] rounded-full opacity-50 blur-3xl" style="background: radial-gradient(circle, rgba(20,184,166,.28) 0%, rgba(20,184,166,0) 70%);"></div>
      <div class="relative max-w-4xl mx-auto px-5 sm:px-8 text-center">
        <p class="text-white/50 text-xs font-bold tracking-[0.24em] uppercase mb-5">Banggai Wonderland</p>
        <h2 class="font-serif text-4xl md:text-[44px] leading-tight tracking-[-0.03em] font-medium mb-5">{c.closingTitle}</h2>
        <p class="max-w-2xl mx-auto text-white/70 leading-[1.7] mb-8">{isId ? 'Beri tahu kami tanggal & destinasi prioritas. Kami bantu susun rute private trip sesuai waktu & gaya jalanmu.' : c.closingText}</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href={waHero} target="_blank" rel="noopener noreferrer" class="inline-flex rounded-full bg-white text-ocean-900 px-7 py-3.5 text-sm font-semibold">{c.primaryCta} <span class="ml-2">→</span></a>
          <a href="#paket-wisata" class="inline-flex rounded-full border border-white/20 bg-white/5 text-white px-7 py-3.5 text-sm font-semibold">{c.secondaryCta}</a>
        </div>
        {isId && <p class="text-white/45 text-xs mt-7">+62 858-2083-0530 · Luwuk · Kepulauan Banggai</p>}
      </div>
    </section>

  </div>

  <WhatsAppButton />
</BaseLayout>
