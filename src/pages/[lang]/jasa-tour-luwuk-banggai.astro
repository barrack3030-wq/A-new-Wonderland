const c = copy[currentLang] || copy.en;

const packages = await getCollection('packages');
const currentPackages = packages.filter(pkg => pkg.slug.startsWith(currentLang + '/'));
const preferredPackageSlugs = ['luwuk-one-day', 'luwuk-stopover', 'luwuk-salakan', 'banggai-wonderland', 'banggai-5d4n', 'ultimate-banggai'];
const selectedPackages = preferredPackageSlugs
  .map(slug => currentPackages.find(pkg => pkg.slug === currentLang + '/' + slug))
  .filter(Boolean);

const destinationData = await getCollection('destinations');
const preferredDestinations = ['paisu-pok-lake', 'piala-waterfall', 'oyama-beach', 'pulau-dua-balantak'];
const selectedDestinations = preferredDestinations
  .map(slug => destinationData.find(item => item.slug === currentLang + '/' + slug))
  .filter(Boolean);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: c.title,
  description: c.description,
  serviceType: currentLang === 'id' ? 'Jasa tour dan private trip Luwuk Banggai' : 'Luwuk Banggai private tour service',
  areaServed: [
    { '@type': 'Place', name: 'Luwuk' },
    { '@type': 'Place', name: 'Banggai Islands' }
  ],
  provider: {
    '@type': 'TravelAgency',
    name: 'Banggai Wonderland',
    url: 'https://banggaiwonderland.my.id/'
  },
  url: new URL('/' + currentLang + '/jasa-tour-luwuk-banggai/', Astro.site).href
};

const breadcrumbItems = [
  { name: 'Home', url: '/' + currentLang + '/' },
  { name: c.title, url: '/' + currentLang + '/jasa-tour-luwuk-banggai/' }
];
---

<BaseLayout
  title={c.title + ' | Banggai Wonderland'}
  description={c.description}
  seoTitle={c.title + ' | Banggai Wonderland'}
  seoDescription={c.description}
  ogImage="/images/Poganda-Beach-Banggai-IndonesiaJuara-Trip.webp"
  imageAlt={currentLang === 'id' ? 'Pantai Poganda di Kepulauan Banggai' : 'Poganda Beach in the Banggai Islands'}
  schema={schema}
>
  <div class="bg-sand-50 pt-28">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-8">
      <Breadcrumb items={breadcrumbItems} />
    </div>

    <section class="relative overflow-hidden bg-ocean-900 text-white">
      <div class="absolute inset-0">
        <img src="/images/Poganda-Beach-Banggai-IndonesiaJuara-Trip.webp" alt={currentLang === 'id' ? 'Pantai Poganda Kepulauan Banggai' : 'Poganda Beach, Banggai Islands'} class="w-full h-full object-cover opacity-45" loading="eager" />
        <div class="absolute inset-0 bg-ocean-900/65"></div>
      </div>
      <div class="relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-20 md:py-28">
        <div class="max-w-4xl">
          <p class="text-white/65 text-xs font-bold tracking-[0.24em] uppercase mb-5">{c.eyebrow}</p>
          <h1 class="font-serif text-4xl sm:text-5xl md:text-7xl leading-[0.98] tracking-[-0.04em] font-medium mb-7">{c.h1}</h1>
          <p class="text-white/80 text-base md:text-xl leading-relaxed max-w-3xl mb-9">{c.intro}</p>
          <div class="flex flex-wrap gap-3">
            <a href="https://wa.me/6285820830530" target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-full bg-white text-ocean-900 px-6 py-3.5 text-sm font-semibold">{c.primaryCta} <span class="ml-2">→</span></a>
            <a href={'/' + currentLang + '/packages/'} class="inline-flex items-center rounded-full border border-white/25 bg-white/10 text-white px-6 py-3.5 text-sm font-semibold">{c.secondaryCta}</a>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
        <div class="max-w-3xl mb-10">
          <p class="text-turquoise-600 text-xs font-bold tracking-[0.22em] uppercase mb-4">Banggai Wonderland</p>
          <h2 class="font-serif text-3xl md:text-5xl text-ocean-900 tracking-[-0.03em] font-medium mb-4">{c.servicesTitle}</h2>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5">
          {c.services.map(([title, text], index) => (
            <article class="rounded-2xl border border-sand-200 bg-sand-50 p-6">
              <span class="text-xs font-bold tracking-[0.16em] text-turquoise-700">0{index + 1}</span>
              <h3 class="font-serif text-xl text-ocean-900 mt-5 mb-3">{title}</h3>
              <p class="text-sm leading-relaxed text-ocean-600">{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-sand-50 py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 grid lg:grid-cols-[1.1fr_.9fr] gap-12 items-start">
        <div>
          <p class="text-turquoise-600 text-xs font-bold tracking-[0.22em] uppercase mb-4">Explore the region</p>
          <h2 class="font-serif text-3xl md:text-5xl text-ocean-900 tracking-[-0.03em] font-medium mb-5">{c.routeTitle}</h2>
          <p class="text-ocean-600 leading-relaxed max-w-2xl">{c.routeText}</p>
        </div>
        <div class="rounded-3xl bg-ocean-900 text-white p-7 md:p-9">
          <p class="text-white/55 text-xs font-bold tracking-[0.2em] uppercase mb-4">Start in Luwuk</p>
          <div class="grid grid-cols-2 gap-3 text-sm">
            <a href={'/' + currentLang + '/destinations/paisu-pok-lake/'} class="rounded-xl border border-white/15 bg-white/5 px-4 py-3 hover:bg-white/10">Paisu Pok</a>
            <a href={'/' + currentLang + '/destinations/piala-waterfall/'} class="rounded-xl border border-white/15 bg-white/5 px-4 py-3 hover:bg-white/10">Piala Waterfall</a>
            <a href={'/' + currentLang + '/destinations/oyama-beach/'} class="rounded-xl border border-white/15 bg-white/5 px-4 py-3 hover:bg-white/10">Oyama Beach</a>
            <a href={'/' + currentLang + '/destinations/pulau-dua-balantak/'} class="rounded-xl border border-white/15 bg-white/5 px-4 py-3 hover:bg-white/10">Pulo Dua</a>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
        <div class="max-w-3xl mb-12">
          <p class="text-turquoise-600 text-xs font-bold tracking-[0.22em] uppercase mb-4">Flexible planning</p>
