        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {c.process.map(([number, title, text]) => (
            <article class="border-t border-ocean-900/15 pt-5">
              <span class="text-sm font-bold text-turquoise-700">{number}</span>
              <h3 class="font-serif text-2xl text-ocean-900 mt-4 mb-3">{title}</h3>
              <p class="text-sm text-ocean-600 leading-relaxed">{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="packages" class="bg-sand-50 py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-5 mb-10">
          <div class="max-w-3xl">
            <p class="text-turquoise-600 text-xs font-bold tracking-[0.22em] uppercase mb-4">Choose a starting point</p>
            <h2 class="font-serif text-3xl md:text-5xl text-ocean-900 tracking-[-0.03em] font-medium mb-4">{c.packageTitle}</h2>
            <p class="text-ocean-600 leading-relaxed">{c.packageText}</p>
          </div>
          <a href="#packages" class="text-sm font-semibold text-ocean-900 underline underline-offset-4">View packages →</a>
        </div>
        <div class="grid md:grid-cols-2 gap-5">
          {selectedPackages.map(pkg => (
            <a href={'/' + currentLang + '/packages/' + pkg.slug.split('/').slice(1).join('/') + '/'} class="group rounded-3xl bg-white border border-sand-200 p-6 hover:-translate-y-0.5 transition-transform">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="text-[11px] font-bold tracking-[0.18em] uppercase text-turquoise-700">{pkg.data.duration}</p>
                  <h3 class="font-serif text-2xl text-ocean-900 mt-2">{pkg.data.title}</h3>
                  <p class="text-sm text-ocean-600 leading-relaxed mt-3">{pkg.data.description}</p>
                </div>
                <span class="text-ocean-900 text-xl">↗</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    {currentLang === 'id' && (
      <section class="bg-white py-12 md:py-16 border-t border-sand-200">
        <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
          <p class="text-turquoise-600 text-xs font-bold tracking-[0.22em] uppercase mb-4">Banggai Travel</p>
          <h2 class="font-serif text-3xl md:text-4xl text-ocean-900 tracking-[-0.03em] font-medium mb-4">Pilih Jenis Perjalanan Banggai</h2>
          <p class="text-ocean-600 leading-relaxed max-w-3xl mb-6">Gunakan halaman berikut untuk memilih format perjalanan sebelum melihat paket atau menyusun itinerary bersama.</p>
          <div class="grid md:grid-cols-3 gap-4">
            <a href="/id/banggai-travel/" class="rounded-2xl border border-sand-200 bg-sand-50 p-5 group">
              <h3 class="font-serif text-xl text-ocean-900 mb-2 group-hover:text-turquoise-700">Banggai Travel</h3>
              <p class="text-sm text-ocean-600 leading-relaxed">Hub utama untuk travel, private trip, custom tour, dan perjalanan Kepulauan Banggai.</p>
            </a>
            <a href="/id/banggai-trip/" class="rounded-2xl border border-sand-200 bg-sand-50 p-5 group">
              <h3 class="font-serif text-xl text-ocean-900 mb-2 group-hover:text-turquoise-700">Banggai Trip & Banggai Tour</h3>
              <p class="text-sm text-ocean-600 leading-relaxed">Panduan durasi, rute dari Luwuk, destinasi, dan perencanaan perjalanan.</p>
            </a>
            <a href="/id/banggai-open-trip/" class="rounded-2xl border border-sand-200 bg-sand-50 p-5 group">
              <h3 class="font-serif text-xl text-ocean-900 mb-2 group-hover:text-turquoise-700">Banggai Open Trip</h3>
              <p class="text-sm text-ocean-600 leading-relaxed">Informasi format perjalanan bersama, rute, jadwal, dan persiapan open trip.</p>
            </a>
          </div>
        </div>
      </section>
    )}

    <section class="bg-white py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
        <div class="max-w-3xl mb-10">
          <p class="text-turquoise-600 text-xs font-bold tracking-[0.22em] uppercase mb-4">Destination guides</p>
          <h2 class="font-serif text-3xl md:text-5xl text-ocean-900 tracking-[-0.03em] font-medium">{c.destinationTitle}</h2>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {selectedDestinations.map(destination => (
            <a href={'/' + currentLang + '/destinations/' + destination.slug.split('/').slice(1).join('/') + '/'} class="group overflow-hidden rounded-2xl border border-sand-200 bg-sand-50">
              <img src={destination.data.image} alt={destination.data.imageAlt || destination.data.title} class="w-full h-48 object-cover" loading="lazy" />
              <div class="p-5">
                <h3 class="font-serif text-xl text-ocean-900">{destination.data.title}</h3>
                <p class="text-xs text-ocean-500 mt-1">{destination.data.location}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-sand-50 py-16 md:py-24">
      <div class="max-w-4xl mx-auto px-5 sm:px-8">
        <p class="text-turquoise-600 text-xs font-bold tracking-[0.22em] uppercase mb-4">FAQ</p>
        <h2 class="font-serif text-3xl md:text-5xl text-ocean-900 tracking-[-0.03em] font-medium mb-8">{c.faqTitle}</h2>
        <div class="space-y-3">
          {c.faqs.map(([question, answer]) => (
            <details class="group rounded-2xl bg-white border border-sand-200 px-5 py-4">
              <summary class="cursor-pointer list-none pr-6 font-semibold text-ocean-900">{question}</summary>
              <p class="text-sm text-ocean-600 leading-relaxed pt-3">{answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-ocean-900 text-white py-20 md:py-24">
      <div class="max-w-4xl mx-auto px-5 sm:px-8 text-center">
        <p class="text-white/50 text-xs font-bold tracking-[0.24em] uppercase mb-5">Banggai Wonderland</p>
        <h2 class="font-serif text-4xl md:text-6xl leading-tight tracking-[-0.04em] font-medium mb-5">{c.closingTitle}</h2>
        <p class="max-w-2xl mx-auto text-white/70 leading-relaxed mb-8">{c.closingText}</p>
        <a href="https://wa.me/6285820830530" target="_blank" rel="noopener noreferrer" class="inline-flex rounded-full bg-white text-ocean-900 px-7 py-3.5 text-sm font-semibold">{c.primaryCta} <span class="ml-2">→</span></a>
      </div>
    </section>
  </div>

  <WhatsAppButton />
</BaseLayout>
