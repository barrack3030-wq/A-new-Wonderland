    secondaryCta: 'View Tour Packages',
    servicesTitle: 'Tour Services from Luwuk',
    services: [
      ['Private trips', 'Private journeys for couples, families, friends and small groups.'],
      ['Custom routes', 'Combine Luwuk, Salakan, Peleng, Banggai Laut and other destinations around your available time.'],
      ['Trip logistics', 'Assistance with land transport and sea travel according to the itinerary and local conditions.'],
      ['Local guide', 'Local assistance to keep the journey practical, clear and adaptable.']
    ],
    routeTitle: 'Banggai Tour from Luwuk: Routes and Destinations',
    routeText: 'Starting in Luwuk, a trip can range from a short stopover to a multi-day island journey. The itinerary is shaped around your available time, interests, boat schedules and local conditions rather than forcing every destination into one route.',
    processTitle: 'How the Private Trip Works',
    process: [
      ['01', 'Share your plan', 'Send your travel dates, group size, trip length and preferred destinations.'],
      ['02', 'Build the route', 'We help combine destinations and arrange a practical travel sequence.'],
      ['03', 'Refine the details', 'Transport, accommodation, activities and trip requirements are discussed before departure.'],
      ['04', 'Start from Luwuk', 'Once the details are agreed, the journey runs with sensible adjustments for local conditions.']
    ],
    packageTitle: 'Banggai Tour & Private Trip Packages',
    packageText: 'Use these packages as starting points, then discuss itinerary adjustments around your needs.',
    destinationTitle: 'Popular Destinations',
    faqTitle: 'Frequently Asked Questions',
    faqs: [
      ['How many days should I plan for Luwuk Banggai?', 'It depends on how many islands and activities you want to include. Short routes can fit 1–2 days, while island-focused trips can be planned over several days.'],
      ['Can the itinerary be customized?', 'Yes. The itinerary can be discussed around your dates, group size, interests and preferred destination order.'],
      ['Do trips start from Luwuk?', 'Many routes can start from Luwuk, especially when arriving through Syukuran Aminuddin Amir Airport.'],
      ['Will sea travel always run on schedule?', 'Sea schedules and route order can be affected by weather, sea conditions, operators and local circumstances, so flexibility is important.'],
      ['How do I book?', 'Contact Banggai Wonderland on WhatsApp with your dates, group size and itinerary needs.']
    ],
    closingTitle: 'Plan Your Banggai Journey',
    closingText: 'Tell us your travel dates and the places you want to prioritize. We can help shape a private trip around your time and travel style.'
