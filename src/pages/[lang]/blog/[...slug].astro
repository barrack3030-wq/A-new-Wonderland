---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { useTranslations } from '../../../utils/i18n';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(entry => {
    const [lang, ...slugParts] = entry.slug.split('/');
    return { params: { lang, slug: slugParts.join('/') }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { lang } = Astro.params;
const t = useTranslations(lang as any);
const { Content } = await entry.render();
const formattedDate = new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'long', day: 'numeric' }).format(entry.data.pubDate);
const resolvedImage = entry.data.image;
const resolvedImageAlt = entry.data.imageAlt || entry.data.title;

const allPosts = await getCollection('blog');
const sameLanguagePosts = allPosts
  .filter(post => post.id !== entry.id && post.slug.startsWith(`${lang}/`))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recommendedPosts = sameLanguagePosts.slice(0, 8);

const allDestinations = await getCollection('destinations');
const languageDestinations = allDestinations.filter(destination => destination.slug.startsWith(`${lang}/`));
const destinationLinkData = languageDestinations.map(destination => {
  const destinationSlug = destination.slug.replace(`${lang}/`, '');
  const title = destination.data.title;
  const aliases = [
    title,
    title.replace(/\b(Beach|Lake|Waterfall|Island|Bay|Cave)\b/gi, '').replace(/\s+/g, ' ').trim(),
    destinationSlug.split('-').map(part => part.charAt(0).toUpperCase() + part.slice(1)).join(' ')
      .replace(/\b(Beach|Lake|Waterfall|Island|Bay|Cave)\b/gi, '').replace(/\s+/g, ' ').trim()
  ];
  if (destinationSlug.includes('pulau-dua')) aliases.push('Pulo Dua', 'Pulau Dua');
  return { aliases: [...new Set(aliases)].filter(alias => alias.length >= 4), url: `/${lang}/destinations/${destinationSlug}/`, title };
}).sort((a, b) => Math.max(...b.aliases.map(x => x.length)) - Math.max(...a.aliases.map(x => x.length)));

const relatedDestinations = languageDestinations
  .map(destination => {
    const text = `${entry.data.title} ${entry.data.description} ${(entry.data.tags || []).join(' ')}`.toLowerCase();
    const score = text.includes(destination.data.title.toLowerCase()) ? 3 : text.includes(destination.data.location.toLowerCase()) ? 2 : text.includes(destination.data.category.toLowerCase()) ? 1 : 0;
    return { destination, score };
  })
  .sort((a, b) => b.score - a.score)
  .slice(0, 8)
  .map(item => item.destination);

const labels = {
  id: { recommended: 'Rekomendasi Artikel', related: 'Destinasi Terkait', allDestinations: 'Lihat Semua Destinasi', moreArticles: 'Artikel Lainnya', tourService: 'Butuh bantuan menyusun perjalanan dari Luwuk? Lihat jasa tour Luwuk Banggai' },
  en: { recommended: 'Recommended Articles', related: 'Related Destinations', allDestinations: 'View All Destinations', moreArticles: 'More Articles', tourService: 'Planning a trip from Luwuk? Explore our Luwuk Banggai tour services' },
  es: { recommended: 'Artículos Recomendados', related: 'Destinos Relacionados', allDestinations: 'Ver Todos los Destinos', moreArticles: 'Más Artículos', tourService: '¿Planeas un viaje desde Luwuk? Ver nuestros servicios de tour' },
  fr: { recommended: 'Articles Recommandés', related: 'Destinations Associées', allDestinations: 'Voir Toutes les Destinations', moreArticles: 'Plus d’Articles', tourService: 'Vous planifiez un voyage depuis Luwuk ? Voir nos services de tour' },