---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { useTranslations } from '../../../utils/i18n';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(entry => {
    const [lang, ...slugParts] = entry.slug.split('/');
    return { params: { lang, slug: slugParts.join('/') }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { lang } = Astro.params;
const t = useTranslations(lang as any);
const { Content } = await entry.render();
const formattedDate = new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'long', day: 'numeric' }).format(entry.data.pubDate);
const resolvedImage = entry.data.image;
const resolvedImageAlt = entry.data.imageAlt || entry.data.title;

const allPosts = await getCollection('blog');
const sameLanguagePosts = allPosts
  .filter(post => post.id !== entry.id && post.slug.startsWith(`${lang}/`))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recommendedPosts = sameLanguagePosts.slice(0, 8);

const allDestinations = await getCollection('destinations');
const languageDestinations = allDestinations.filter(destination => destination.slug.startsWith(`${lang}/`));
const destinationLinkData = languageDestinations.map(destination => {
  const destinationSlug = destination.slug.replace(`${lang}/`, '');
  const title = destination.data.title;
  const aliases = [
    title,
    title.replace(/\b(Beach|Lake|Waterfall|Island|Bay|Cave)\b/gi, '').replace(/\s+/g, ' ').trim(),
    destinationSlug.split('-').map(part => part.charAt(0).toUpperCase() + part.slice(1)).join(' ')
      .replace(/\b(Beach|Lake|Waterfall|Island|Bay|Cave)\b/gi, '').replace(/\s+/g, ' ').trim()
  ];
  if (destinationSlug.includes('pulau-dua')) aliases.push('Pulo Dua', 'Pulau Dua');
  return { aliases: [...new Set(aliases)].filter(alias => alias.length >= 4), url: `/${lang}/destinations/${destinationSlug}/`, title };
}).sort((a, b) => Math.max(...b.aliases.map(x => x.length)) - Math.max(...a.aliases.map(x => x.length)));

const relatedDestinations = languageDestinations
  .map(destination => {
    const text = `${entry.data.title} ${entry.data.description} ${(entry.data.tags || []).join(' ')}`.toLowerCase();
    const score = text.includes(destination.data.title.toLowerCase()) ? 3 : text.includes(destination.data.location.toLowerCase()) ? 2 : text.includes(destination.data.category.toLowerCase()) ? 1 : 0;
    return { destination, score };
  })
  .sort((a, b) => b.score - a.score)
  .slice(0, 8)
  .map(item => item.destination);

const labels = {
  id: { recommended: 'Rekomendasi Artikel', related: 'Destinasi Terkait', allDestinations: 'Lihat Semua Destinasi', moreArticles: 'Artikel Lainnya' },
  en: { recommended: 'Recommended Articles', related: 'Related Destinations', allDestinations: 'View All Destinations', moreArticles: 'More Articles' },
  es: { recommended: 'Artículos Recomendados', related: 'Destinos Relacionados', allDestinations: 'Ver Todos los Destinos', moreArticles: 'Más Artículos' },
  fr: { recommended: 'Articles Recommandés', related: 'Destinations Associées', allDestinations: 'Voir Toutes les Destinations', moreArticles: 'Plus d’Articles' },
  zh: { recommended: '推荐文章', related: '相关目的地', allDestinations: '查看所有目的地', moreArticles: '更多文章' },
}[lang as 'id' | 'en' | 'es' | 'fr' | 'zh'] || { recommended: 'Recommended Articles', related: 'Related Destinations', allDestinations: 'View All Destinations', moreArticles: 'More Articles' };

const postUrl = new URL(`/${lang}/blog/${Astro.params.slug}/`, Astro.site || Astro.url.origin).href;
const breadcrumbItems = [
  { name: 'Home', url: `/${lang}/` },
  { name: t('nav.blog'), url: `/${lang}/blog/` },
  { name: entry.data.title, url: `/${lang}/blog/${Astro.params.slug}/` }
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  image: resolvedImage,
  url: postUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  author: { '@type': 'Person', name: entry.data.author },
  publisher: { '@type': 'Organization', name: 'Banggai Wonderland' },
  datePublished: entry.data.pubDate.toISOString(),
  inLanguage: lang
};
---

<BaseLayout title={`${entry.data.title} | Banggai Wonderland Blog`} description={entry.data.description} seoTitle={entry.data.seoTitle} seoDescription={entry.data.seoDescription} ogImage={resolvedImage} imageAlt={resolvedImageAlt} schema={schema}>
  <div class="bg-sand-50 pt-32 pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumb items={breadcrumbItems} />
      <div class="mt-8 mb-10 text-center">
        <div class="flex flex-wrap justify-center gap-2 mb-6">
          {entry.data.tags?.map(tag => <span class="bg-turquoise-100 text-turquoise-800 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">{tag}</span>)}
        </div>
        <h1 class="blog-post-title text-4xl md:text-5xl lg:text-6xl font-serif font-bold text-ocean-900 mb-6 leading-tight">{entry.data.title}</h1>
        <div class="flex items-center justify-center text-ocean-500 space-x-4 text-sm font-medium">
          <div>{t('blog.by')} {entry.data.author}</div><span>•</span><div>{formattedDate}</div>
        </div>
      </div>
    </div>
  </div>

  <section class="pb-20 bg-sand-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_320px] gap-10 items-start">
        <main class="min-w-0">
          <div class="rounded-3xl overflow-hidden shadow-2xl mb-12 -mt-8 relative z-10">
            <img src={resolvedImage} alt={resolvedImageAlt} class="w-full h-auto object-cover max-h-[600px]" />
          </div>
          <article id="blog-post-content" class="blog-post-content prose prose-lg prose-ocean max-w-none prose-headings:font-serif prose-headings:text-ocean-900 prose-p:text-ocean-700 prose-p:leading-relaxed prose-p:text-justify prose-li:text-ocean-700 prose-a:text-turquoise-600 hover:prose-a:text-turquoise-500 prose-img:rounded-2xl prose-img:shadow-md bg-white p-8 md:p-12 rounded-3xl shadow-sm border border-sand-200">
            <Content />
          </article>
          <div class="mt-12 text-center"><a href={`/${lang}/blog/`} class="inline-flex items-center text-ocean-900 font-bold hover:text-turquoise-600 transition-colors">← {t('blog.back')}</a></div>
        </main>

        <aside class="lg:sticky lg:top-28 space-y-6">
          <section class="bg-white rounded-3xl border border-sand-200 shadow-sm p-5">
            <div class="flex items-center justify-between mb-5"><h2 class="font-serif text-xl font-bold text-ocean-900">{labels.recommended}</h2><span class="h-px flex-1 ml-4 bg-sand-200"></span></div>
            <div class="sidebar-scroll sidebar-scroll-light space-y-4 pr-1">
              {recommendedPosts.map(post => {
                const postSlug = post.slug.replace(`${lang}/`, '');
                return <a href={`/${lang}/blog/${postSlug}/`} class="group block"><div class="flex gap-3"><img src={post.data.image} alt={post.data.imageAlt || post.data.title} class="w-24 h-20 object-cover rounded-xl shrink-0" loading="lazy" /><div class="min-w-0"><h3 class="text-sm font-bold text-ocean-900 leading-snug group-hover:text-turquoise-600 transition-colors line-clamp-3">{post.data.title}</h3><p class="mt-1 text-xs text-ocean-500">{new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'short', day: 'numeric' }).format(post.data.pubDate)}</p></div></div></a>;
              })}
            </div>
          </section>
          <section class="bg-white rounded-3xl border border-sand-200 shadow-sm p-5">
            <div class="flex items-center justify-between mb-5"><h2 class="font-serif text-xl font-bold text-ocean-900">{labels.related}</h2><span class="h-px flex-1 ml-4 bg-sand-200"></span></div>
            <div class="sidebar-scroll sidebar-scroll-light space-y-4 pr-1">
              {relatedDestinations.map(destination => {
                const destinationSlug = destination.slug.replace(`${lang}/`, '');
                return <a href={`/${lang}/destinations/${destinationSlug}/`} class="group block"><div class="flex gap-3"><img src={destination.data.image} alt={destination.data.imageAlt || destination.data.title} class="w-24 h-20 object-cover rounded-xl shrink-0" loading="lazy" /><div class="min-w-0"><h3 class="text-sm font-bold text-ocean-900 leading-snug group-hover:text-turquoise-600 transition-colors line-clamp-3">{destination.data.title}</h3><p class="mt-1 text-xs text-ocean-500">{destination.data.location}</p></div></div></a>;
              })}
            </div>
            <a href={`/${lang}/destinations/`} class="mt-5 inline-flex text-sm font-bold text-ocean-900 hover:text-turquoise-600 transition-colors">{labels.allDestinations} →</a>
          </section>
          {sameLanguagePosts.length > 4 && <a href={`/${lang}/blog/`} class="block bg-turquoise-50 border border-turquoise-100 rounded-3xl px-5 py-4 text-sm font-bold text-ocean-900 hover:border-turquoise-300 transition-colors">{labels.moreArticles} →</a>}
        </aside>
      </div>
    </div>
  </section>

  <script define:vars={{ destinationLinkData }}>
    const root = document.getElementById('blog-post-content');
    const destinations = destinationLinkData;

    if (root && Array.isArray(destinations) && destinations.length) {
      const skipTags = new Set(['A', 'CODE', 'PRE', 'SCRIPT', 'STYLE', 'H1', 'H2', 'H3', 'H4', 'H5', 'H6']);
      const aliases = destinations.flatMap(item => item.aliases.map(alias => ({ ...item, alias })))
        .sort((a, b) => b.alias.length - a.alias.length);

      const escapeRegExp = value => value.replace(/[.*+?^$()|[\\]\\]/g, '\\  <style is:global>
    .destination-inline-link {
      color: inherit;
      text-decoration-line: underline;
      text-decoration-color: rgba(20, 184, 166, 0.55);
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
      transition: color .2s ease, text-decoration-color .2s ease;
    }
    .destination-inline-link:hover {
      color: rgb(13, 148, 136);
      text-decoration-color: currentColor;
    }
    .sidebar-scroll');
      const pattern = new RegExp('\\b(' + aliases.map(item => escapeRegExp(item.alias)).join('|') + ')\\b', 'gi');

      const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
      const textNodes = [];
      let current;
      while ((current = walker.nextNode())) {
        if (!current.parentElement || skipTags.has(current.parentElement.tagName)) continue;
        textNodes.push(current);
      }

      for (const node of textNodes) {
        const text = node.nodeValue || '';
        pattern.lastIndex = 0;
        if (!pattern.test(text)) continue;
        pattern.lastIndex = 0;

        const fragment = document.createDocumentFragment();
        let lastIndex = 0;
        let match;

        while ((match = pattern.exec(text))) {
          const alias = match[0];
          const destination = aliases.find(item => item.alias.toLowerCase() === alias.toLowerCase());
          if (!destination) continue;
          if (match.index > lastIndex) fragment.appendChild(document.createTextNode(text.slice(lastIndex, match.index)));

          const link = document.createElement('a');
          link.href = destination.url;
          link.textContent = alias;
          link.className = 'destination-inline-link';
          link.title = 'Explore ' + destination.title;
          fragment.appendChild(link);
          lastIndex = match.index + alias.length;
        }

        if (lastIndex > 0) {
          if (lastIndex < text.length) fragment.appendChild(document.createTextNode(text.slice(lastIndex)));
          node.parentNode?.replaceChild(fragment, node);
        }
      }
    }
  </script>

  <style is:global>
    .sidebar-scroll { max-height: 420px; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; }
    .sidebar-scroll-light { scrollbar-color: rgba(9, 74, 92, 0.35) transparent; }
    .sidebar-scroll::-webkit-scrollbar { width: 6px; }
    .sidebar-scroll::-webkit-scrollbar-track { background: transparent; }
    .sidebar-scroll-light::-webkit-scrollbar-thumb { background: rgba(9, 74, 92, 0.28); border-radius: 999px; }
    .sidebar-scroll-light::-webkit-scrollbar-thumb:hover { background: rgba(9, 74, 92, 0.45); }
    @media (max-width: 1023px) { .sidebar-scroll { max-height: 360px; } }
    @media (max-width: 767px) {
      .blog-post-title { font-size: clamp(2rem, 9vw, 2.35rem); line-height: 1.02; letter-spacing: -0.015em; margin-bottom: 1.5rem; }
      .blog-post-content { padding: 1.75rem 1.35rem; }
      .blog-post-content :where(p, li) { text-align: left; }
      .blog-post-content :where(p) { line-height: 1.7; }
    }
  </style>
  <WhatsAppButton />
</BaseLayout>
