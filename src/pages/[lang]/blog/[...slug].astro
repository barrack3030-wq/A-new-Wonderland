---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { useTranslations } from '../../../utils/i18n';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(entry => {
    const [lang, ...slugParts] = entry.slug.split('/');
    const postSlug = slugParts.join('/');
    
    return {
      params: { lang, slug: postSlug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { lang } = Astro.params;
const t = useTranslations(lang as any);
const { Content } = await entry.render();

const formattedDate = new Intl.DateTimeFormat(lang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(entry.data.pubDate);

const breadcrumbItems = [
  { name: 'Home', url: `/${lang}/` },
  { name: t('nav.blog'), url: `/${lang}/blog/` },
  { name: entry.data.title, url: `/${lang}/blog/${Astro.params.slug}/` }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": entry.data.title,
  "description": entry.data.description,
  "image": entry.data.image,
  "author": {
    "@type": "Person",
    "name": entry.data.author
  },
  "datePublished": entry.data.pubDate.toISOString()
};
---

<BaseLayout 
  title={`${entry.data.title} | Banggai Wonderland Blog`}
  description={entry.data.description}
  seoTitle={entry.data.seoTitle}
  seoDescription={entry.data.seoDescription}
  ogImage={entry.data.image}
  imageAlt={entry.data.imageAlt}
  schema={schema}
>
  
  <div class="bg-sand-50 pt-32 pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumb items={breadcrumbItems} />
      
      <div class="mt-8 mb-10 text-center">
        <div class="flex flex-wrap justify-center gap-2 mb-6">
          {entry.data.tags?.map(tag => (
            <span class="bg-turquoise-100 text-turquoise-800 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
              {tag}
            </span>
          ))}
        </div>
        
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-bold text-ocean-900 mb-6 leading-tight">
          {entry.data.title}
        </h1>
        
        <div class="flex items-center justify-center text-ocean-500 space-x-4 text-sm font-medium">
          <div class="flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
            {t('blog.by')} {entry.data.author}
          </div>
          <span>•</span>
          <div class="flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            {formattedDate}
          </div>
        </div>
      </div>
    </div>
  </div>

  <section class="pb-20 bg-sand-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Featured Image -->
      <div class="rounded-3xl overflow-hidden shadow-2xl mb-16 -mt-8 relative z-10">
        <img src={entry.data.image} alt={entry.data.imageAlt || entry.data.title} class="w-full h-auto object-cover max-h-[600px]" />
      </div>

      <!-- Blog Content -->
      <article class="prose prose-lg prose-ocean max-w-none 
        prose-headings:font-serif prose-headings:text-ocean-900 
        prose-p:text-ocean-700 prose-p:leading-relaxed
        prose-a:text-turquoise-600 hover:prose-a:text-turquoise-500
        prose-img:rounded-2xl prose-img:shadow-md
        bg-white p-8 md:p-12 rounded-3xl shadow-sm border border-sand-200">
        <Content />
      </article>

      <div class="mt-12 text-center">
        <a href={`/${lang}/blog/`} class="inline-flex items-center text-ocean-900 font-bold hover:text-turquoise-600 transition-colors">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"></path></svg>
          {t('blog.back')}
        </a>
      </div>
    </div>
  </section>

  <WhatsAppButton />
</BaseLayout>
