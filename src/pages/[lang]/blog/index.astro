---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { languages, useTranslations } from '../../../utils/i18n';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as any);

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(post => post.slug.startsWith(`${lang}/`))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = posts[0];
const remainingPosts = posts.slice(1);

const breadcrumbItems = [
  { name: 'Home', url: `/${lang}/` },
  { name: t('nav.blog'), url: `/${lang}/blog/` }
];
---

<BaseLayout 
  title={`${t('nav.blog')} | Banggai Wonderland`}
  description={`Read the latest travel news and stories from Banggai Wonderland.`}
>
  <div class="bg-sand-50 pt-32 pb-20 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <Breadcrumb items={breadcrumbItems} />
      
      <div class="mb-14 max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-turquoise-600 mb-4">Banggai Wonderland Journal</p>
        <h1 class="font-serif text-4xl md:text-5xl font-bold text-ocean-900 mb-4">{t('nav.blog')}</h1>
        <p class="text-lg text-ocean-600 leading-relaxed">{t('hero.desc')}</p>
        <a href="/seo-lab/" class="inline-flex items-center mt-5 text-sm font-medium text-ocean-700 hover:text-ocean-900 transition-colors" rel="nofollow">
          SEO Content Planning <span class="ml-2">→</span>
        </a>
      </div>

      {featuredPost ? (
        <>
          <section class="mb-16">
            <div class="flex items-center justify-between mb-6">
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.2em] text-ocean-500 mb-1">Featured Guide</p>
                <h2 class="font-serif text-2xl md:text-3xl font-bold text-ocean-900">Start your journey here</h2>
              </div>
            </div>
            <BlogCard post={featuredPost} featured />
          </section>

          {remainingPosts.length > 0 && (
            <section>
              <div class="flex items-end justify-between mb-7">
                <div>
                  <p class="text-xs font-bold uppercase tracking-[0.2em] text-ocean-500 mb-1">Travel Guides</p>
                  <h2 class="font-serif text-2xl md:text-3xl font-bold text-ocean-900">Explore Banggai</h2>
                </div>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
                {remainingPosts.map(post => (
                  <BlogCard post={post} />
                ))}
              </div>
            </section>
          )}
        </>
      ) : (
        <div class="text-center py-20 bg-white rounded-2xl border border-sand-200">
          <p class="text-ocean-600">No blog posts found for this language yet.</p>
        </div>
      )}
      
    </div>
  </div>

  <WhatsAppButton />
</BaseLayout>
