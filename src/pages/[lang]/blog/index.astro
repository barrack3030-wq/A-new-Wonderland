---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { languages, useTranslations } from '../../../utils/i18n';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as any);

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(post => post.slug.startsWith(`${lang}/`))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = posts[0];
const remainingPosts = posts.slice(1);

const breadcrumbItems = [
  { name: 'Home', url: `/${lang}/` },
  { name: t('nav.blog'), url: `/${lang}/blog/` }
];
---

<BaseLayout 
  title={`${t('nav.blog')} | Banggai Wonderland`}
  description={`Read the latest travel news and stories from Banggai Wonderland.`}
>
  <div class="bg-sand-50 pt-32 pb-20 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumb items={breadcrumbItems} />
      
      <div class="mb-12">
        <h1 class="font-serif text-4xl md:text-5xl font-bold text-ocean-900 mb-4">{t('nav.blog')}</h1>
        <p class="text-lg text-ocean-600 max-w-2xl">{t('hero.desc')}</p>
      </div>

      {posts.length > 0 ? (
        <div class="space-y-16">
          {featuredPost && (
            <section>
              <div class="flex items-center gap-3 mb-6">
                <span class="h-px w-8 bg-turquoise-500"></span>
                <p class="text-xs font-bold uppercase tracking-[0.2em] text-ocean-500">Featured Guide</p>
              </div>

              <a href={`/${lang}/blog/${featuredPost.slug.split('/').slice(1).join('/')}/`} class="group grid grid-cols-1 lg:grid-cols-2 bg-white rounded-3xl overflow-hidden border border-sand-200 shadow-sm hover:shadow-xl transition-all duration-300">
                <div class="relative min-h-[280px] lg:min-h-[420px] overflow-hidden">
                  <img
                    src={featuredPost.data.image}
                    alt={featuredPost.data.imageAlt || featuredPost.data.title}
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    loading="eager"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-ocean-950/30 to-transparent"></div>
                </div>
                <div class="p-7 sm:p-10 lg:p-12 flex flex-col justify-center">
                  <div class="flex flex-wrap gap-2 mb-5">
                    {featuredPost.data.tags?.slice(0, 2).map(tag => (
                      <span class="text-[10px] font-bold uppercase tracking-wider text-ocean-700 bg-sand-100 px-3 py-1.5 rounded-full">{tag}</span>
                    ))}
                  </div>
                  <div class="text-xs text-ocean-500 uppercase tracking-wider font-semibold mb-4">
                    {new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'long', day: 'numeric' }).format(featuredPost.data.pubDate)}
                  </div>
                  <h2 class="font-serif text-3xl md:text-4xl font-bold text-ocean-900 leading-tight mb-5 group-hover:text-turquoise-600 transition-colors">
                    {featuredPost.data.title}
                  </h2>
                  <p class="text-ocean-600 leading-relaxed mb-8 max-w-xl">
                    {featuredPost.data.description}
                  </p>
                  <span class="inline-flex items-center text-sm uppercase tracking-wider font-bold text-turquoise-600">
                    {t('blog.read_more')}
                    <svg class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                  </span>
                </div>
              </a>
            </section>
          )}

          {remainingPosts.length > 0 && (
            <section>
              <div class="flex items-center justify-between mb-7">
                <div class="flex items-center gap-3">
                  <span class="h-px w-8 bg-turquoise-500"></span>
                  <h2 class="font-serif text-2xl md:text-3xl font-bold text-ocean-900">Travel Guides</h2>
                </div>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
                {remainingPosts.map(post => <BlogCard post={post} />)}
              </div>
            </section>
          )}
        </div>
      ) : (
        <div class="text-center py-20 bg-white rounded-2xl border border-sand-200">
          <p class="text-ocean-600">No blog posts found for this language yet.</p>
        </div>
      )}
    </div>
  </div>

  <WhatsAppButton />
</BaseLayout>
