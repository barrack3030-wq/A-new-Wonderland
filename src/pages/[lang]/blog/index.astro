---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { languages, useTranslations } from '../../../utils/i18n';

export function getStaticPaths() { return Object.keys(languages).map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params;
const t = useTranslations(lang as any);
const allPosts = await getCollection('blog');
const posts = allPosts.filter(post => post.slug.startsWith(`${lang}/`)).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredPost = posts[0];
const recentPosts = posts.slice(1,4);
const remainingPosts = posts.slice(4);
const articleSearchText = (post: typeof posts[number]) => `${post.data.title} ${post.data.description} ${(post.data.tags || []).join(' ')}`.toLowerCase();

const copy = ({
  en: { title:'Banggai Islands Travel Guide', description:'Travel guides, practical route information and local stories for exploring the Banggai Islands, Luwuk, Peleng and surrounding islands in Central Sulawesi.', intro:'Use the Banggai Wonderland journal to research destinations, routes, seasons and practical ideas before your private trip. Start with a destination guide, then connect it with the relevant itinerary.', guides:'Destination guides and practical travel information' },
  id: { title:'Panduan Wisata Kepulauan Banggai', description:'Panduan perjalanan, informasi rute, dan cerita lokal untuk menjelajahi Kepulauan Banggai, Luwuk, Peleng, dan pulau-pulau sekitarnya di Sulawesi Tengah.', intro:'Gunakan jurnal Banggai Wonderland untuk mencari informasi destinasi, rute, musim, dan persiapan perjalanan sebelum private trip. Mulai dari panduan destinasi lalu hubungkan dengan itinerary yang sesuai.', guides:'Panduan destinasi dan informasi perjalanan' },
  es: { title:'Guía de viaje de las Islas Banggai', description:'Guías de viaje, rutas prácticas e historias locales para explorar las Islas Banggai, Luwuk, Peleng y las islas cercanas de Sulawesi Central.', intro:'Consulta el diario de Banggai Wonderland para investigar destinos, rutas y temporadas antes de tu viaje privado.', guides:'Guías de destinos e información práctica' },
  fr: { title:'Guide de voyage des îles Banggai', description:'Guides pratiques, itinéraires et récits locaux pour découvrir les îles Banggai, Luwuk, Peleng et les îles voisines du centre de Sulawesi.', intro:'Consultez le journal Banggai Wonderland pour préparer votre voyage privé et comprendre les destinations, itinéraires et saisons.', guides:'Guides des destinations et informations pratiques' },