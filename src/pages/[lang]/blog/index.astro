---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { languages, useTranslations } from '../../../utils/i18n';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as any);

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(post => post.slug.startsWith(`${lang}/`))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = posts[0];
const recentPosts = posts.slice(1, 4);
const remainingPosts = posts.slice(4);

const breadcrumbItems = [
  { name: 'Home', url: `/${lang}/` },
  { name: t('nav.blog'), url: `/${lang}/blog/` }
];

const articleSearchText = (post: typeof posts[number]) =>
  `${post.data.title} ${post.data.description} ${(post.data.tags || []).join(' ')}`.toLowerCase();
---

<BaseLayout
  title={`${t('nav.blog')} | Banggai Wonderland`}
  description={`Read travel guides, stories and practical advice for exploring the Banggai Islands.`}
>
  <div class="bg-sand-50 pt-28 md:pt-32 pb-20 min-h-screen">
    <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
      <Breadcrumb items={breadcrumbItems} />

      <header class="text-center max-w-4xl mx-auto pt-8 md:pt-12 pb-16 md:pb-20">
        <p class="text-xs font-bold uppercase tracking-[0.28em] text-turquoise-600 mb-5">Banggai Wonderland Journal</p>
        <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-ocean-950 leading-[1.05] mb-6">
          Stories from the Banggai Islands
        </h1>
        <p class="text-base md:text-lg text-ocean-600 leading-relaxed max-w-2xl mx-auto">
          Travel guides, local stories and practical ideas for discovering Banggai beyond the usual route.
        </p>
      </header>

      <div class="mb-14 max-w-2xl mx-auto">
        <label for="blog-search" class="sr-only">Search articles</label>
        <div class="relative">
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-ocean-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z"></path>
          </svg>
          <input
            id="blog-search"
            type="search"
            placeholder="Search articles..."
            autocomplete="off"
            class="w-full rounded-xl border border-sand-300 bg-white py-3.5 pl-12 pr-12 text-sm text-ocean-900 placeholder:text-ocean-400 shadow-sm outline-none transition focus:border-turquoise-400 focus:ring-4 focus:ring-turquoise-500/10"
          />
          <button id="blog-search-clear" type="button" class="hidden absolute right-3 top-1/2 -translate-y-1/2 rounded-full p-2 text-ocean-400 hover:bg-sand-100 hover:text-ocean-700" aria-label="Clear search">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 6l12 12M18 6 6 18"></path></svg>
          </button>
        </div>
        <p id="blog-search-status" class="mt-3 text-center text-xs text-ocean-500 min-h-4" aria-live="polite"></p>
      </div>

      {posts.length > 0 ? (
        <div id="blog-results">
          <section aria-labelledby="recent-posts-heading">
            <div class="flex items-center justify-between mb-7">
              <h2 id="recent-posts-heading" class="text-xl md:text-2xl font-bold text-ocean-950">Recent blog posts</h2>
              <span class="hidden sm:block h-px flex-1 ml-6 bg-sand-200"></span>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-[1.55fr_1fr] gap-7 lg:gap-8">
              {featuredPost && (
                <article
                  class="blog-search-item group"
                  data-search={articleSearchText(featuredPost)}
                >
                  <a href={`/${lang}/blog/${featuredPost.slug.split('/').slice(1).join('/')}/`} class="block h-full">
                    <div class="relative aspect-[4/3] sm:aspect-[16/10] lg:aspect-[4/3] overflow-hidden rounded-2xl bg-ocean-100">
                      <img
                        src={featuredPost.data.image}
                        alt={featuredPost.data.imageAlt || featuredPost.data.title}
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                        loading="eager"
                      />
                    </div>
                    <div class="pt-5 pr-2">
                      <div class="flex items-center gap-2 text-[11px] font-medium text-ocean-500 mb-3">
                        <span>{new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'short', day: 'numeric' }).format(featuredPost.data.pubDate)}</span>
                        <span>•</span>
                        <span>{featuredPost.data.tags?.[0] || 'Travel Guide'}</span>
                      </div>
                      <div class="flex items-start justify-between gap-5">
                        <div>
                          <h3 class="font-serif text-2xl sm:text-3xl font-bold text-ocean-950 leading-tight group-hover:text-turquoise-600 transition-colors">
                            {featuredPost.data.title}
                          </h3>
                          <p class="mt-3 text-sm leading-relaxed text-ocean-600 max-w-2xl">
                            {featuredPost.data.description}
                          </p>
                        </div>
                        <span class="hidden sm:flex shrink-0 w-9 h-9 rounded-full border border-ocean-200 items-center justify-center text-ocean-700 transition-all group-hover:border-turquoise-400 group-hover:text-turquoise-600 group-hover:translate-x-1" aria-hidden="true">
                          ↗
                        </span>
                      </div>
                    </div>
                  </a>
                </article>
              )}

              <div class="space-y-6">
                {recentPosts.map(post => (
                  <article class="blog-search-item group border-b border-sand-200 pb-6 last:border-b-0 last:pb-0" data-search={articleSearchText(post)}>
                    <a href={`/${lang}/blog/${post.slug.split('/').slice(1).join('/')}/`} class="grid grid-cols-[120px_1fr] sm:grid-cols-[150px_1fr] gap-4">
                      <div class="aspect-[4/3] overflow-hidden rounded-xl bg-ocean-100">
                        <img
                          src={post.data.image}
                          alt={post.data.imageAlt || post.data.title}
                          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                          loading="lazy"
                        />
                      </div>
                      <div class="min-w-0">
                        <div class="text-[10px] font-medium text-ocean-500 mb-2">
                          {new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'short', day: 'numeric' }).format(post.data.pubDate)}
                        </div>
                        <h3 class="font-semibold text-base leading-snug text-ocean-950 group-hover:text-turquoise-600 transition-colors line-clamp-3">
                          {post.data.title}
                        </h3>
                        <p class="hidden sm:block mt-2 text-xs leading-relaxed text-ocean-600 line-clamp-2">
                          {post.data.description}
                        </p>
                        <div class="flex flex-wrap gap-1.5 mt-3">
                          {post.data.tags?.slice(0, 2).map(tag => (
                            <span class="text-[9px] font-medium text-ocean-600 border border-ocean-200 rounded-full px-2 py-0.5">{tag}</span>
                          ))}
                        </div>
                      </div>
                    </a>
                  </article>
                ))}
              </div>
            </div>
          </section>

          {remainingPosts.length > 0 && (
            <section id="travel-guides-section" class="mt-20">
              <div class="flex items-center justify-between mb-7">
                <h2 class="text-xl md:text-2xl font-bold text-ocean-950">Travel Guides</h2>
                <span class="h-px flex-1 ml-6 bg-sand-200"></span>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-7 gap-y-10">
                {remainingPosts.map(post => (
                  <div class="blog-search-item" data-search={articleSearchText(post)}>
                    <BlogCard post={post} />
                  </div>
                ))}
              </div>
            </section>
          )}

          <div id="blog-no-results" class="hidden text-center py-16">
            <p class="text-lg font-semibold text-ocean-900">No articles found</p>
            <p class="mt-2 text-sm text-ocean-500">Try a different search term.</p>
          </div>
        </div>
      ) : (
        <div class="text-center py-20 bg-white rounded-2xl border border-sand-200">
          <p class="text-ocean-600">No blog posts found for this language yet.</p>
        </div>
      )}
    </div>
  </div>

  <WhatsAppButton />

  <script>
    const input = document.querySelector('#blog-search');
    const clearButton = document.querySelector('#blog-search-clear');
    const status = document.querySelector('#blog-search-status');
    const items = Array.from(document.querySelectorAll('.blog-search-item'));
    const guidesSection = document.querySelector('#travel-guides-section');
    const noResults = document.querySelector('#blog-no-results');

    function filterArticles() {
      const query = input?.value.trim().toLowerCase() || '';
      let visible = 0;
      let visibleGuides = 0;

      items.forEach((item) => {
        const searchable = item.getAttribute('data-search') || '';
        const matches = !query || searchable.includes(query);
        item.classList.toggle('hidden', !matches);
        if (matches) {
          visible++;
          if (item.closest('#travel-guides-section')) visibleGuides++;
        }
      });

      if (clearButton) clearButton.classList.toggle('hidden', !query);
      if (status) status.textContent = query ? `${visible} article${visible === 1 ? '' : 's'} found` : '';
      if (guidesSection) guidesSection.classList.toggle('hidden', Boolean(query) && visibleGuides === 0);
      if (noResults) noResults.classList.toggle('hidden', !query || visible === 0 ? false : true);
      if (noResults) noResults.classList.toggle('hidden', !query || visible !== 0);
    }

    input?.addEventListener('input', filterArticles);
    clearButton?.addEventListener('click', () => {
      if (input) input.value = '';
      filterArticles();
      input?.focus();
    });
  </script>
</BaseLayout>
