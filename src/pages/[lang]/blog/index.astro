---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { languages, useTranslations } from '../../../utils/i18n';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as any);

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(post => post.slug.startsWith(`${lang}/`))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = posts[0];
const remainingPosts = posts.slice(1);

const breadcrumbItems = [
  { name: 'Home', url: `/${lang}/` },
  { name: t('nav.blog'), url: `/${lang}/blog/` }
];
---

<BaseLayout 
  title={`${t('nav.blog')} | Banggai Wonderland`}
  description={`Read the latest travel news and stories from Banggai Wonderland.`}
>
  <div class="bg-sand-50 pt-32 pb-20 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumb items={breadcrumbItems} />
      
      <div class="mb-10">
        <h1 class="font-serif text-4xl md:text-5xl font-bold text-ocean-900 mb-4">{t('nav.blog')}</h1>
        <p class="text-lg text-ocean-600 max-w-2xl">{t('hero.desc')}</p>
      </div>

      <div class="mb-12">
        <label for="blog-search" class="sr-only">Search articles</label>
        <div class="relative max-w-2xl">
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-ocean-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z"></path>
          </svg>
          <input
            id="blog-search"
            type="search"
            placeholder="Search articles..."
            autocomplete="off"
            class="w-full rounded-2xl border border-sand-200 bg-white py-4 pl-12 pr-12 text-ocean-900 placeholder:text-ocean-400 shadow-sm outline-none transition focus:border-turquoise-400 focus:ring-4 focus:ring-turquoise-500/10"
          />
          <button id="blog-search-clear" type="button" class="hidden absolute right-3 top-1/2 -translate-y-1/2 rounded-full p-2 text-ocean-400 hover:bg-sand-100 hover:text-ocean-700" aria-label="Clear search">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 6l12 12M18 6 6 18"></path></svg>
          </button>
        </div>
        <p id="blog-search-status" class="mt-3 text-sm text-ocean-500" aria-live="polite"></p>
      </div>

      {posts.length > 0 ? (
        <div id="blog-results" class="space-y-16">
          {featuredPost && (
            <section class="blog-search-item" data-search="{`${featuredPost.data.title} ${featuredPost.data.description} ${(featuredPost.data.tags || []).join(' ')}`.toLowerCase()}">
              <div class="flex items-center gap-3 mb-6">
                <span class="h-px w-8 bg-turquoise-500"></span>
                <p class="text-xs font-bold uppercase tracking-[0.2em] text-ocean-500">Featured Guide</p>
              </div>

              <a href={`/${lang}/blog/${featuredPost.slug.split('/').slice(1).join('/')}/`} class="group grid grid-cols-1 lg:grid-cols-2 bg-white rounded-3xl overflow-hidden border border-sand-200 shadow-sm hover:shadow-xl transition-all duration-300">
                <div class="relative min-h-[280px] lg:min-h-[420px] overflow-hidden">
                  <img
                    src={featuredPost.data.image}
                    alt={featuredPost.data.imageAlt || featuredPost.data.title}
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    loading="eager"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-ocean-950/30 to-transparent"></div>
                </div>
                <div class="p-7 sm:p-10 lg:p-12 flex flex-col justify-center">
                  <div class="flex flex-wrap gap-2 mb-5">
                    {featuredPost.data.tags?.slice(0, 2).map(tag => (
                      <span class="text-[10px] font-bold uppercase tracking-wider text-ocean-700 bg-sand-100 px-3 py-1.5 rounded-full">{tag}</span>
                    ))}
                  </div>
                  <div class="text-xs text-ocean-500 uppercase tracking-wider font-semibold mb-4">
                    {new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'long', day: 'numeric' }).format(featuredPost.data.pubDate)}
                  </div>
                  <h2 class="font-serif text-3xl md:text-4xl font-bold text-ocean-900 leading-tight mb-5 group-hover:text-turquoise-600 transition-colors">
                    {featuredPost.data.title}
                  </h2>
                  <p class="text-ocean-600 leading-relaxed mb-8 max-w-xl">
                    {featuredPost.data.description}
                  </p>
                  <span class="inline-flex items-center text-sm uppercase tracking-wider font-bold text-turquoise-600">
                    {t('blog.read_more')}
                    <svg class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                  </span>
                </div>
              </a>
            </section>
          )}

          {remainingPosts.length > 0 && (
            <section id="travel-guides-section">
              <div class="flex items-center justify-between mb-7">
                <div class="flex items-center gap-3">
                  <span class="h-px w-8 bg-turquoise-500"></span>
                  <h2 class="font-serif text-2xl md:text-3xl font-bold text-ocean-900">Travel Guides</h2>
                </div>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
                {remainingPosts.map(post => (
                  <div class="blog-search-item" data-search={`${post.data.title} ${post.data.description} ${(post.data.tags || []).join(' ')}`.toLowerCase()}>
                    <BlogCard post={post} />
                  </div>
                ))}
              </div>
            </section>
          )}
        </div>
      ) : (
        <div class="text-center py-20 bg-white rounded-2xl border border-sand-200">
          <p class="text-ocean-600">No blog posts found for this language yet.</p>
        </div>
      )}
    </div>
  </div>

  <WhatsAppButton />

  <script>
    const input = document.querySelector('#blog-search');
    const clearButton = document.querySelector('#blog-search-clear');
    const status = document.querySelector('#blog-search-status');
    const items = Array.from(document.querySelectorAll('.blog-search-item'));
    const featured = items[0];
    const guidesSection = document.querySelector('#travel-guides-section');

    function filterArticles() {
      const query = input?.value.trim().toLowerCase() || '';
      let visible = 0;

      items.forEach((item) => {
        const searchable = item.getAttribute('data-search') || '';
        const matches = !query || searchable.includes(query);
        item.classList.toggle('hidden', !matches);
        if (matches) visible++;
      });

      if (clearButton) clearButton.classList.toggle('hidden', !query);
      if (status) status.textContent = query ? `${visible} article${visible === 1 ? '' : 's'} found` : '';
      if (guidesSection && query && featured && !featured.classList.contains('hidden')) {
        guidesSection.classList.remove('hidden');
      }
    }

    input?.addEventListener('input', filterArticles);
    clearButton?.addEventListener('click', () => {
      if (input) input.value = '';
      filterArticles();
      input?.focus();
    });
  </script>
</BaseLayout>
