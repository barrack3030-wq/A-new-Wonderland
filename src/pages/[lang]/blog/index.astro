---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import WhatsAppButton from '../../../components/WhatsAppButton.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { languages, useTranslations } from '../../../utils/i18n';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as any);

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(post => post.slug.startsWith(`${lang}/`))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const breadcrumbItems = [
  { name: 'Home', url: `/${lang}/` },
  { name: t('nav.blog'), url: `/${lang}/blog/` }
];
---

<BaseLayout 
  title={`${t('nav.blog')} | Banggai Wonderland`}
  description={`Read the latest travel news and stories from Banggai Wonderland.`}
>
  <div class="bg-sand-50 pt-32 pb-20 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <Breadcrumb items={breadcrumbItems} />
      
      <div class="mb-12">
        <h1 class="font-serif text-4xl md:text-5xl font-bold text-ocean-900 mb-4">{t('nav.blog')}</h1>
        <p class="text-lg text-ocean-600 max-w-2xl">{t('hero.desc')}</p>
      </div>

      {posts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map(post => (
            <BlogCard post={post} />
          ))}
        </div>
      ) : (
        <div class="text-center py-20 bg-white rounded-2xl border border-sand-200">
          <p class="text-ocean-600">No blog posts found for this language yet.</p>
        </div>
      )}
      
    </div>
  </div>

  <WhatsAppButton />
</BaseLayout>
