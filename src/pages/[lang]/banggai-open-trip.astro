---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'id' } }];
}

const title = 'Banggai Open Trip | Open Trip Banggai & Luwuk';
const description = 'Banggai Open Trip dari Luwuk ke Paisu Pok, Peleng, Salakan, Pulo Dua, dan destinasi pilihan. Cek jadwal serta rute perjalanan yang tersedia.';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: 'Banggai Open Trip',
  description,
  touristType: ['Solo travelers', 'Couples', 'Small groups'],
  itinerary: {
    '@type': 'ItemList',
    itemListElement: ['Luwuk','Salakan','Peleng','Paisu Pok','Pulo Dua'].map((name, index) => ({
      '@type': 'ListItem', position: index + 1, name
    }))
  }
};
---
<BaseLayout title={title} description={description} seoTitle={title} seoDescription={description} ogImage="/images/Poganda-Beach-Banggai-IndonesiaJuara-Trip.webp" imageAlt="Banggai Open Trip">
  <div class="bg-sand-50 pt-28">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-8">
      <Breadcrumb items={[{ name: 'Home', url: '/id/' }, { name: 'Banggai Travel', url: '/id/banggai-travel/' }, { name: 'Banggai Open Trip', url: '/id/banggai-open-trip/' }]} />
    </div>
    <section class="relative overflow-hidden bg-ocean-900 text-white">
      <img src="/images/Poganda-Beach-Banggai-IndonesiaJuara-Trip.webp" alt="Banggai Open Trip, Kepulauan Banggai" class="absolute inset-0 w-full h-full object-cover opacity-40" loading="eager" />
      <div class="absolute inset-0 bg-ocean-900/70"></div>
      <div class="relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-20 md:py-28">
        <p class="text-white/60 text-xs font-bold tracking-[0.24em] uppercase mb-5">Open Trip Banggai · Luwuk Banggai</p>
        <h1 class="font-serif text-4xl sm:text-5xl md:text-7xl leading-[0.98] tracking-[-0.04em] font-medium max-w-4xl mb-7">Banggai Open Trip</h1>
        <p class="text-white/80 text-base md:text-xl leading-relaxed max-w-3xl mb-9">Jelajahi Kepulauan Banggai dalam perjalanan bersama dari Luwuk menuju pulau, pantai, dan destinasi alam pilihan. Jadwal, rute, dan ketersediaan peserta mengikuti keberangkatan yang dibuka.</p>
        <div class="flex flex-wrap gap-3">
          <a href="https://wa.me/6285820830530" target="_blank" rel="noopener noreferrer" class="rounded-full bg-white text-ocean-900 px-6 py-3.5 text-sm font-semibold">Tanya Jadwal Open Trip →</a>
          <a href="/id/banggai-travel/" class="rounded-full border border-white/25 bg-white/10 px-6 py-3.5 text-sm font-semibold">Banggai Travel</a>
        </div>
      </div>
    </section>
    <section class="bg-white py-16 md:py-24">
      <div class="max-w-4xl mx-auto px-5 sm:px-8">
        <p class="text-turquoise-600 text-xs font-bold tracking-[0.22em] uppercase mb-4">Open Trip Banggai</p>
        <h2 class="font-serif text-3xl md:text-5xl text-ocean-900 mb-6">Apa itu Banggai Open Trip?</h2>
        <p class="text-ocean-600 leading-relaxed mb-5">Banggai Open Trip adalah format perjalanan bersama yang memungkinkan peserta dari kelompok berbeda bergabung dalam rute yang sama. Format ini dapat menjadi pilihan bagi wisatawan yang bepergian sendiri, berdua, atau dalam kelompok kecil.</p>
        <p class="text-ocean-600 leading-relaxed">Karena perjalanan Kepulauan Banggai melibatkan transportasi laut dan destinasi yang berjauhan, itinerary perlu disesuaikan dengan jadwal kapal, cuaca, kondisi laut, dan waktu yang tersedia. Untuk melihat pilihan perjalanan yang lebih luas, kunjungi <a href="/id/banggai-travel/" class="font-semibold text-turquoise-700 underline underline-offset-4">Banggai Travel</a> atau lihat panduan <a href="/id/banggai-trip/" class="font-semibold text-turquoise-700 underline underline-offset-4">Banggai Trip & Banggai Tour</a>.</p>
      </div>
    </section>
    <section class="bg-sand-50 py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
        <h2 class="font-serif text-3xl md:text-5xl text-ocean-900 mb-10">Destinasi yang Bisa Masuk Rute</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4">
          {['Luwuk','Salakan','Peleng','Paisu Pok','Pulo Dua'].map((item, i) => (
            <article class="rounded-2xl bg-white border border-sand-200 p-6">
              <span class="text-xs font-bold text-turquoise-700">0{i+1}</span>
              <h3 class="font-serif text-xl text-ocean-900 mt-4 mb-2">{item}</h3>
              <p class="text-sm text-ocean-600 leading-relaxed">Destinasi yang dapat dipertimbangkan sesuai rute dan durasi keberangkatan.</p>
            </article>
          ))}
        </div>
      </div>
    </section>
    <section class="bg-white py-16 md:py-24">
      <div class="max-w-4xl mx-auto px-5 sm:px-8">
        <h2 class="font-serif text-3xl md:text-5xl text-ocean-900 mb-8">Open Trip Luwuk Banggai: Apa yang Perlu Disiapkan?</h2>
        <div class="grid md:grid-cols-2 gap-5">
          {[
            ['Tanggal perjalanan','Tentukan tanggal dan durasi yang tersedia.'],
            ['Jumlah peserta','Sampaikan jumlah orang agar opsi perjalanan dapat disesuaikan.'],
            ['Destinasi prioritas','Pilih tempat yang paling ingin dikunjungi.'],
            ['Kondisi perjalanan','Siapkan waktu fleksibel karena transportasi laut dan cuaca dapat memengaruhi rute.']
          ].map(([h,t]) => <article class="rounded-2xl bg-sand-50 border border-sand-200 p-6"><h3 class="font-serif text-2xl text-ocean-900 mb-2">{h}</h3><p class="text-sm text-ocean-600 leading-relaxed">{t}</p></article>)}
        </div>
      </div>
    </section>
    <section class="bg-sand-50 py-16 md:py-24">
      <div class="max-w-4xl mx-auto px-5 sm:px-8">
        <h2 class="font-serif text-3xl md:text-5xl text-ocean-900 mb-8">FAQ Banggai Open Trip</h2>
        <div class="space-y-3">
          {[
            ['Apakah Banggai Open Trip tersedia setiap hari?','Tidak selalu. Keberangkatan mengikuti jadwal yang dibuka dan ketersediaan peserta. Hubungi kami untuk jadwal terbaru.'],
            ['Apakah bisa ikut Open Trip Banggai sendirian?','Bisa. Format open trip memang memungkinkan wisatawan bergabung tanpa harus membawa kelompok sendiri, jika keberangkatan tersedia.'],
            ['Apakah rute selalu sama?','Tidak. Rute dapat berbeda berdasarkan durasi, jadwal transportasi, cuaca, dan kondisi destinasi.'],
            ['Apakah bisa meminta private trip?','Bisa. Jika tidak ada jadwal open trip yang sesuai, perjalanan privat atau custom itinerary dapat menjadi alternatif.'],
            ['Dari mana perjalanan dimulai?','Banyak itinerary dimulai dari Luwuk sebelum dilanjutkan ke destinasi di Kepulauan Banggai.']
          ].map(([q,a]) => <details class="rounded-2xl bg-white border border-sand-200 px-5 py-4"><summary class="cursor-pointer list-none font-semibold text-ocean-900">{q}</summary><p class="pt-3 text-sm text-ocean-600 leading-relaxed">{a}</p></details>)}
        </div>
      </div>
    </section>
    <section class="bg-white py-12 md:py-16 border-t border-sand-200">
      <div class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-12">
        <p class="text-turquoise-600 text-xs font-bold tracking-[0.22em] uppercase mb-4">Banggai Travel Cluster</p>
        <div class="grid md:grid-cols-2 gap-5">
          <a href="/id/banggai-travel/" class="rounded-2xl border border-sand-200 bg-sand-50 p-6 group">
            <p class="text-xs font-semibold text-turquoise-700 mb-2">Hub utama</p>
            <h2 class="font-serif text-2xl text-ocean-900 mb-2 group-hover:text-turquoise-700">Banggai Travel</h2>
            <p class="text-sm text-ocean-600 leading-relaxed">Temukan gambaran layanan perjalanan, private trip, custom tour, dan rute ke Kepulauan Banggai.</p>
          </a>
          <a href="/id/banggai-trip/" class="rounded-2xl border border-sand-200 bg-sand-50 p-6 group">
            <p class="text-xs font-semibold text-turquoise-700 mb-2">Panduan trip</p>
            <h2 class="font-serif text-2xl text-ocean-900 mb-2 group-hover:text-turquoise-700">Banggai Trip & Banggai Tour</h2>
            <p class="text-sm text-ocean-600 leading-relaxed">Pelajari pilihan durasi, rute dari Luwuk, destinasi, dan cara menyusun itinerary Banggai.</p>
          </a>
        </div>
      </div>
    </section>

    <section class="bg-ocean-900 text-white py-20">
      <div class="max-w-3xl mx-auto px-5 text-center">
        <h2 class="font-serif text-4xl md:text-6xl mb-5">Cari Open Trip Banggai?</h2>
        <p class="text-white/70 leading-relaxed mb-8">Kirim tanggal, jumlah peserta, dan destinasi yang Anda inginkan untuk mengecek opsi perjalanan yang tersedia.</p>
        <a href="https://wa.me/6285820830530" target="_blank" rel="noopener noreferrer" class="inline-flex rounded-full bg-white text-ocean-900 px-7 py-3.5 text-sm font-semibold">Cek Jadwal via WhatsApp →</a>
      </div>
    </section>
  </div>
  <WhatsAppButton />
</BaseLayout>