---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { languages, useTranslations } from '../../utils/i18n';

// All About Us images are shared by every language version.
// Upload images to: src/assets/about/
const aboutImages = Object.entries(
  import.meta.glob('../../assets/about/*', {
    eager: true,
    import: 'default',
    query: '?url'
  })
)
  .filter(([path]) => /\.(jpe?g|png|webp|gif|svg)$/i.test(path))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, image]) => image as string);

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as any);

const breadcrumbItems = [
  { name: 'Home', url: `/${lang}/` },
  { name: t('nav.about'), url: `/${lang}/about/` }
];
---

<BaseLayout 
  title={`${t('nav.about')} | Banggai Wonderland`}
  description={t('about.story.p1')}
>
  <!-- Hero Section -->
  <section class="relative h-[40vh] min-h-[300px] flex items-center justify-center pt-20">
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 bg-gradient-to-r from-ocean-800 to-ocean-600 opacity-90"></div>
    </div>
    
    <div class="relative z-10 text-center px-4">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-bold text-white mb-4">
        {t('about.title')}
      </h1>
      <p class="text-ocean-100 text-lg md:text-xl font-medium tracking-wide">
        {t('about.subtitle')}
      </p>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-16 md:py-24 bg-sand-50 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="mb-12">
        <Breadcrumb items={breadcrumbItems} />
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <!-- Story -->
        <div class="order-2 lg:order-1">
          <h2 class="font-serif text-3xl md:text-4xl font-bold text-ocean-900 mb-6">
            {t('about.story.title')}
          </h2>
          <div class="space-y-6 text-ocean-700 text-lg leading-relaxed">
            <p>{t('about.story.p1')}</p>
            <p>{t('about.story.p2')}</p>
          </div>
          
          <div class="mt-12">
            <h3 class="font-serif text-2xl font-bold text-ocean-900 mb-6">
              {t('about.why.title')}
            </h3>
            <ul class="space-y-4">
              <li class="flex items-start">
                <div class="bg-turquoise-100 p-1.5 rounded-full mr-4 mt-1">
                  <svg class="w-5 h-5 text-turquoise-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <span class="text-ocean-800 font-medium text-lg">{t('about.why.1')}</span>
              </li>
              <li class="flex items-start">
                <div class="bg-turquoise-100 p-1.5 rounded-full mr-4 mt-1">
                  <svg class="w-5 h-5 text-turquoise-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <span class="text-ocean-800 font-medium text-lg">{t('about.why.2')}</span>
              </li>
              <li class="flex items-start">
                <div class="bg-turquoise-100 p-1.5 rounded-full mr-4 mt-1">
                  <svg class="w-5 h-5 text-turquoise-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <span class="text-ocean-800 font-medium text-lg">{t('about.why.3')}</span>
              </li>
            </ul>
          </div>
        </div>
        
        <!-- About Us Image Slider -->
        <div class="order-1 lg:order-2 relative">
          <div class="absolute inset-0 bg-ocean-100 rounded-[2rem] transform rotate-3"></div>
          <div class="relative rounded-[2rem] shadow-xl overflow-hidden border border-sand-200 bg-white transform -rotate-2 hover:rotate-0 transition-transform duration-500">
            {aboutImages.length > 0 ? (
              <div id="about-slider" class="relative aspect-[4/3] w-full bg-ocean-50 group">
                {aboutImages.map((image, index) => (
                  <div
                    class={`about-slide absolute inset-0 transition-opacity duration-700 ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
                    data-slide={index}
                  >
                    <img
                      src={image}
                      alt={`${t('about.title')} - Banggai Wonderland ${index + 1}`}
                      class="w-full h-full object-cover"
                      loading={index === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                      data-image-index={index}
                    />
                  </div>
                ))}

                {aboutImages.length > 1 && (
                  <>
                    <button type="button" class="about-prev absolute left-4 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-black/35 hover:bg-black/55 text-white backdrop-blur-sm flex items-center justify-center transition" aria-label="Previous image">
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                    </button>
                    <button type="button" class="about-next absolute right-4 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-black/35 hover:bg-black/55 text-white backdrop-blur-sm flex items-center justify-center transition" aria-label="Next image">
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    </button>

                    <div class="absolute bottom-4 left-1/2 -translate-x-1/2 z-20 flex gap-2" aria-label="Image navigation">
                      {aboutImages.map((_, index) => (
                        <button
                          type="button"
                          class={`about-dot w-2.5 h-2.5 rounded-full transition-all ${index === 0 ? 'bg-white scale-110' : 'bg-white/50 hover:bg-white/80'}`}
                          data-dot={index}
                          aria-label={`Go to image ${index + 1}`}
                        ></button>
                      ))}
                    </div>
                  </>
                )}
              </div>
            ) : (
              <div class="aspect-[4/3] w-full bg-ocean-50 flex items-center justify-center text-ocean-300 font-medium flex-col p-8 text-center">
                <svg class="w-16 h-16 mb-4 text-turquoise-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                <span>Upload About Us images to <code>src/assets/about/</code></span>
              </div>
            )}
          </div>
        </div>
      </div>
      
    </div>
  </section>

  <WhatsAppButton />
</BaseLayout>

{aboutImages.length > 1 && (
  <script is:inline>
    const slider = document.getElementById('about-slider');
    if (slider) {
      const allSlides = Array.from(slider.querySelectorAll('.about-slide'));
      const allDots = Array.from(slider.querySelectorAll('.about-dot'));
      const prev = slider.querySelector('.about-prev');
      const next = slider.querySelector('.about-next');
      const images = Array.from(slider.querySelectorAll('img'));
      let slides = allSlides;
      let dots = allDots;
      let current = 0;
      let timer;

      const hideBrokenImage = (img) => {
        const slide = img.closest('.about-slide');
        if (!slide) return;

        const originalIndex = Number(slide.dataset.slide);
        img.style.display = 'none';
        img.alt = '';
        slide.classList.remove('opacity-100', 'opacity-0', 'z-10', 'z-0');
        slide.style.display = 'none';

        const dot = slider.querySelector(`.about-dot[data-dot="${originalIndex}"]`);
        dot?.remove();

        slides = slides.filter((item) => item !== slide);
        dots = Array.from(slider.querySelectorAll('.about-dot'));

        if (slides.length === 0) {
          if (prev) prev.style.display = 'none';
          if (next) next.style.display = 'none';
          const navigation = slider.querySelector('[aria-label="Image navigation"]');
          if (navigation) navigation.style.display = 'none';
          return;
        }

        if (current >= slides.length) current = 0;
        showSlide(current);
        updateControls();
      };

      const updateControls = () => {
        const multiple = slides.length > 1;
        if (prev) prev.style.display = multiple ? '' : 'none';
        if (next) next.style.display = multiple ? '' : 'none';
        const navigation = slider.querySelector('[aria-label="Image navigation"]');
        if (navigation) navigation.style.display = multiple ? '' : 'none';
      };

      const showSlide = (index) => {
        if (!slides.length) return;
        current = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          slide.classList.toggle('opacity-100', i === current);
          slide.classList.toggle('opacity-0', i !== current);
          slide.classList.toggle('z-10', i === current);
          slide.classList.toggle('z-0', i !== current);
        });
        dots.forEach((dot, i) => {
          dot.classList.toggle('bg-white', i === current);
          dot.classList.toggle('scale-110', i === current);
          dot.classList.toggle('bg-white/50', i !== current);
        });
      };

      const restart = () => {
        clearInterval(timer);
        if (slides.length > 1) {
          timer = setInterval(() => showSlide(current + 1), 5000);
        }
      };

      images.forEach((img) => {
        img.addEventListener('error', () => hideBrokenImage(img), { once: true });
      });

      allDots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const target = slides.findIndex((slide) => Number(slide.dataset.slide) === Number(dot.dataset.dot));
          if (target >= 0) {
            showSlide(target);
            restart();
          }
        });
      });

      prev?.addEventListener('click', () => { showSlide(current - 1); restart(); });
      next?.addEventListener('click', () => { showSlide(current + 1); restart(); });
      slider.addEventListener('mouseenter', () => clearInterval(timer));
      slider.addEventListener('mouseleave', restart);

      updateControls();
      images.forEach((img) => {
        if (img.complete && img.naturalWidth === 0) hideBrokenImage(img);
      });
      showSlide(0);
      restart();
    }
  </script>
)}
