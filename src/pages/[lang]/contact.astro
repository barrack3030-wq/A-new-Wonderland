---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { languages, useTranslations } from '../../utils/i18n';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as any);

const breadcrumbItems = [
  { name: 'Home', url: `/${lang}/` },
  { name: t('nav.contact'), url: `/${lang}/contact/` }
];
---

<BaseLayout 
  title={`${t('nav.contact')} | Banggai Wonderland`}
  description={t('contact.subtitle')}
>
  <!-- Hero Section -->
  <section class="relative h-[30vh] min-h-[250px] flex items-center justify-center pt-20">
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 bg-gradient-to-r from-ocean-800 to-ocean-600 opacity-90"></div>
    </div>
    
    <div class="relative z-10 text-center px-4">
      <h1 class="text-4xl md:text-5xl font-serif font-bold text-white mb-4">
        {t('contact.title')}
      </h1>
      <p class="text-ocean-100 text-lg font-medium tracking-wide">
        {t('contact.subtitle')}
      </p>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-16 md:py-24 bg-sand-50 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="mb-12">
        <Breadcrumb items={breadcrumbItems} />
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        
        <!-- Contact Info -->
        <div class="space-y-8">
          
          <div class="bg-white p-8 rounded-3xl shadow-sm border border-sand-200 flex items-start">
            <div class="bg-ocean-50 p-4 rounded-2xl mr-6">
              <svg class="w-8 h-8 text-turquoise-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            </div>
            <div>
              <h3 class="font-serif text-xl font-bold text-ocean-900 mb-2">{t('contact.address')}</h3>
              <p class="text-ocean-600 leading-relaxed">{t('contact.address.val')}</p>
            </div>
          </div>
          
          <div class="bg-white p-8 rounded-3xl shadow-sm border border-sand-200 flex items-start">
            <div class="bg-ocean-50 p-4 rounded-2xl mr-6">
              <svg class="w-8 h-8 text-turquoise-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <div>
              <h3 class="font-serif text-xl font-bold text-ocean-900 mb-2">{t('contact.email')}</h3>
              <a href="mailto:hello@banggaiwonderland.com" class="text-ocean-600 hover:text-turquoise-600 font-medium transition-colors">hello@banggaiwonderland.com</a>
            </div>
          </div>
          
          <div class="bg-white p-8 rounded-3xl shadow-sm border border-sand-200 flex items-start">
            <div class="bg-ocean-50 p-4 rounded-2xl mr-6">
              <svg class="w-8 h-8 text-turquoise-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            </div>
            <div>
              <h3 class="font-serif text-xl font-bold text-ocean-900 mb-2">{t('contact.phone')}</h3>
              <a href="https://wa.me/6285820830530" target="_blank" rel="noopener noreferrer" class="text-ocean-600 hover:text-turquoise-600 font-medium transition-colors">+62 858-2083-0530</a>
            </div>
          </div>

        </div>
        
        <!-- Contact Form (UI Mockup leading to mailto) -->
        <div class="bg-white p-8 md:p-10 rounded-3xl shadow-xl border border-sand-200">
          <form class="space-y-6" onsubmit="event.preventDefault(); window.location.href='mailto:hello@banggaiwonderland.com?subject=Inquiry&body=Name: '+document.getElementById('name').value+'%0A%0AMessage: '+document.getElementById('message').value;">
            
            <div>
              <label for="name" class="block text-sm font-bold text-ocean-900 mb-2">{t('contact.form.name')}</label>
              <input type="text" id="name" required class="w-full px-5 py-3 rounded-xl border border-sand-300 focus:ring-2 focus:ring-turquoise-500 focus:border-turquoise-500 outline-none transition-all bg-sand-50/50" placeholder="John Doe">
            </div>
            
            <div>
              <label for="email" class="block text-sm font-bold text-ocean-900 mb-2">{t('contact.form.email')}</label>
              <input type="email" id="email" required class="w-full px-5 py-3 rounded-xl border border-sand-300 focus:ring-2 focus:ring-turquoise-500 focus:border-turquoise-500 outline-none transition-all bg-sand-50/50" placeholder="john@example.com">
            </div>
            
            <div>
              <label for="message" class="block text-sm font-bold text-ocean-900 mb-2">{t('contact.form.message')}</label>
              <textarea id="message" rows="5" required class="w-full px-5 py-3 rounded-xl border border-sand-300 focus:ring-2 focus:ring-turquoise-500 focus:border-turquoise-500 outline-none transition-all bg-sand-50/50" placeholder="..."></textarea>
            </div>
            
            <button type="submit" class="w-full bg-ocean-800 text-white font-bold text-lg py-4 rounded-xl hover:bg-ocean-700 transition-colors shadow-lg flex justify-center items-center">
              {t('contact.form.send')}
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
            </button>
            
          </form>
        </div>
        
      </div>
    </div>
  </section>

  <WhatsAppButton />
</BaseLayout>
