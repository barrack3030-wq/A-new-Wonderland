---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { languages, useTranslations } from '../../utils/i18n';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as any);

const breadcrumbItems = [
  { name: 'Home', url: `/${lang}/` },
  { name: t('btn.book') || 'Booking', url: `/${lang}/book/` }
];

// Fetch packages for the dropdown
const allPackages = await getCollection('packages');
const packages = allPackages.filter(p => p.id.startsWith(`${lang}/`));
---

<BaseLayout 
  title={`${t('book.title') || 'Booking Form'} | Banggai Wonderland`}
  description={t('book.subtitle')}
>
  <!-- Hero Section -->
  <section class="relative h-[25vh] min-h-[200px] flex items-center justify-center pt-20">
    <div class="absolute inset-0 z-0 bg-ocean-800"></div>
    <div class="relative z-10 text-center px-4">
      <h1 class="text-3xl md:text-5xl font-serif font-bold text-white mb-4">
        {t('book.title') || 'Booking Form'}
      </h1>
      <p class="text-ocean-100 text-lg font-medium tracking-wide">
        {t('book.subtitle') || 'Plan your adventure with us'}
      </p>
    </div>
  </section>

  <!-- Form Section -->
  <section class="py-16 md:py-24 bg-sand-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="mb-12">
        <Breadcrumb items={breadcrumbItems} />
      </div>
      
      <div class="bg-white p-8 md:p-12 rounded-3xl shadow-xl border border-sand-200">
        
        <form id="booking-form" class="space-y-6">
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-sm font-bold text-ocean-900 mb-2">{t('book.form.name') || 'Full Name'} *</label>
              <input type="text" id="name" required class="w-full px-5 py-3 rounded-xl border border-sand-300 focus:ring-2 focus:ring-turquoise-500 focus:border-turquoise-500 outline-none transition-all bg-sand-50/50" placeholder="John Doe">
            </div>
            
            <div>
              <label for="country" class="block text-sm font-bold text-ocean-900 mb-2">Asal Negara / Country of Origin *</label>
              <input type="text" id="country" required class="w-full px-5 py-3 rounded-xl border border-sand-300 focus:ring-2 focus:ring-turquoise-500 focus:border-turquoise-500 outline-none transition-all bg-sand-50/50" placeholder="Indonesia">
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="date" class="block text-sm font-bold text-ocean-900 mb-2">Tanggal Kedatangan / Arrival Date *</label>
              <input type="date" id="date" required class="w-full px-5 py-3 rounded-xl border border-sand-300 focus:ring-2 focus:ring-turquoise-500 focus:border-turquoise-500 outline-none transition-all bg-sand-50/50">
            </div>
            
            <div>
              <label for="participants" class="block text-sm font-bold text-ocean-900 mb-2">Jumlah Orang / Number of People *</label>
              <input type="number" id="participants" min="1" required class="w-full px-5 py-3 rounded-xl border border-sand-300 focus:ring-2 focus:ring-turquoise-500 focus:border-turquoise-500 outline-none transition-all bg-sand-50/50" placeholder="2">
            </div>
          </div>
          
          <div class="grid grid-cols-1 gap-6">
            <div>
              <label for="package" class="block text-sm font-bold text-ocean-900 mb-2">Pilihan Paket / Package Choice *</label>
              <select id="package" required class="w-full px-5 py-3 rounded-xl border border-sand-300 focus:ring-2 focus:ring-turquoise-500 focus:border-turquoise-500 outline-none transition-all bg-sand-50/50">
                <option value="" disabled selected>-- Select Package --</option>
                {packages.map(pkg => (
                  <option value={pkg.data.title}>{pkg.data.title}</option>
                ))}
                <option value="Custom">{t('book.package.custom') || 'Custom Package / Other'}</option>
              </select>
            </div>
          </div>
          
          <div>
            <label for="notes" class="block text-sm font-bold text-ocean-900 mb-2">{t('book.form.notes') || 'Additional Notes'}</label>
            <textarea id="notes" rows="4" class="w-full px-5 py-3 rounded-xl border border-sand-300 focus:ring-2 focus:ring-turquoise-500 focus:border-turquoise-500 outline-none transition-all bg-sand-50/50" placeholder="..."></textarea>
          </div>
          
          <button type="submit" class="w-full bg-green-500 text-white font-bold text-lg py-4 rounded-xl hover:bg-green-600 transition-colors shadow-lg flex justify-center items-center mt-4">
            <svg class="w-6 h-6 mr-3" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.489-1.761-1.663-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            {t('book.form.submit') || 'Book via WhatsApp'}
          </button>
          
        </form>

      </div>
    </div>
  </section>

  <WhatsAppButton />

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Pre-select package from URL if present
      const urlParams = new URLSearchParams(window.location.search);
      const preselectedPackage = urlParams.get('package');
      const packageSelect = document.getElementById('package') as HTMLSelectElement;
      
      if (preselectedPackage && packageSelect) {
        // Try to find matching option
        for (let i = 0; i < packageSelect.options.length; i++) {
          if (packageSelect.options[i].value === preselectedPackage) {
            packageSelect.selectedIndex = i;
            break;
          }
        }
      }

      const form = document.getElementById('booking-form');
      
      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          
          const name = (document.getElementById('name') as HTMLInputElement).value;
          const country = (document.getElementById('country') as HTMLInputElement).value;
          const date = (document.getElementById('date') as HTMLInputElement).value;
          const participants = (document.getElementById('participants') as HTMLInputElement).value;
          const packageSelected = (document.getElementById('package') as HTMLSelectElement).value;
          const notes = (document.getElementById('notes') as HTMLTextAreaElement).value;
          
          const waNumber = '6285820830530'; // Admin WhatsApp number
          
          let message = `*Halo Banggai Wonderland!* 👋\nSaya ingin memesan paket wisata.\n\n`;
          message += `*Detail Pesanan:*\n`;
          message += `- Nama: ${name}\n`;
          message += `- Asal Negara: ${country}\n`;
          message += `- Tanggal Kedatangan: ${date}\n`;
          message += `- Jumlah Orang: ${participants} Orang\n`;
          message += `- Pilihan Paket: *${packageSelected}*\n`;
          
          if (notes) {
            message += `\n*Catatan Tambahan:*\n${notes}\n`;
          }
          
          const encodedMessage = encodeURIComponent(message);
          const waUrl = `https://wa.me/${waNumber}?text=${encodedMessage}`;
          
          window.open(waUrl, '_blank');
        });
      }
    });
  </script>
</BaseLayout>
