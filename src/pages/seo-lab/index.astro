    priority: 'Primary',
    share: '50%',
    focus: 'Beyond Bali, diving, remote islands, adventure travel',
    keywords: [
      'where to go after Bali',
      'best destinations beyond Bali',
      'Bali alternatives',
      'where to go after Lombok',
      'Banggai Islands Indonesia',
      'Banggai Islands travel guide',
      'Banggai Islands diving',
      'Banggai Islands snorkeling',
      'Banggai Islands island hopping',
      'Paisu Pok Lake Indonesia'
    ]
  },
  {
    name: 'Malaysia',
    priority: 'Secondary',
    share: '35%',
    focus: 'Regional travel, private trips, island escapes',
    keywords: [
      'Banggai Islands Indonesia',
      'Banggai Islands tour',
      'pulau Banggai Indonesia',
      'Kepulauan Banggai',
      'percutian ke Banggai',
      'pulau tersembunyi Indonesia',
      'pulau cantik Indonesia',
      'snorkeling Banggai',
