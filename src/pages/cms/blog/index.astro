---
const title = 'Banggai Wonderland Blog CMS';
---
<!doctype html>
<html lang="id">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<meta name="robots" content="noindex,nofollow"/>
<title>{title}</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde@2.18.0/dist/easymde.min.css"/>
<style>
:root{color-scheme:dark;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;background:linear-gradient(145deg,#061525,#0b2b46 55%,#071a2a);color:#eef7ff}
.wrap{width:min(1180px,94%);margin:0 auto;padding:34px 0 60px}
.brand{margin-bottom:24px}
.brand h1{margin:0;font-size:clamp(28px,5vw,42px);letter-spacing:-.03em}
.brand p{color:#9fc0d6;margin:8px 0 0}
.back{display:inline-flex;margin-top:12px;color:#65c8f2;text-decoration:none;font-size:13px;font-weight:700}
.card{background:rgba(8,24,39,.88);border:1px solid rgba(157,207,235,.16);border-radius:20px;padding:24px;box-shadow:0 20px 70px rgba(0,0,0,.28);margin-bottom:18px}
label{display:block;font-size:13px;font-weight:700;color:#b8d5e7;margin:0 0 8px}
input,select{width:100%;border:1px solid #28465c;background:#071b2b;color:#f5fbff;border-radius:12px;padding:13px 14px;outline:none;font:inherit}
input:focus,select:focus{border-color:#56b8ea;box-shadow:0 0 0 3px rgba(86,184,234,.12)}
.grid{display:grid;grid-template-columns:2fr 1fr;gap:14px}
.seo-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.image-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}
button{border:0;border-radius:12px;padding:12px 18px;font-weight:800;cursor:pointer;color:#03121d;background:#65c8f2;touch-action:manipulation}
button.secondary{background:#17364d;color:#dceffc}
button:disabled{opacity:.5;cursor:not-allowed}
.status{margin-top:12px;min-height:22px;color:#9fc0d6;white-space:pre-wrap}
.danger{color:#ffb2b2}.success{color:#9ce7b4}.muted{color:#86a7bb;font-size:13px}
.divider{border-top:1px solid rgba(157,207,235,.12);margin:22px 0}
.path{display:none;margin-top:10px;padding:10px 12px;border-radius:10px;background:#0b2437;color:#bfe4f7;font-size:12px;word-break:break-all}
.preview{margin-top:12px;display:none}
.preview.show{display:block}
.preview img{width:100%;max-height:320px;object-fit:cover;border-radius:14px;border:1px solid #28465c}
.EasyMDEContainer{margin-top:8px}
.EasyMDEContainer .CodeMirror{min-height:520px;background:#071b2b;color:#f5fbff;border-color:#28465c;border-radius:0 0 12px 12px}
.EasyMDEContainer .editor-toolbar{background:#0a2335;border-color:#28465c}
.EasyMDEContainer .editor-toolbar button{color:#dceffc;background:transparent;border-radius:7px}
.EasyMDEContainer .editor-toolbar button:hover{background:#17364d}
.EasyMDEContainer .editor-toolbar button.active{background:#214962}
.editor-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}
.hint{padding:12px 14px;border:1px solid rgba(86,184,234,.16);border-radius:12px;background:#091f31;color:#a9c8da;font-size:12px;line-height:1.6;margin-top:12px}
@media(max-width:800px){.grid,.seo-grid,.image-grid{grid-template-columns:1fr}.card{padding:18px}}
</style>
</head>
<body>
<main class="wrap">
<header class="brand">
<h1>Banggai Wonderland Blog CMS</h1>
<p>Edit Blog only — separate from the main CMS.</p>
<a class="back" href="/cms/">← Back to Main CMS</a>
</header>

<section class="card">
<h2 style="margin-top:0">Blog Editor</h2>
<div style="margin-bottom:16px"><label for="accessKey">CMS access key</label><input id="accessKey" type="password" autocomplete="off" placeholder="Masukkan CMS access key"/></div>
<div class="grid">
  <div>
    <label for="language">Language</label>
    <select id="language">
      <option value="id">Bahasa Indonesia</option>
      <option value="en">English</option>
      <option value="es">Spanish</option>
      <option value="fr">French</option>
      <option value="zh">Chinese</option>
    </select>
  </div>
  <div>
    <label for="blog">Blog</label>
    <select id="blog"><option value="">Load Blog terlebih dahulu</option></select>
  </div>
</div>

<div class="row">
  <button id="loadBlogs" type="button" class="secondary">Load Blog</button>
  <button id="openBlog" type="button" disabled>Open Selected Blog</button>
</div>

<div id="path" class="path"></div>

<div class="grid" style="margin-top:16px">
  <div><label for="title">Judul</label><input id="title" type="text"/></div>
  <div><label for="pubDate">Tanggal publish</label><input id="pubDate" type="date"/></div>
</div>

<div style="margin-top:14px"><label for="description">Description / Excerpt</label><input id="description" type="text"/></div>

<div class="seo-grid" style="margin-top:14px">
  <div><label for="seoTitle">SEO Title</label><input id="seoTitle" type="text"/></div>
  <div><label for="seoDescription">SEO Description</label><input id="seoDescription" type="text"/></div>
</div>

<div style="margin-top:14px"><label for="tags">Tags <span class="muted">(pisahkan dengan koma)</span></label><input id="tags" type="text"/></div>

<div class="divider"></div>
<h3 style="margin-top:0">Featured Image</h3>
<div class="image-grid">
  <div><label for="imageFile">Upload gambar baru</label><input id="imageFile" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml"/></div>
  <div><label for="imageUrl">Path / URL gambar</label><input id="imageUrl" type="text" placeholder="/images/blog/example.webp"/></div>
</div>
<div style="margin-top:14px"><label for="imageAlt">Image Alt</label><input id="imageAlt" type="text"/></div>
<div class="row"><button id="uploadFeatured" type="button" class="secondary">Upload & Set Featured Image</button></div>
<div id="imageStatus" class="status"></div>
<div id="imagePreview" class="preview"><img id="imagePreviewImg" alt="Featured image"/></div>

<div class="divider"></div>
<h3 style="margin-top:0">Article Content</h3>
<div class="hint">
Gunakan toolbar untuk heading, bold, italic, Small/Large text, link, list, quote, tabel, gambar di posisi cursor, YouTube link, preview, side-by-side, dan fullscreen.
</div>
<textarea id="content" placeholder="Isi artikel dalam Markdown..."></textarea>
<input id="inlineImageFile" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml" style="display:none"/>
<div id="contentStatus" class="status"></div>

<div class="editor-actions">
  <button id="save" type="button" disabled>Save Blog Changes</button>
  <button id="reset" type="button" class="secondary">Reset</button>
</div>
<div id="saveStatus" class="status"></div>
</section>
</main>

<script src="https://cdn.jsdelivr.net/npm/easymde@2.18.0/dist/easymde.min.js"></script>
<script>
const ENDPOINT='https://script.google.com/macros/s/AKfycbxGMuyFzq0K-gKIPaamp1ClFqo6zYJfNNvZfd0hxeJIJTj0N_DVPywUtkWbo5g0_F08/exec';
const langEl=document.getElementById('language');
const blogEl=document.getElementById('blog');
const loadEl=document.getElementById('loadBlogs');
const openEl=document.getElementById('openBlog');
const resetEl=document.getElementById('reset');
const pathEl=document.getElementById('path');
const titleEl=document.getElementById('title');
const dateEl=document.getElementById('pubDate');
const descEl=document.getElementById('description');
const seoTitleEl=document.getElementById('seoTitle');
const seoDescEl=document.getElementById('seoDescription');
const tagsEl=document.getElementById('tags');
const imageFileEl=document.getElementById('imageFile');
const imageUrlEl=document.getElementById('imageUrl');
const imageAltEl=document.getElementById('imageAlt');
const imageStatusEl=document.getElementById('imageStatus');
const imagePreview=document.getElementById('imagePreview');
const imagePreviewImg=document.getElementById('imagePreviewImg');
const inlineImageFileEl=document.getElementById('inlineImageFile');
const contentStatusEl=document.getElementById('contentStatus');
const saveEl=document.getElementById('save');
const saveStatusEl=document.getElementById('saveStatus');
let currentPath='';

function setStatus(el,text,kind){
  el.className='status'+(kind==='danger'?' danger':kind==='success'?' success':'');
  el.textContent=text||'';
}
function tagArray(v){return String(v||'').split(',').map(function(x){return x.trim();}).filter(Boolean);}
function setFeatured(url,alt){
  imageUrlEl.value=url||'';
  imageAltEl.value=alt||imageAltEl.value||'';
  if(url){imagePreviewImg.src=url;imagePreviewImg.alt=alt||'Featured image';imagePreview.classList.add('show');}
}
function insertText(text){
  editor.codemirror.replaceSelection(text);
  editor.codemirror.focus();
}
function wrapSelection(before,after,placeholder){
  const cm=editor.codemirror;
  const selected=cm.getSelection();
  cm.replaceSelection(before+(selected||placeholder||'text')+(after||''));
  cm.focus();
}
function insertYouTube(){
  const url=window.prompt('Masukkan URL YouTube:','https://www.youtube.com/watch?v=');
  if(url&&/^https?:\/\/(www\.)?(youtube\.com|youtu\.be)\//i.test(url)){
    insertText('[Watch video on YouTube]('+url+')\n\n');
    setStatus(contentStatusEl,'✓ Link YouTube disisipkan ke posisi cursor.','success');
  }
}
const editor=new EasyMDE({
  element:document.getElementById('content'),
  spellChecker:false,
  autosave:{enabled:false},
  renderingConfig:{singleLineBreaks:false,sanitized:true},
  toolbar:[
    'bold','italic','heading',
    {name:'small-text',action:function(){wrapSelection('<small>','</small>','small text');},className:'fa fa-minus',title:'Small text'},
    {name:'large-text',action:function(){wrapSelection('<span style="font-size:1.15em">','</span>','large text');},className:'fa fa-plus',title:'Large text'},
    'quote','unordered-list','ordered-list','link',
    {name:'youtube',action:function(){insertYouTube();},className:'fa fa-youtube-play',title:'Insert YouTube link'},
    {name:'upload-image',action:function(){inlineImageFileEl.click();},className:'fa fa-picture-o',title:'Upload and insert image'},
    'table','horizontal-rule','preview','side-by-side','fullscreen','guide'
  ]
});

async function post(payload){
  const url=ENDPOINT+(ENDPOINT.indexOf('?')>=0?'&':'?')+'_blogcms='+Date.now();
  const response=await fetch(url,{method:'POST',headers:{'Content-Type':'text/plain;charset=utf-8','Accept':'application/json,text/plain,*/*'},body:JSON.stringify(payload),cache:'no-store',redirect:'follow'});
  const raw=await response.text();
  let data;
  try{data=JSON.parse(raw);}catch(e){throw new Error('Apps Script tidak mengembalikan JSON (HTTP '+response.status+').');}
  if(!data.ok)throw new Error(data.error||'CMS request gagal');
  return data;
}
function renderBlogs(blogs){
  blogEl.innerHTML='<option value="">Pilih artikel...</option>'+blogs.map(function(b){
    const safePath=String(b.path).replace(/"/g,'&quot;');
    const safeTitle=String(b.title).replace(/[&<>]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;'}[c];});
    return '<option value="'+safePath+'">'+safeTitle+'</option>';
  }).join('');
  openEl.disabled=true;
}
async function githubGetJson(url){
  const response=await fetch(url,{method:'GET',headers:{Accept:'application/vnd.github+json'},cache:'no-store'});
  if(!response.ok)throw new Error('GitHub API HTTP '+response.status);
  return response.json();
}
function parseFrontmatterClient(raw){
  const text=String(raw||'').replace(/\r\n?/g,'\n');
  let fm='',body=text;
  if(text.indexOf('---\n')===0){
    const end=text.indexOf('\n---',4);
    if(end!==-1){fm=text.substring(4,end);body=text.substring(end+4).replace(/^\n+/,'');}
  }
  const data={tags:[]};let tags=false;
  fm.split('\n').forEach(function(line){
    if(/^tags:\s*$/.test(line.trim())){tags=true;return;}
    if(tags&&/^\s+-\s+/.test(line)){data.tags.push(line.replace(/^\s+-\s+/,'').replace(/^["']|["']$/g,''));return;}
    if(tags&&line.trim()&&!/^\s+-\s+/.test(line))tags=false;
    const m=line.match(/^([A-Za-z][A-Za-z0-9_]*)\s*:\s*(.*)$/);
    if(m){
      let v=m[2].trim();
      if((v.startsWith('"')&&v.endsWith('"'))||(v.startsWith("'")&&v.endsWith("'")))v=v.slice(1,-1).replace(/\\("|\\)/g,'$1');
      data[m[1]]=v;
    }
  });
  return{
    title:data.title||'',
    description:data.description||'',
    seoTitle:data.seoTitle||'',
    seoDescription:data.seoDescription||'',
    image:data.image||'',
    imageAlt:data.imageAlt||'',
    pubDate:/^\d{4}-\d{2}-\d{2}$/.test(String(data.pubDate||''))?data.pubDate:'',
    tags:data.tags||[],
    translationKey:data.translationKey||'',
    content:body.trim()
  };
}
async function fallbackListBlogs(){
  const lang=langEl.value;
  const url='https://api.github.com/repos/barrack3030-wq/A-new-Wonderland/contents/src/content/blog/'+encodeURIComponent(lang)+'?ref=main';
  const items=await githubGetJson(url);
  if(!Array.isArray(items))throw new Error('Folder blog tidak dapat dibaca dari GitHub.');
  return items.filter(function(item){return item.type==='file'&&/\.md$/i.test(item.name);}).map(function(item){
    return {language:lang,path:item.path,name:item.name,title:item.name.replace(/\.md$/,'').replace(/^\d{4}-\d{2}-\d{2}-/,'').replace(/-/g,' '),sha:item.sha};
  }).sort(function(a,b){return String(b.name).localeCompare(String(a.name));});
}
async function loadBlogs(){
  const key=document.getElementById('accessKey').value.trim();
  if(!key){setStatus(saveStatusEl,'Masukkan CMS access key di bagian CMS utama terlebih dahulu.','danger');return;}
  loadEl.disabled=true;
  setStatus(saveStatusEl,'Memuat daftar blog...');
  try{
    const data=await post({action:'listBlogs',accessKey:key,language:langEl.value});
    renderBlogs(data.blogs||[]);
    setStatus(saveStatusEl,'✓ '+((data.blogs||[]).length)+' artikel ditemukan.','success');
  }catch(e){
    const msg=String(e&&e.message||e);
    if(/Action tidak dikenal|listBlogs/i.test(msg)){
      try{
        const blogs=await fallbackListBlogs();
        renderBlogs(blogs);
        setStatus(saveStatusEl,'✓ '+blogs.length+' artikel ditemukan dari GitHub. Mode fallback aktif.','success');
      }catch(fallbackError){
        setStatus(saveStatusEl,'✕ Gagal memuat blog. Apps Script tidak mengenal listBlogs dan GitHub fallback juga gagal: '+fallbackError.message,'danger');
      }
    }else{
      setStatus(saveStatusEl,'✕ '+msg,'danger');
    }
  }finally{loadEl.disabled=false;}
}
function resetEditor(){
  [titleEl,dateEl,descEl,seoTitleEl,seoDescEl,tagsEl,imageUrlEl,imageAltEl].forEach(function(el){el.value='';});
  editor.value('');
  currentPath='';pathEl.style.display='none';pathEl.textContent='';
  imagePreview.classList.remove('show');blogEl.value='';openEl.disabled=true;saveEl.disabled=true;
  setStatus(imageStatusEl,'');setStatus(contentStatusEl,'');setStatus(saveStatusEl,'');
}
loadEl.addEventListener('click',loadBlogs);
langEl.addEventListener('change',loadBlogs);
blogEl.addEventListener('change',function(){openEl.disabled=!blogEl.value;});
openEl.addEventListener('click',async function(){
  const key=document.getElementById('accessKey').value.trim(),path=blogEl.value;
  if(!key){setStatus(saveStatusEl,'Masukkan CMS access key di bagian CMS utama terlebih dahulu.','danger');return;}
  if(!path){setStatus(saveStatusEl,'Pilih artikel terlebih dahulu.','danger');return;}
  openEl.disabled=true;setStatus(saveStatusEl,'Membuka artikel...');
  try{
    const data=await post({action:'getBlog',accessKey:key,path:path});
    const b=data.blog||{};
    currentPath=b.path||path;
    pathEl.style.display='block';pathEl.textContent='File: '+currentPath;
    titleEl.value=b.title||'';dateEl.value=b.pubDate||'';descEl.value=b.description||'';
    seoTitleEl.value=b.seoTitle||'';seoDescEl.value=b.seoDescription||'';tagsEl.value=(b.tags||[]).join(', ');
    setFeatured(b.image||'',b.imageAlt||b.title||'Featured image');
    editor.value(b.content||'');saveEl.disabled=false;
    setStatus(saveStatusEl,'✓ Artikel berhasil dimuat.','success');
  }catch(e){
    const msg=String(e&&e.message||e);
    if(/Action tidak dikenal|getBlog/i.test(msg)){
      try{
        const raw=await fetch('https://raw.githubusercontent.com/barrack3030-wq/A-new-Wonderland/main/'+path,{cache:'no-store'}).then(function(r){
          if(!r.ok)throw new Error('GitHub raw HTTP '+r.status);
          return r.text();
        });
        const b=parseFrontmatterClient(raw);
        b.path=path;
        currentPath=path;
        pathEl.style.display='block';pathEl.textContent='File: '+path;
        titleEl.value=b.title||'';dateEl.value=b.pubDate||'';descEl.value=b.description||'';
        seoTitleEl.value=b.seoTitle||'';seoDescEl.value=b.seoDescription||'';tagsEl.value=(b.tags||[]).join(', ');
        setFeatured(b.image||'',b.imageAlt||b.title||'Featured image');
        editor.value(b.content||'');saveEl.disabled=false;
        setStatus(saveStatusEl,'✓ Artikel berhasil dimuat dari GitHub. Mode fallback aktif.','success');
      }catch(fallbackError){
        setStatus(saveStatusEl,'✕ Gagal membuka artikel: '+fallbackError.message,'danger');
      }
    }else{
      setStatus(saveStatusEl,'✕ '+msg,'danger');
    }
  }finally{openEl.disabled=false;}
});
document.getElementById('uploadFeatured').addEventListener('click',async function(){
  const file=imageFileEl.files&&imageFileEl.files[0],key=document.getElementById('accessKey').value.trim();
  if(!key){setStatus(imageStatusEl,'Masukkan CMS access key di bagian CMS utama terlebih dahulu.','danger');return;}
  if(!file){setStatus(imageStatusEl,'Pilih gambar terlebih dahulu.','danger');return;}
  if(file.size>8*1024*1024){setStatus(imageStatusEl,'Ukuran gambar maksimal 8 MB.','danger');return;}
  this.disabled=true;setStatus(imageStatusEl,'Mengupload gambar...');
  try{
    const dataUrl=await new Promise(function(resolve,reject){const r=new FileReader();r.onload=function(){resolve(r.result);};r.onerror=function(){reject(new Error('File tidak dapat dibaca.'));};r.readAsDataURL(file);});
    const data=await post({action:'uploadImage',accessKey:key,dataUrl:dataUrl,fileName:file.name});
    if(!data.image||!data.image.url)throw new Error('Respons upload gambar tidak valid.');
    setFeatured(data.image.url,data.image.alt||titleEl.value||'Featured image');
    setStatus(imageStatusEl,'✓ Featured image siap digunakan.','success');
  }catch(e){setStatus(imageStatusEl,'✕ '+e.message,'danger');}
  finally{this.disabled=false;}
});
inlineImageFileEl.addEventListener('change',async function(){
  const file=this.files&&this.files[0],key=document.getElementById('accessKey').value.trim();
  if(!file)return;
  if(!key){setStatus(imageStatusEl,'Masukkan CMS access key di bagian CMS utama terlebih dahulu.','danger');this.value='';return;}
  if(file.size>8*1024*1024){setStatus(imageStatusEl,'Ukuran gambar maksimal 8 MB.','danger');this.value='';return;}
  setStatus(imageStatusEl,'Mengupload gambar...');
  try{
    const dataUrl=await new Promise(function(resolve,reject){const r=new FileReader();r.onload=function(){resolve(r.result);};r.onerror=function(){reject(new Error('File tidak dapat dibaca.'));};r.readAsDataURL(file);});
    const data=await post({action:'uploadImage',accessKey:key,dataUrl:dataUrl,fileName:file.name});
    if(!data.image||!data.image.url)throw new Error('Respons upload gambar tidak valid.');
    const alt=data.image.alt||titleEl.value||'Article image';
    insertText('!['+alt+']('+data.image.url+')\n\n');
    setStatus(imageStatusEl,'✓ Gambar disisipkan ke posisi cursor.','success');
  }catch(e){setStatus(imageStatusEl,'✕ '+e.message,'danger');}
  finally{this.value='';}
});
editor.codemirror.on('change',function(){
  const n=editor.value().trim().length;
  setStatus(contentStatusEl,n?n.toLocaleString('id-ID')+' karakter artikel.':'Isi artikel masih kosong.');
});
saveEl.addEventListener('click',async function(){
  const key=document.getElementById('accessKey').value.trim();
  if(!key){setStatus(saveStatusEl,'Masukkan CMS access key di bagian CMS utama terlebih dahulu.','danger');return;}
  if(!currentPath){setStatus(saveStatusEl,'Belum ada artikel yang dibuka.','danger');return;}
  if(!titleEl.value.trim()){setStatus(saveStatusEl,'Judul wajib diisi.','danger');return;}
  const content=editor.value().trim();
  if(!content){setStatus(saveStatusEl,'Isi artikel wajib diisi.','danger');return;}
  this.disabled=true;setStatus(saveStatusEl,'Menyimpan perubahan ke GitHub...');
  try{
    const data=await post({action:'updateBlog',accessKey:key,path:currentPath,article:{
      title:titleEl.value,description:descEl.value,seoTitle:seoTitleEl.value,seoDescription:seoDescEl.value,
      pubDate:dateEl.value,image:imageUrlEl.value,imageAlt:imageAltEl.value,tags:tagArray(tagsEl.value),content:content
    }});
    setStatus(saveStatusEl,'✓ '+((data.blog&&data.blog.message)||'Blog berhasil diperbarui.')+' Perubahan sudah masuk GitHub.','success');
  }catch(e){setStatus(saveStatusEl,'✕ '+e.message,'danger');}
  finally{this.disabled=false;}
});
resetEl.addEventListener('click',resetEditor);
</script>
</body>
</html>
