---
const title='Banggai Wonderland CMS';
---
<!doctype html>
<html lang="id">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<meta name="robots" content="noindex,nofollow"/>
<title>{title}</title>
<style>
:root{color-scheme:dark;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}*{box-sizing:border-box}body{margin:0;min-height:100vh;background:linear-gradient(145deg,#061525,#0b2b46 55%,#071a2a);color:#eef7ff}.wrap{width:min(1100px,94%);margin:0 auto;padding:34px 0 60px}.brand{margin-bottom:28px}.brand h1{margin:0;font-size:clamp(28px,5vw,42px);letter-spacing:-.03em}.brand p{color:#9fc0d6;margin:8px 0 0}.card{background:rgba(8,24,39,.88);border:1px solid rgba(157,207,235,.16);border-radius:20px;padding:24px;box-shadow:0 20px 70px rgba(0,0,0,.28);margin-bottom:18px}label{display:block;font-size:13px;font-weight:700;color:#b8d5e7;margin:0 0 8px}input,textarea{width:100%;border:1px solid #28465c;background:#071b2b;color:#f5fbff;border-radius:12px;padding:13px 14px;outline:none;font:inherit}input:focus,textarea:focus{border-color:#56b8ea;box-shadow:0 0 0 3px rgba(86,184,234,.12)}textarea{min-height:300px;resize:vertical;line-height:1.65}.meta-grid{display:grid;grid-template-columns:2fr 1fr;gap:14px}.seo-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.image-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}button{border:0;border-radius:12px;padding:12px 18px;font-weight:800;cursor:pointer;color:#03121d;background:#65c8f2;touch-action:manipulation}button.secondary{background:#17364d;color:#dceffc}button:disabled{opacity:.5;cursor:not-allowed}.status{margin-top:14px;color:#9fc0d6;min-height:22px;white-space:pre-wrap}.danger{color:#ffb2b2}.success{color:#9ce7b4}.muted{color:#86a7bb;font-size:13px}.divider{border-top:1px solid rgba(157,207,235,.12);margin:22px 0}.result{display:none}.result.show{display:block}.lang{border-top:1px solid rgba(157,207,235,.12);padding:18px 0}.lang:first-child{border-top:0;padding-top:0}.lang textarea{min-height:420px}.preview{margin-top:12px;display:none}.preview.show{display:block}.preview img{width:100%;max-height:280px;object-fit:cover;border-radius:14px;border:1px solid #28465c}.selected{margin-top:10px;padding:10px 12px;border-radius:10px;background:#0b2437;color:#bfe4f7;font-size:13px;word-break:break-all}.upload-ok{display:none;margin-top:12px;padding:12px 14px;border-radius:12px;border:1px solid rgba(156,231,180,.25);background:rgba(33,83,55,.25);color:#b9f2c9}.upload-ok.show{display:block}.password-wrap{position:relative}.password-wrap input{padding-right:92px}.toggle-password{position:absolute;right:6px;top:6px;height:calc(100% - 12px);padding:0 12px;border-radius:9px;background:#17364d;color:#dceffc;font-size:12px}@media(max-width:800px){.meta-grid,.seo-grid,.image-grid{grid-template-columns:1fr}.card{padding:18px}input,textarea{font-size:16px}}
</style>
</head>
<body>
<main class="wrap">
<header class="brand"><h1>Banggai Wonderland CMS</h1><p>Manual Article → AI Translation → Review → Publish</p></header>
<section class="card">
<h2 style="margin-top:0">1. Tulis artikel utama</h2>
<p class="muted">Paste artikel Bahasa Indonesia Anda. AI tidak menulis artikel ini; AI hanya menerjemahkannya ke English, Spanish, French, dan Chinese.</p>
<div class="meta-grid"><div><label for="title">Judul artikel</label><input id="title" type="text" autocomplete="off" placeholder="Contoh: Panduan Lengkap Mengunjungi Danau Paisupok"/></div><div><label for="pubDate">Tanggal publish</label><input id="pubDate" type="date"/></div></div>
<div style="margin-top:14px"><label for="description">Deskripsi / excerpt</label><input id="description" type="text" placeholder="Ringkasan singkat artikel untuk blog dan SEO"/></div>
<div class="seo-grid" style="margin-top:14px"><div><label for="seoTitle">SEO Title <span class="muted">(opsional)</span></label><input id="seoTitle" type="text" placeholder="SEO title"/></div><div><label for="seoDescription">SEO Description <span class="muted">(opsional)</span></label><input id="seoDescription" type="text" placeholder="SEO meta description"/></div></div>
<div style="margin-top:14px"><label for="tags">Tags <span class="muted">(pisahkan dengan koma)</span></label><input id="tags" type="text" placeholder="Banggai, Indonesia, Travel"/></div>
<div style="margin-top:14px"><label for="content">Artikel Bahasa Indonesia</label><textarea id="content" placeholder="Paste artikel lengkap Anda di sini...\n\nMarkdown diperbolehkan."></textarea><div id="contentStatus" class="status"></div></div>
<div class="divider"></div><h2 style="margin-top:0">2. Featured image</h2>
<div class="image-grid"><div><label for="imageFile">Upload foto</label><input id="imageFile" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml"/></div><div><label for="imageUrl">Atau gunakan link foto</label><input id="imageUrl" type="url" placeholder="https://contoh.com/foto.jpg"/></div></div>
<div class="row"><button id="uploadImage" type="button">Upload / Import Photo</button><button id="useSearchImage" type="button" class="secondary">Auto Search by Topic</button></div>
<div id="imageStatus" class="status"></div><div id="uploadOk" class="upload-ok"><strong>✓ Foto berhasil terupload</strong><span id="uploadOkText"></span></div><div id="imagePreview" class="preview"><img id="imagePreviewImg" alt="Selected featured image"/><div id="selectedImage" class="selected"></div></div>
<div style="margin-top:18px"><label for="accessKey">CMS access key</label><div class="password-wrap"><input id="accessKey" type="password" autocomplete="off" placeholder="Masukkan CMS access key"/><button id="togglePassword" type="button" class="toggle-password">Lihat</button></div></div>
<div class="row"><button id="translate" type="button">Translate to 4 Languages</button><button id="clear" type="button" class="secondary">Clear</button></div>
<div id="healthStatus" class="status"></div><div id="status" class="status"></div>
</section>
<section id="result" class="card result"><h2 style="margin-top:0">3. Review hasil terjemahan</h2><p class="muted">Bahasa Indonesia adalah sumber asli. Review dan edit terjemahan sebelum publish.</p><div id="articles"></div><div class="row"><button id="publish" type="button">Publish 5 Languages to GitHub</button></div><div id="publishStatus" class="status"></div></section>
</main>
<script>
const ENDPOINT='https://script.google.com/macros/s/AKfycbxGMuyFzq0K-gKIPaamp1ClFqo6zYJfNNvZfd0hxeJIJTj0N_DVPywUtkWbo5g0_F08/exec';
const EXPECTED_SERVICE='Banggai Wonderland CMS';
const EXPECTED_VERSION='8.0-manual-multilang';
const titleEl=document.getElementById('title'),pubDateEl=document.getElementById('pubDate'),descriptionEl=document.getElementById('description'),seoTitleEl=document.getElementById('seoTitle'),seoDescriptionEl=document.getElementById('seoDescription'),tagsEl=document.getElementById('tags'),contentEl=document.getElementById('content'),contentStatusEl=document.getElementById('contentStatus'),keyEl=document.getElementById('accessKey'),statusEl=document.getElementById('status'),healthStatusEl=document.getElementById('healthStatus'),translateEl=document.getElementById('translate'),resultEl=document.getElementById('result'),articlesEl=document.getElementById('articles'),publishEl=document.getElementById('publish'),publishStatusEl=document.getElementById('publishStatus'),imageFileEl=document.getElementById('imageFile'),imageUrlEl=document.getElementById('imageUrl'),imageStatusEl=document.getElementById('imageStatus'),imagePreview=document.getElementById('imagePreview'),imagePreviewImg=document.getElementById('imagePreviewImg'),selectedImageEl=document.getElementById('selectedImage'),uploadOk=document.getElementById('uploadOk'),uploadOkText=document.getElementById('uploadOkText');
let translatedArticles=null,selectedImage=null,healthState={checked:false,ok:false,version:null,service:null};
pubDateEl.value=new Date().toISOString().slice(0,10);
function setStatus(el,text,klass=''){el.className='status'+(klass?' '+klass:'');el.textContent=text||'';}
function esc(value=''){return String(value).replace(/[&<>\"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[ch]));}
function splitTags(value){return String(value||'').split(',').map(v=>v.trim()).filter(Boolean);}
function showImage(img){selectedImage=img;imagePreviewImg.src=img.url;selectedImageEl.textContent=img.url+(img.source?' · Source: '+img.source:'');imagePreview.classList.add('show');}
function confirmUpload(img){uploadOkText.textContent='File: '+(img.name||img.url.split('/').pop())+' · Tersimpan di GitHub: '+(img.path||'public'+img.url);uploadOk.classList.add('show');}
function ensureAllArticleImages(){if(!translatedArticles||!selectedImage||!selectedImage.url)return;Object.keys(translatedArticles).forEach(lang=>{const article=translatedArticles[lang];if(article){article.image=selectedImage.url;article.imageAlt=article.imageAlt||selectedImage.alt||titleEl.value||'Banggai Wonderland';article.imageSource=article.imageSource||selectedImage.source||'';}});}
contentEl.addEventListener('input',()=>{const n=contentEl.value.trim().length;if(n>0)setStatus(contentStatusEl,'✓ '+n.toLocaleString('id-ID')+' karakter artikel siap diterjemahkan.','success');else setStatus(contentStatusEl,'Isi artikel masih kosong.');});
document.getElementById('togglePassword').addEventListener('click',function(){const show=keyEl.type==='text';keyEl.type=show?'password':'text';this.textContent=show?'Lihat':'Sembunyikan';});
imageFileEl.addEventListener('change',()=>{uploadOk.classList.remove('show');if(imageFileEl.files[0])setStatus(imageStatusEl,'Foto dipilih: '+imageFileEl.files[0].name+'. Tekan Upload / Import Photo.');});
async function getHealth(){healthState={checked:false,ok:false,version:null,service:null};setStatus(healthStatusEl,'⏳ Memeriksa koneksi Apps Script…');try{const url=ENDPOINT+(ENDPOINT.includes('?')?'&':'?')+'_health='+Date.now();const response=await fetch(url,{method:'GET',cache:'no-store',redirect:'follow'});const raw=await response.text();let data;try{data=JSON.parse(raw);}catch(e){throw new Error('Endpoint /exec tidak mengembalikan JSON. HTTP '+response.status+'. Response: '+String(raw||'').replace(/\s+/g,' ').slice(0,180));}healthState={checked:true,ok:Boolean(data.ok),version:data.version||null,service:data.service||null};if(!data.ok)throw new Error(data.error||'Health check gagal.');if(data.service!==EXPECTED_SERVICE)throw new Error('Service tidak sesuai. Ditemukan: '+(data.service||'tidak ada'));if(data.version!==EXPECTED_VERSION)throw new Error('Versi Apps Script tidak sesuai. GitHub mengharapkan '+EXPECTED_VERSION+', tetapi /exec mengembalikan '+(data.version||'tanpa versi')+'.');setStatus(healthStatusEl,'✓ Apps Script online · '+data.version,'success');return true;}catch(error){healthState.checked=true;healthState.ok=false;translateEl.disabled=true;publishEl.disabled=true;setStatus(healthStatusEl,'✕ '+error.message,'danger');return false;}}
async function post(payload){const url=ENDPOINT+(ENDPOINT.includes('?')?'&':'?')+'_cms='+Date.now();let response;try{response=await fetch(url,{method:'POST',headers:{'Content-Type':'text/plain;charset=utf-8','Accept':'application/json,text/plain,*/*'},body:JSON.stringify(payload),cache:'no-store',redirect:'follow'});}catch(error){throw new Error('Tidak dapat terhubung ke CMS Apps Script: '+(error&&error.message?error.message:'Network error'));}const raw=await response.text();let data;try{data=JSON.parse(raw);}catch(error){const contentType=response.headers.get('content-type')||'unknown';const preview=String(raw||'').replace(/\s+/g,' ').slice(0,220);throw new Error('Apps Script tidak mengembalikan JSON (HTTP '+response.status+', '+contentType+'). '+(preview||'Response kosong'));}if(!data.ok)throw new Error(data.error||'CMS request failed');return data;}
document.getElementById('uploadImage').addEventListener('click',async function(){const accessKey=keyEl.value.trim(),file=imageFileEl.files&&imageFileEl.files[0],url=imageUrlEl.value.trim();if(!healthState.ok)return setStatus(imageStatusEl,'Periksa koneksi Apps Script terlebih dahulu.','danger');if(!accessKey)return setStatus(imageStatusEl,'Masukkan CMS access key terlebih dahulu.','danger');if(!file&&!url)return setStatus(imageStatusEl,'Pilih foto atau masukkan link foto.','danger');if(file&&file.size>8*1024*1024)return setStatus(imageStatusEl,'Ukuran foto maksimal 8 MB.','danger');uploadOk.classList.remove('show');setStatus(imageStatusEl,'⏳ Mengupload foto…');const button=this;button.disabled=true;try{const payload={action:'uploadImage',accessKey};if(file){payload.dataUrl=await new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(reader.result);reader.onerror=()=>reject(new Error('File tidak dapat dibaca.'));reader.readAsDataURL(file);});payload.fileName=file.name;}else payload.imageUrl=url;const data=await post(payload);showImage(data.image);confirmUpload(data.image);setStatus(imageStatusEl,'✓ Foto berhasil terupload dan siap ditempel ke artikel.','success');}catch(error){setStatus(imageStatusEl,'✕ '+error.message,'danger');}finally{button.disabled=false;}});
document.getElementById('useSearchImage').addEventListener('click',async function(){const accessKey=keyEl.value.trim(),topic=titleEl.value.trim();if(!healthState.ok)return setStatus(imageStatusEl,'Periksa koneksi Apps Script terlebih dahulu.','danger');if(!accessKey)return setStatus(imageStatusEl,'Masukkan CMS access key terlebih dahulu.','danger');if(!topic)return setStatus(imageStatusEl,'Isi judul artikel terlebih dahulu.','danger');setStatus(imageStatusEl,'⏳ Mencari foto berdasarkan judul…');const button=this;button.disabled=true;try{const data=await post({action:'searchImage',accessKey,topic});if(!data.image||!data.image.url)throw new Error('Foto tidak ditemukan.');showImage(data.image);setStatus(imageStatusEl,'✓ Foto relevan ditemukan dan siap ditempel ke artikel.','success');}catch(error){setStatus(imageStatusEl,'✕ '+error.message,'danger');}finally{button.disabled=false;}});
translateEl.addEventListener('click',async function(){if(!healthState.ok){setStatus(statusEl,'Apps Script belum lolos health check.','danger');return;}const accessKey=keyEl.value.trim(),title=titleEl.value.trim(),description=descriptionEl.value.trim(),seoTitle=seoTitleEl.value.trim(),seoDescription=seoDescriptionEl.value.trim(),content=contentEl.value.trim();if(!accessKey){keyEl.focus();setStatus(statusEl,'CMS access key wajib diisi.','danger');return;}if(!title){titleEl.focus();setStatus(statusEl,'Judul artikel wajib diisi.','danger');return;}if(!content){contentEl.focus();setStatus(statusEl,'Paste artikel Bahasa Indonesia terlebih dahulu.','danger');return;}if(content.length<300){setStatus(statusEl,'Artikel terlalu pendek. Minimal 300 karakter.','danger');return;}translateEl.disabled=true;setStatus(statusEl,'⏳ Menerjemahkan artikel…');try{translatedArticles=(await post({action:'translate',accessKey,title,description,seoTitle,seoDescription,content,image:selectedImage,pubDate:pubDateEl.value,tags:splitTags(tagsEl.value)})).articles;ensureAllArticleImages();renderArticles();resultEl.classList.add('show');setStatus(statusEl,'✓ Terjemahan selesai. Silakan review sebelum publish.','success');}catch(error){setStatus(statusEl,'✕ '+error.message,'danger');}finally{translateEl.disabled=false;}});
function renderArticles(){if(!translatedArticles)return;const order=['id','en','es','fr','zh'],labels={id:'Bahasa Indonesia',en:'English',es:'Spanish',fr:'French',zh:'Chinese'};articlesEl.innerHTML=order.map(lang=>{const a=translatedArticles[lang];if(!a)return '';return '<div class="lang"><h3>'+esc(labels[lang])+'</h3><div class="seo-grid"><div><label>Title</label><input data-lang="'+lang+'" data-field="title" value="'+esc(a.title)+'"/></div><div><label>SEO Title</label><input data-lang="'+lang+'" data-field="seoTitle" value="'+esc(a.seoTitle||'')+'"/></div></div><div style="margin-top:12px"><label>SEO Description</label><input data-lang="'+lang+'" data-field="seoDescription" value="'+esc(a.seoDescription||'')+'"/></div><div style="margin-top:12px"><label>Content</label><textarea data-lang="'+lang+'" data-field="content">'+esc(a.content)+'</textarea></div></div>';}).join('');articlesEl.querySelectorAll('[data-lang]').forEach(el=>el.addEventListener('input',()=>{const a=translatedArticles[el.dataset.lang];if(a)a[el.dataset.field]=el.value;}));}
publishEl.addEventListener('click',async function(){if(!healthState.ok){setStatus(publishStatusEl,'Apps Script belum lolos health check.','danger');return;}if(!translatedArticles)return setStatus(publishStatusEl,'Belum ada hasil terjemahan untuk dipublish.','danger');ensureAllArticleImages();publishEl.disabled=true;setStatus(publishStatusEl,'⏳ Publishing 5 bahasa ke GitHub…');try{const data=await post({action:'publish',accessKey:keyEl.value.trim(),articles:translatedArticles});setStatus(publishStatusEl,'✓ Publish berhasil. '+data.message,'success');}catch(error){setStatus(publishStatusEl,'✕ '+error.message,'danger');}finally{publishEl.disabled=false;}});
document.getElementById('clear').addEventListener('click',()=>{[titleEl,descriptionEl,seoTitleEl,seoDescriptionEl,tagsEl,contentEl,keyEl,imageUrlEl].forEach(el=>el.value='');pubDateEl.value=new Date().toISOString().slice(0,10);translatedArticles=null;selectedImage=null;resultEl.classList.remove('show');articlesEl.innerHTML='';uploadOk.classList.remove('show');imagePreview.classList.remove('show');setStatus(statusEl,'');setStatus(contentStatusEl,'');setStatus(imageStatusEl,'');setStatus(publishStatusEl,'');});
getHealth().then(ok=>{if(ok){translateEl.disabled=false;publishEl.disabled=false;}});
</script>
</body>
</html>
