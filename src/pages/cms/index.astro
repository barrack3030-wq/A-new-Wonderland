---
const title='Banggai Wonderland CMS';
---
<!doctype html>
<html lang="id">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<meta name="robots" content="noindex,nofollow"/>
<title>{title}</title>
<style>
:root{color-scheme:dark;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}*{box-sizing:border-box}body{margin:0;min-height:100vh;background:linear-gradient(145deg,#061525,#0b2b46 55%,#071a2a);color:#eef7ff}.wrap{width:min(1100px,94%);margin:0 auto;padding:34px 0 60px}.brand{margin-bottom:28px}.brand h1{margin:0;font-size:clamp(28px,5vw,42px);letter-spacing:-.03em}.brand p{color:#9fc0d6;margin:8px 0 0}.card{background:rgba(8,24,39,.88);border:1px solid rgba(157,207,235,.16);border-radius:20px;padding:24px;box-shadow:0 20px 70px rgba(0,0,0,.28);margin-bottom:18px}label{display:block;font-size:13px;font-weight:700;color:#b8d5e7;margin:0 0 8px}input,textarea{width:100%;border:1px solid #28465c;background:#071b2b;color:#f5fbff;border-radius:12px;padding:13px 14px;outline:none;font:inherit}input:focus,textarea:focus{border-color:#56b8ea;box-shadow:0 0 0 3px rgba(86,184,234,.12)}textarea{min-height:300px;resize:vertical;line-height:1.65}.meta-grid{display:grid;grid-template-columns:2fr 1fr;gap:14px}.seo-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.image-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}button{border:0;border-radius:12px;padding:12px 18px;font-weight:800;cursor:pointer;color:#03121d;background:#65c8f2;touch-action:manipulation}button.secondary{background:#17364d;color:#dceffc}button:disabled{opacity:.5;cursor:not-allowed}.status{margin-top:14px;color:#9fc0d6;min-height:22px;white-space:pre-wrap}.danger{color:#ffb2b2}.success{color:#9ce7b4}.muted{color:#86a7bb;font-size:13px}.divider{border-top:1px solid rgba(157,207,235,.12);margin:22px 0}.result{display:none}.result.show{display:block}.lang{border-top:1px solid rgba(157,207,235,.12);padding:18px 0}.lang:first-child{border-top:0;padding-top:0}.lang textarea{min-height:420px}.preview{margin-top:12px;display:none}.preview.show{display:block}.preview img{width:100%;max-height:280px;object-fit:cover;border-radius:14px;border:1px solid #28465c}.selected{margin-top:10px;padding:10px 12px;border-radius:10px;background:#0b2437;color:#bfe4f7;font-size:13px;word-break:break-all}.upload-ok{display:none;margin-top:12px;padding:12px 14px;border-radius:12px;border:1px solid rgba(156,231,180,.25);background:rgba(33,83,55,.25);color:#b9f2c9}.upload-ok.show{display:block}.password-wrap{position:relative}.password-wrap input{padding-right:92px}.toggle-password{position:absolute;right:6px;top:6px;height:calc(100% - 12px);padding:0 12px;border-radius:9px;background:#17364d;color:#dceffc;font-size:12px}@media(max-width:800px){.meta-grid,.seo-grid,.image-grid{grid-template-columns:1fr}.card{padding:18px}input,textarea{font-size:16px}}
</style>
</head>
<body>
<main class="wrap">
<header class="brand"><h1>Banggai Wonderland CMS</h1><p>Manual Article → AI Translation → Review → Publish</p></header>

<section class="card">
<h2 style="margin-top:0">1. Tulis artikel utama</h2>
<p class="muted">Paste artikel Bahasa Indonesia Anda. AI tidak menulis artikel ini; AI hanya menerjemahkannya ke English, Spanish, French, dan Chinese.</p>

<div class="meta-grid">
<div><label for="title">Judul artikel</label><input id="title" type="text" autocomplete="off" placeholder="Contoh: Panduan Lengkap Mengunjungi Danau Paisupok"/></div>
<div><label for="pubDate">Tanggal publish</label><input id="pubDate" type="date"/></div>
</div>

<div style="margin-top:14px"><label for="description">Deskripsi / excerpt</label><input id="description" type="text" placeholder="Ringkasan singkat artikel untuk blog dan SEO"/></div>

<div class="seo-grid" style="margin-top:14px">
<div><label for="seoTitle">SEO Title <span class="muted">(opsional)</span></label><input id="seoTitle" type="text" placeholder="SEO title"/></div>
<div><label for="seoDescription">SEO Description <span class="muted">(opsional)</span></label><input id="seoDescription" type="text" placeholder="SEO meta description"/></div>
</div>

<div style="margin-top:14px"><label for="tags">Tags <span class="muted">(pisahkan dengan koma)</span></label><input id="tags" type="text" placeholder="Banggai, Indonesia, Travel"/></div>

<div style="margin-top:14px"><label for="content">Artikel Bahasa Indonesia</label><textarea id="content" placeholder="Paste artikel lengkap Anda di sini...\n\nMarkdown diperbolehkan."></textarea><div id="contentStatus" class="status"></div></div>

<div class="divider"></div>
<h2 style="margin-top:0">2. Featured image</h2>
<div class="image-grid">
<div><label for="imageFile">Upload foto</label><input id="imageFile" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml"/></div>
<div><label for="imageUrl">Atau gunakan link foto</label><input id="imageUrl" type="url" placeholder="https://contoh.com/foto.jpg"/></div>
</div>
<div class="row"><button id="uploadImage" type="button">Upload / Import Photo</button><button id="useSearchImage" type="button" class="secondary">Auto Search by Topic</button></div>
<div id="imageStatus" class="status"></div>
<div id="uploadOk" class="upload-ok"><strong>✓ Foto berhasil terupload</strong><span id="uploadOkText"></span></div>
<div id="imagePreview" class="preview"><img id="imagePreviewImg" alt="Selected featured image"/><div id="selectedImage" class="selected"></div></div>

<div style="margin-top:18px"><label for="accessKey">CMS access key</label><div class="password-wrap"><input id="accessKey" type="password" autocomplete="off" placeholder="Masukkan CMS access key"/><button id="togglePassword" type="button" class="toggle-password">Lihat</button></div></div>
<div class="row"><button id="translate" type="button">Translate to 4 Languages</button><button id="clear" type="button" class="secondary">Clear</button></div>
<div id="status" class="status"></div>
</section>

<section id="result" class="card result">
<h2 style="margin-top:0">3. Review hasil terjemahan</h2>
<p class="muted">Bahasa Indonesia adalah sumber asli. Review dan edit terjemahan sebelum publish.</p>
<div id="articles"></div>
<div class="row"><button id="publish" type="button">Publish 5 Languages to GitHub</button></div>
<div id="publishStatus" class="status"></div>
</section>
</main>

<script>
const ENDPOINT='https://script.google.com/macros/s/AKfycbxGMuyFzq0K-gKIPaamp1ClFqo6zYJfNNvZfd0hxeJIJTj0N_DVPywUtkWbo5g0_F08/exec';
const titleEl=document.getElementById('title');
const pubDateEl=document.getElementById('pubDate');
const descriptionEl=document.getElementById('description');
const seoTitleEl=document.getElementById('seoTitle');
const seoDescriptionEl=document.getElementById('seoDescription');
const tagsEl=document.getElementById('tags');
const contentEl=document.getElementById('content');
const contentStatusEl=document.getElementById('contentStatus');
const keyEl=document.getElementById('accessKey');
const statusEl=document.getElementById('status');
const translateEl=document.getElementById('translate');
const resultEl=document.getElementById('result');
const articlesEl=document.getElementById('articles');
const publishEl=document.getElementById('publish');
const publishStatusEl=document.getElementById('publishStatus');
const imageFileEl=document.getElementById('imageFile');
const imageUrlEl=document.getElementById('imageUrl');
const imageStatusEl=document.getElementById('imageStatus');
const imagePreview=document.getElementById('imagePreview');
const imagePreviewImg=document.getElementById('imagePreviewImg');
const selectedImageEl=document.getElementById('selectedImage');
const uploadOk=document.getElementById('uploadOk');
const uploadOkText=document.getElementById('uploadOkText');
let translatedArticles=null;
let selectedImage=null;

pubDateEl.value=new Date().toISOString().slice(0,10);

function setStatus(el,text,klass=''){
  el.className='status'+(klass?' '+klass:'');
  el.textContent=text||'';
}

function esc(value=''){
  return String(value).replace(/[&<>"']/g,function(ch){
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch];
  });
}

function splitTags(value){
  return String(value||'').split(',').map(function(v){return v.trim();}).filter(Boolean);
}

function showImage(img){
  selectedImage=img;
  imagePreviewImg.src=img.url;
  selectedImageEl.textContent=img.url+(img.source?' · Source: '+img.source:'');
  imagePreview.classList.add('show');
}

function confirmUpload(img){
  uploadOkText.textContent='File: '+(img.name||img.url.split('/').pop())+' · Tersimpan di GitHub: '+(img.path||'public'+img.url);
  uploadOk.classList.add('show');
}

function ensureAllArticleImages(){
  if(!translatedArticles||!selectedImage||!selectedImage.url)return;
  Object.keys(translatedArticles).forEach(function(lang){
    const article=translatedArticles[lang];
    if(article){
      // Featured image is stored only in frontmatter/metadata.
      // Do NOT inject it into article.content; that creates a second photo.
      article.image=selectedImage.url;
      article.imageAlt=article.imageAlt||selectedImage.alt||titleEl.value||'Banggai Wonderland';
      article.imageSource=article.imageSource||selectedImage.source||'';
    }
  });
}

contentEl.addEventListener('input',function(){
  const n=contentEl.value.trim().length;
  if(n>0){
    setStatus(contentStatusEl,'✓ '+n.toLocaleString('id-ID')+' karakter artikel siap diterjemahkan.','success');
  }else{
    setStatus(contentStatusEl,'Isi artikel masih kosong.');
  }
});

document.getElementById('togglePassword').addEventListener('click',function(){
  const show=keyEl.type==='text';
  keyEl.type=show?'password':'text';
  this.textContent=show?'Lihat':'Sembunyikan';
});

imageFileEl.addEventListener('change',function(){
  uploadOk.classList.remove('show');
  if(imageFileEl.files[0])setStatus(imageStatusEl,'Foto dipilih: '+imageFileEl.files[0].name+'. Tekan Upload / Import Photo.');
});

async function post(payload){
  const response=await fetch(ENDPOINT,{
    method:'POST',
    headers:{'Content-Type':'text/plain;charset=utf-8'},
    body:JSON.stringify(payload)
  });
  const raw=await response.text();
  let data;
  try{data=JSON.parse(raw);}catch(error){throw new Error('CMS tidak mengembalikan JSON. Pastikan deployment Apps Script sudah versi terbaru.');}
  if(!data.ok)throw new Error(data.error||'CMS request failed');
  return data;
}

document.getElementById('uploadImage').addEventListener('click',async function(){
  const accessKey=keyEl.value.trim();
  const file=imageFileEl.files&&imageFileEl.files[0];
  const url=imageUrlEl.value.trim();
  if(!accessKey)return setStatus(imageStatusEl,'Masukkan CMS access key terlebih dahulu.','danger');
  if(!file&&!url)return setStatus(imageStatusEl,'Pilih foto atau masukkan link foto.','danger');
  if(file&&file.size>8*1024*1024)return setStatus(imageStatusEl,'Ukuran foto maksimal 8 MB.','danger');
  uploadOk.classList.remove('show');
  setStatus(imageStatusEl,'⏳ Mengupload foto…');
  const button=this;button.disabled=true;
  try{
    const payload={action:'uploadImage',accessKey:accessKey};
    if(file){
      payload.dataUrl=await new Promise(function(resolve,reject){
        const reader=new FileReader();
        reader.onload=function(){resolve(reader.result);};
        reader.onerror=function(){reject(new Error('File tidak dapat dibaca.'));};
        reader.readAsDataURL(file);
      });
      payload.fileName=file.name;
    }else{
      payload.imageUrl=url;
    }
    const data=await post(payload);
    showImage(data.image);
    confirmUpload(data.image);
    setStatus(imageStatusEl,'✓ Foto berhasil terupload dan siap ditempel ke artikel.','success');
  }catch(error){
    setStatus(imageStatusEl,'✕ '+error.message,'danger');
  }finally{button.disabled=false;}
});

document.getElementById('useSearchImage').addEventListener('click',async function(){
  const accessKey=keyEl.value.trim();
  const topic=titleEl.value.trim();
  if(!accessKey)return setStatus(imageStatusEl,'Masukkan CMS access key terlebih dahulu.','danger');
  if(!topic)return setStatus(imageStatusEl,'Isi judul artikel terlebih dahulu.','danger');
  setStatus(imageStatusEl,'⏳ Mencari foto berdasarkan judul…');
  const button=this;button.disabled=true;
  try{
    const data=await post({action:'searchImage',accessKey:accessKey,topic:topic});
    if(!data.image||!data.image.url)throw new Error('Foto tidak ditemukan.');
    showImage(data.image);
    setStatus(imageStatusEl,'✓ Foto relevan ditemukan dan siap ditempel ke artikel.','success');
  }catch(error){
    setStatus(imageStatusEl,'✕ '+error.message,'danger');
  }finally{button.disabled=false;}
});

translateEl.addEventListener('click',async function(){
  const accessKey=keyEl.value.trim();
  const title=titleEl.value.trim();
  const content=contentEl.value.trim();
  if(!title){titleEl.focus();setStatus(statusEl,'Judul artikel wajib diisi.','danger');return;}
  if(!content){contentEl.focus();setStatus(statusEl,'Paste artikel Bahasa Indonesia terlebih dahulu.','danger');return;}
  if(content.length<300){contentEl.focus();setStatus(statusEl,'Artikel terlalu pendek. Minimal 300 karakter.','danger');return;}
  if(!accessKey){keyEl.focus();setStatus(statusEl,'Masukkan CMS access key terlebih dahulu.','danger');return;}

  translateEl.disabled=true;
  resultEl.classList.remove('show');
  setStatus(statusEl,'⏳ AI sedang menerjemahkan ke 4 bahasa…');
  try{
    const data=await post({
      action:'translate',
      accessKey:accessKey,
      title:title,
      description:descriptionEl.value.trim(),
      seoTitle:seoTitleEl.value.trim(),
      seoDescription:seoDescriptionEl.value.trim(),
      tags:splitTags(tagsEl.value),
      pubDate:pubDateEl.value,
      image:selectedImage,
      content:content
    });
    translatedArticles=data.articles;
    ensureAllArticleImages();
    renderArticles();
    resultEl.classList.add('show');
    setStatus(statusEl,'✓ Terjemahan English, Spanish, French, dan Chinese berhasil dibuat. Featured image digunakan sebagai satu-satunya foto utama pada 5 versi artikel.','success');
  }catch(error){
    setStatus(statusEl,'✕ '+error.message,'danger');
  }finally{
    translateEl.disabled=false;
  }
});

function renderArticles(){
  const languages=['id','en','es','fr','zh'];
  articlesEl.innerHTML=languages.map(function(lang){
    const article=translatedArticles[lang];
    const source=lang==='id';
    return '<article class="lang">'
      +'<h3>'+lang.toUpperCase()+' · '+esc(article.title)+'</h3>'
      +(article.image?'<div style="margin:12px 0"><img src="'+esc(article.image)+'" alt="'+esc(article.imageAlt||article.title)+'" style="width:100%;max-height:280px;object-fit:cover;border-radius:14px;border:1px solid #28465c"></div>':'')
      +'<div class="muted" style="margin-bottom:10px">'+(source?'Artikel sumber — tidak diubah AI.':'Hasil terjemahan — silakan review/edit.')+'</div>'
      +'<label>Title</label>'
      +'<input data-lang="'+lang+'" data-field="title" value="'+esc(article.title)+'">'
      +'<label style="margin-top:12px">Description</label>'
      +'<input data-lang="'+lang+'" data-field="description" value="'+esc(article.description)+'">'
      +'<label style="margin-top:12px">SEO Title</label>'
      +'<input data-lang="'+lang+'" data-field="seoTitle" value="'+esc(article.seoTitle||'')+'">'
      +'<label style="margin-top:12px">SEO Description</label>'
      +'<input data-lang="'+lang+'" data-field="seoDescription" value="'+esc(article.seoDescription||'')+'">'
      +'<label style="margin-top:12px">Article Content</label>'
      +'<textarea data-lang="'+lang+'" data-field="content">'+esc(article.content)+'</textarea>'
      +'</article>';
  }).join('');

  articlesEl.querySelectorAll('[data-lang][data-field]').forEach(function(element){
    element.addEventListener('input',function(){
      const lang=element.dataset.lang;
      const field=element.dataset.field;
      translatedArticles[lang][field]=element.value;
    });
  });
}

publishEl.addEventListener('click',async function(){
  if(!translatedArticles)return;
  const accessKey=keyEl.value.trim();
  if(!accessKey)return setStatus(publishStatusEl,'Masukkan CMS access key terlebih dahulu.','danger');
  ensureAllArticleImages();
  renderArticles();
  publishEl.disabled=true;
  setStatus(publishStatusEl,'⏳ Publishing 5 bahasa ke GitHub…');
  try{
    const data=await post({action:'publish',accessKey:accessKey,articles:translatedArticles});
    setStatus(publishStatusEl,data.message||'✓ Published dengan featured image terpasang.','success');
  }catch(error){
    setStatus(publishStatusEl,'✕ '+error.message,'danger');
  }finally{
    publishEl.disabled=false;
  }
});

document.getElementById('clear').addEventListener('click',function(){
  titleEl.value='';
  descriptionEl.value='';
  seoTitleEl.value='';
  seoDescriptionEl.value='';
  tagsEl.value='';
  contentEl.value='';
  pubDateEl.value=new Date().toISOString().slice(0,10);
  imageFileEl.value='';
  imageUrlEl.value='';
  selectedImage=null;
  translatedArticles=null;
  imagePreview.classList.remove('show');
  uploadOk.classList.remove('show');
  resultEl.classList.remove('show');
  articlesEl.innerHTML='';
  setStatus(statusEl,'');
  setStatus(contentStatusEl,'');
  setStatus(imageStatusEl,'');
  setStatus(publishStatusEl,'');
});
</script>
<!-- CMS_MARKDOWN_ENHANCEMENT -->
<style>
.md-tools{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}
.md-tools button{padding:8px 12px;border-radius:9px;font-size:12px}
.md-help{color:#86a7bb;font-size:12px;margin:6px 0 10px;line-height:1.5}
.md-preview{display:none;margin-top:12px;padding:22px;border:1px solid #28465c;border-radius:14px;background:#061827;color:#dceffc;overflow:auto}
.md-preview.show{display:block}
.md-preview h1,.md-preview h2,.md-preview h3,.md-preview h4{margin:1.1em 0 .55em;color:#fff}
.md-preview p{margin:.7em 0;line-height:1.7}
.md-preview ul,.md-preview ol{padding-left:24px;margin:.7em 0}
.md-preview blockquote{margin:1em 0;padding-left:14px;border-left:3px solid #65c8f2;color:#a9c8da}
.md-preview code{background:#102b40;padding:2px 5px;border-radius:5px}
.md-preview pre{background:#04111d;padding:14px;border-radius:10px;overflow:auto}
.md-preview table{width:100%;border-collapse:collapse;margin:1em 0;font-size:14px}
.md-preview th,.md-preview td{border:1px solid #36556b;padding:9px;text-align:left}
.md-preview th{background:#102e44}
.md-preview img{max-width:100%;height:auto;border-radius:12px;margin:10px 0}
.md-preview a{color:#65c8f2}
.md-tabs{display:flex;gap:8px;margin-top:10px}
.md-tabs button{background:#17364d;color:#dceffc}
.md-tabs button.active{background:#65c8f2;color:#03121d}
</style>

<script>
(function(){
  const textarea=document.getElementById('content');
  if(!textarea||textarea.dataset.mdEnhanced)return;
  textarea.dataset.mdEnhanced='1';

  const label=textarea.previousElementSibling;
  const tools=document.createElement('div');
  tools.className='md-tools';
  tools.innerHTML=''
    +'<button type="button" data-md="h2">H2</button>'
    +'<button type="button" data-md="h3">H3</button>'
    +'<button type="button" data-md="bold"><strong>B</strong></button>'
    +'<button type="button" data-md="italic"><em>I</em></button>'
    +'<button type="button" data-md="ul">• List</button>'
    +'<button type="button" data-md="ol">1. List</button>'
    +'<button type="button" data-md="quote">Quote</button>'
    +'<button type="button" data-md="table">Table</button>';
  textarea.parentNode.insertBefore(tools,textarea);

  const help=document.createElement('div');
  help.className='md-help';
  help.textContent='Markdown-aware editor: heading (#), bold (**), italic (*), list, quote, links, images, code blocks, dan tabel Markdown akan dipertahankan. Paste dari ChatGPT/Claude/Gemini juga dinormalisasi bila clipboard menyediakan HTML.';
  textarea.parentNode.insertBefore(help,textarea);

  const tabs=document.createElement('div');
  tabs.className='md-tabs';
  tabs.innerHTML='<button type="button" class="active" data-tab="source">Markdown Source</button><button type="button" data-tab="preview">Live Preview</button>';
  textarea.parentNode.insertBefore(tabs,textarea);

  const preview=document.createElement('div');
  preview.className='md-preview';
  textarea.parentNode.appendChild(preview);

  function esc(v){return String(v||'').replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]||c;});}
  function inline(v){
    let s=esc(v);
    s=s.replace(/`([^`]+)`/g,'<code>$1</code>');
    s=s.replace(/!\[([^\]]*)\]\(([^)]+)\)/g,'<img src="$2" alt="$1">');
    s=s.replace(/\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g,'<a href="$2" target="_blank" rel="noopener">$1</a>');
    s=s.replace(/\*\*([^*]+)\*\*/g,'<strong>$1</strong>');
    s=s.replace(/__([^_]+)__/g,'<strong>$1</strong>');
    s=s.replace(/(?<!\*)\*([^*]+)\*(?!\*)/g,'<em>$1</em>');
    s=s.replace(/(?<!_)_([^_]+)_(?!_)/g,'<em>$1</em>');
    return s;
  }
  function table(lines){
    if(lines.length<2)return '';
    const cells=function(line){return line.trim().replace(/^\|/,'').replace(/\|$/,'').split('|').map(x=>x.trim());};
    const head=cells(lines[0]);
    const sep=cells(lines[1]);
    if(!sep.every(x=>/^:?-{3,}:?$/.test(x)))return '';
    let out='<table><thead><tr>'+head.map(x=>'<th>'+inline(x)+'</th>').join('')+'</tr></thead><tbody>';
    lines.slice(2).forEach(function(line){
      const row=cells(line); out+='<tr>'+head.map(function(_,i){return '<td>'+inline(row[i]||'')+'</td>';}).join('')+'</tr>';
    });
    return out+'</tbody></table>';
  }
  function render(md){
    const lines=String(md||'').replace(/\r\n?/g,'\n').split('\n');
    let html='',i=0,inCode=false,code=[];
    while(i<lines.length){
      const line=lines[i];
      if(/^```/.test(line)){inCode=!inCode;if(!inCode){html+='<pre><code>'+esc(code.join('\n'))+'</code></pre>';code=[];}i++;continue;}
      if(inCode){code.push(line);i++;continue;}
      if(/^\|/.test(line)&&i+1<lines.length&&/^\|/.test(lines[i+1])){
        const rows=[line,lines[i+1]];let j=i+2;while(j<lines.length&&/^\|/.test(lines[j])){rows.push(lines[j]);j++;}
        const t=table(rows);if(t){html+=t;i=j;continue;}
      }
      if(/^#{1,6}\s+/.test(line)){const m=line.match(/^(#{1,6})\s+(.*)$/);html+='<h'+m[1].length+'>'+inline(m[2])+'</h'+m[1].length+'>';i++;continue;}
      if(/^>\s?/.test(line)){html+='<blockquote>'+inline(line.replace(/^>\s?/,''))+'</blockquote>';i++;continue;}
      if(/^\s*[-*+]\s+/.test(line)){let items='';while(i<lines.length&&/^\s*[-*+]\s+/.test(lines[i])){items+='<li>'+inline(lines[i].replace(/^\s*[-*+]\s+/,''))+'</li>';i++;}html+='<ul>'+items+'</ul>';continue;}
      if(/^\s*\d+[.)]\s+/.test(line)){let items='';while(i<lines.length&&/^\s*\d+[.)]\s+/.test(lines[i])){items+='<li>'+inline(lines[i].replace(/^\s*\d+[.)]\s+/,''))+'</li>';i++;}html+='<ol>'+items+'</ol>';continue;}
      if(!line.trim()){i++;continue;}
      let p=line;let j=i+1;while(j<lines.length&&lines[j].trim()&&!/^#{1,6}\s+/.test(lines[j])&&!/^\s*[-*+]\s+/.test(lines[j])&&!/^\s*\d+[.)]\s+/.test(lines[j])&&!/^>\s?/.test(lines[j])){p+='\n'+lines[j];j++;}
      html+='<p>'+inline(p).replace(/\n/g,'<br>')+'</p>';i=j;
    }
    return html||'<p class="muted">Preview akan muncul setelah Anda menulis artikel.</p>';
  }

  function updatePreview(){preview.innerHTML=render(textarea.value);}
  textarea.addEventListener('input',updatePreview);
  updatePreview();

  textarea.addEventListener('paste',function(ev){
    const html=ev.clipboardData&&ev.clipboardData.getData('text/html');
    const plain=ev.clipboardData&&ev.clipboardData.getData('text/plain');
    if(!html||html.indexOf('<')===-1)return;
    const hasTable=/<table[\s>]/i.test(html);
    const hasRich=/<(h[1-6]|strong|b|em|i|ul|ol|blockquote|pre|a|img)[\s>]/i.test(html);
    if(!hasTable&&!hasRich)return;
    ev.preventDefault();
    const md=htmlToMarkdown(html);
    const start=textarea.selectionStart,end=textarea.selectionEnd;
    textarea.value=textarea.value.slice(0,start)+md+textarea.value.slice(end);
    textarea.selectionStart=textarea.selectionEnd=start+md.length;
    textarea.dispatchEvent(new Event('input',{bubbles:true}));
  });

  function htmlToMarkdown(source){
    const doc=new DOMParser().parseFromString(source,'text/html');
    function walk(node){
      if(node.nodeType===3)return node.nodeValue;
      if(node.nodeType!==1)return '';
      const tag=node.tagName.toLowerCase(),content=Array.from(node.childNodes).map(walk).join('');
      if(tag==='h1')return '# '+content.trim()+'\n\n';
      if(tag==='h2')return '## '+content.trim()+'\n\n';
      if(tag==='h3')return '### '+content.trim()+'\n\n';
      if(tag==='h4')return '#### '+content.trim()+'\n\n';
      if(tag==='h5')return '##### '+content.trim()+'\n\n';
      if(tag==='h6')return '###### '+content.trim()+'\n\n';
      if(tag==='strong'||tag==='b')return '**'+content.trim()+'**';
      if(tag==='em'||tag==='i')return '*'+content.trim()+'*';
      if(tag==='a')return '['+content.trim()+']('+(node.getAttribute('href')||'')+')';
      if(tag==='img')return '!['+(node.getAttribute('alt')||'image')+']('+(node.getAttribute('src')||'')+')';
      if(tag==='br')return '\n';
      if(tag==='p'||tag==='div')return content.trim()+'\n\n';
      if(tag==='blockquote')return content.trim().split('\n').map(x=>'> '+x).join('\n')+'\n\n';
      if(tag==='ul')return Array.from(node.children).map(li=>' - '+walk(li).trim()).join('\n')+'\n\n';
      if(tag==='ol')return Array.from(node.children).map((li,n)=>(n+1)+'. '+walk(li).trim()).join('\n')+'\n\n';
      if(tag==='li')return content;
      if(tag==='pre')return '```\n'+content.trim()+'\n```\n\n';
      if(tag==='code')return '`'+content+'`';
      if(tag==='table'){
        const rows=Array.from(node.querySelectorAll('tr')).map(tr=>Array.from(tr.children).map(c=>c.textContent.trim().replace(/\|/g,'\\|')));
        if(!rows.length)return '';
        const header=rows[0],divider=header.map(()=> '---');
        return '| '+header.join(' | ')+' |\n| '+divider.join(' | ')+' |\n'+rows.slice(1).map(r=>'| '+header.map((_,i)=>r[i]||'').join(' | ')+' |').join('\n')+'\n\n';
      }
      return content;
    }
    return walk(doc.body).replace(/\n{3,}/g,'\n\n').trim();
  }

  tools.querySelectorAll('button[data-md]').forEach(function(btn){
    btn.addEventListener('click',function(){
      const type=btn.dataset.md,start=textarea.selectionStart,end=textarea.selectionEnd,sel=textarea.value.slice(start,end);
      let before='',after='';
      if(type==='h2'){before='## ';}
      if(type==='h3'){before='### ';}
      if(type==='bold'){before='**';after='**';}
      if(type==='italic'){before='*';after='*';}
      if(type==='ul'){before='- ';}
      if(type==='ol'){before='1. ';}
      if(type==='quote'){before='> ';}
      if(type==='table'){before='| Column 1 | Column 2 |\n|---|---|\n| Value 1 | Value 2 |\n\n';}
      const value=type==='table'?before:before+(sel||'text')+after;
      textarea.value=textarea.value.slice(0,start)+value+textarea.value.slice(end);
      textarea.focus();textarea.selectionStart=start+value.length;textarea.selectionEnd=start+value.length;
      textarea.dispatchEvent(new Event('input',{bubbles:true}));
    });
  });

  tabs.querySelectorAll('button').forEach(function(btn){
    btn.addEventListener('click',function(){
      tabs.querySelectorAll('button').forEach(b=>b.classList.remove('active'));btn.classList.add('active');
      const previewMode=btn.dataset.tab==='preview';
      textarea.style.display=previewMode?'none':'';
      tools.style.display=previewMode?'none':'';
      help.style.display=previewMode?'none':'';
      preview.classList.toggle('show',previewMode);
      updatePreview();
    });
  });
})();
</script>

</body>
</html>
