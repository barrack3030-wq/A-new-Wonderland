---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';

const title = '방가이 트래블 | 인도네시아 방가이 제도 프라이빗 투어';
const description = '한국인 여행자를 위한 방가이 트래블 가이드. 루욱에서 파이수폭, 펠렝, 살라칸, 풀라우 두아까지 프라이빗 투어와 맞춤 일정을 상담하세요.';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: 'Banggai Wonderland',
  url: 'https://banggaiwonderland.my.id/',
  description,
  areaServed: [
    { '@type': 'Place', name: 'Luwuk' },
    { '@type': 'Place', name: 'Banggai Islands' },
    { '@type': 'Place', name: 'Banggai Laut' }
  ]
};
---
<BaseLayout title={title} description={description} seoTitle={title} seoDescription={description} ogImage="/images/Poganda-Beach-Banggai-IndonesiaJuara-Trip.webp" imageAlt="Banggai Islands travel">
  <div class="bg-sand-50 pt-28">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-8">
      <Breadcrumb items={[{ name: '홈', url: '/ko/' }, { name: '방가이 트래블', url: '/ko/banggai-travel/' }]} />
    </div>
    <section class="relative overflow-hidden bg-ocean-900 text-white">
      <img src="/images/Poganda-Beach-Banggai-IndonesiaJuara-Trip.webp" alt="방가이 제도 포간다 해변" class="absolute inset-0 w-full h-full object-cover opacity-40" loading="eager" />
      <div class="absolute inset-0 bg-ocean-900/70"></div>
      <div class="relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-20 md:py-28">
        <p class="text-white/65 text-xs font-bold tracking-[0.24em] uppercase mb-5">BANGGAI TRAVEL · PRIVATE TOUR</p>
        <h1 class="font-serif text-4xl sm:text-5xl md:text-7xl leading-[0.98] max-w-4xl mb-7">루욱에서 만나는 방가이 제도 여행</h1>
        <p class="text-white/80 text-base md:text-xl leading-relaxed max-w-3xl mb-9">서울에서 마나도와 루욱을 거쳐 방가이 제도의 숨은 섬으로. 파이수폭을 비롯한 주요 목적지를 여행 기간과 스타일에 맞춰 연결합니다.</p>
        <div class="flex flex-wrap gap-3">
          <a href="https://wa.me/6285820830530" target="_blank" rel="noopener noreferrer" class="rounded-full bg-white text-ocean-900 px-6 py-3.5 text-sm font-semibold">여행 상담하기 →</a>
          <a href="/ko/jasa-tour-luwuk-banggai/" class="rounded-full border border-white/25 bg-white/10 px-6 py-3.5 text-sm font-semibold">투어 서비스 보기</a>
        </div>
      </div>
    </section>
    <section class="bg-white py-16 md:py-24">
      <div class="max-w-4xl mx-auto px-5 sm:px-8">
        <p class="text-turquoise-700 text-xs font-bold tracking-[0.22em] uppercase mb-4">BANGGAI ISLANDS</p>
        <h2 class="font-serif text-3xl md:text-5xl text-ocean-900 mb-6">왜 방가이 여행은 루욱에서 계획해야 할까요?</h2>
        <p class="text-ocean-600 leading-relaxed mb-5">방가이 제도는 한 곳에 모든 관광지가 모여 있는 여행지가 아닙니다. 루욱에서 시작해 육로와 페리, 현지 보트를 이용하며 여러 섬을 연결해야 합니다. 그래서 단순히 목적지를 고르는 것보다 이동 순서를 먼저 설계하는 것이 중요합니다.</p>
        <p class="text-ocean-600 leading-relaxed">Banggai Wonderland는 현지 운영 경험을 바탕으로 한국인 여행자가 이해하기 쉬운 일정과 이동 동선을 상담합니다. 파이수폭 중심의 짧은 여행부터 여러 섬을 연결하는 장기 여행까지 가능합니다.</p>
      </div>
    </section>
    <section class="bg-sand-50 py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
        <div class="grid md:grid-cols-3 gap-5">
          <article class="rounded-2xl border border-sand-200 bg-white p-6"><h3 class="font-serif text-2xl text-ocean-900 mb-3">프라이빗 투어</h3><p class="text-sm text-ocean-600 leading-relaxed">커플, 가족, 친구끼리 우리 그룹만의 일정으로 여행합니다.</p></article>,<article class="rounded-2xl border border-sand-200 bg-white p-6"><h3 class="font-serif text-2xl text-ocean-900 mb-3">맞춤 방가이 트립</h3><p class="text-sm text-ocean-600 leading-relaxed">여행 기간과 관심 목적지에 맞춰 루욱–살라칸–펠렝 동선을 구성합니다.</p></article>,<article class="rounded-2xl border border-sand-200 bg-white p-6"><h3 class="font-serif text-2xl text-ocean-900 mb-3">소규모 오픈 트립</h3><p class="text-sm text-ocean-600 leading-relaxed">혼자 여행하는 분도 4–8명 소규모 그룹 일정에 합류할 수 있습니다.</p></article>
        </div>
      </div>
    </section>
    <section class="bg-white py-16 md:py-24">
      <div class="max-w-4xl mx-auto px-5 sm:px-8">
        <h2 class="font-serif text-3xl md:text-5xl text-ocean-900 mb-8">한국인 여행자를 위한 대표 목적지</h2>
        <div class="grid md:grid-cols-2 gap-4">
          <article class="border-b border-sand-200 pb-5"><h3 class="font-semibold text-ocean-900 mb-2">Paisu Pok · 파이수폭</h3><p class="text-sm text-ocean-600 leading-relaxed">맑은 청록빛 물로 유명한 펠렝의 대표 자연 명소.</p></article>,<article class="border-b border-sand-200 pb-5"><h3 class="font-semibold text-ocean-900 mb-2">Paisu Batango</h3><p class="text-sm text-ocean-600 leading-relaxed">파이수폭과 함께 연결하기 좋은 자연 수원과 물놀이 장소.</p></article>,<article class="border-b border-sand-200 pb-5"><h3 class="font-semibold text-ocean-900 mb-2">Kawalu Bay</h3><p class="text-sm text-ocean-600 leading-relaxed">펠렝 여행 동선에서 함께 즐길 수 있는 해안 풍경.</p></article>,<article class="border-b border-sand-200 pb-5"><h3 class="font-semibold text-ocean-900 mb-2">Poganda</h3><p class="text-sm text-ocean-600 leading-relaxed">방가이 여행에서 해변과 바다를 즐기기 좋은 대표 목적지.</p></article>,<article class="border-b border-sand-200 pb-5"><h3 class="font-semibold text-ocean-900 mb-2">Pulo Dua</h3><p class="text-sm text-ocean-600 leading-relaxed">더 긴 일정에서 섬과 바다를 경험할 수 있는 여행지.</p></article>,<article class="border-b border-sand-200 pb-5"><h3 class="font-semibold text-ocean-900 mb-2">Luwuk</h3><p class="text-sm text-ocean-600 leading-relaxed">공항 도착 후 방가이 제도 여행을 시작하기 좋은 출발점.</p></article>
        </div>
      </div>
    </section>
    <section class="bg-ocean-900 text-white py-20">
      <div class="max-w-3xl mx-auto px-5 text-center">
        <h2 class="font-serif text-4xl md:text-6xl mb-5">방가이 여행을 시작해 보세요</h2>
        <p class="text-white/75 leading-relaxed mb-8">여행 날짜, 인원, 원하는 목적지를 보내주시면 루욱에서 시작하는 여행 동선을 함께 구성해 드립니다.</p>
        <a href="https://wa.me/6285820830530" target="_blank" rel="noopener noreferrer" class="inline-flex rounded-full bg-white text-ocean-900 px-7 py-3.5 text-sm font-semibold">WhatsApp으로 상담하기 →</a>
      </div>
    </section>
  </div>
  <WhatsAppButton />
</BaseLayout>