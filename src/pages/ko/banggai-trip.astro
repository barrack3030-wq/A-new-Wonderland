---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';

const title = '방가이 트립 & 방가이 투어 | 루욱 출발 여행';
const description = '루욱에서 시작하는 방가이 트립과 방가이 투어. 파이수폭, 펠렝, 살라칸, 포간다, 풀라우 두아를 여행 기간에 맞춰 연결합니다.';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: 'Banggai Wonderland',
  url: 'https://banggaiwonderland.my.id/',
  description,
  areaServed: [
    { '@type': 'Place', name: 'Luwuk' },
    { '@type': 'Place', name: 'Banggai Islands' },
    { '@type': 'Place', name: 'Banggai Laut' }
  ]
};
---
<BaseLayout title={title} description={description} seoTitle={title} seoDescription={description} ogImage="/images/Poganda-Beach-Banggai-IndonesiaJuara-Trip.webp" imageAlt="Banggai Islands travel">
  <div class="bg-sand-50 pt-28">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-8">
      <Breadcrumb items={[{ name: '홈', url: '/ko/' }, { name: '방가이 트립', url: '/ko/banggai-trip/' }]} />
    </div>
    <section class="relative overflow-hidden bg-ocean-900 text-white">
      <img src="/images/Poganda-Beach-Banggai-IndonesiaJuara-Trip.webp" alt="방가이 트립" class="absolute inset-0 w-full h-full object-cover opacity-40" loading="eager" />
      <div class="absolute inset-0 bg-ocean-900/70"></div>
      <div class="relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-20 md:py-28">
        <p class="text-white/65 text-xs font-bold tracking-[0.24em] uppercase mb-5">BANGGAI TRIP · BANGGAI TOUR</p>
        <h1 class="font-serif text-4xl sm:text-5xl md:text-7xl leading-[0.98] max-w-4xl mb-7">방가이 트립 & 방가이 투어</h1>
        <p class="text-white/80 text-base md:text-xl leading-relaxed max-w-3xl mb-9">여행 기간에 따라 짧은 루욱 여행부터 파이수폭과 펠렝을 포함한 멀티데이 아일랜드 여행까지 계획할 수 있습니다.</p>
        <div class="flex flex-wrap gap-3">
          <a href="https://wa.me/6285820830530" target="_blank" rel="noopener noreferrer" class="rounded-full bg-white text-ocean-900 px-6 py-3.5 text-sm font-semibold">내 일정 상담하기 →</a>
          <a href="/ko/banggai-travel/" class="rounded-full border border-white/25 bg-white/10 px-6 py-3.5 text-sm font-semibold">방가이 트래블</a>
          <a href="/ko/banggai-open-trip/" class="rounded-full border border-white/25 bg-white/10 px-6 py-3.5 text-sm font-semibold">오픈 트립</a>
        </div>
      </div>
    </section>
    <section class="bg-white py-16 md:py-24">
      <div class="max-w-4xl mx-auto px-5 sm:px-8">
        <h2 class="font-serif text-3xl md:text-5xl text-ocean-900 mb-6">방가이 트립은 어떻게 구성하나요?</h2>
        <p class="text-ocean-600 leading-relaxed mb-5">방가이 제도 여행은 목적지를 많이 넣는 것보다 이동 시간을 현실적으로 계산하는 것이 중요합니다. 루욱 도착 시간, 살라칸 이동, 펠렝으로 건너가는 교통편과 현지 보트 시간을 함께 고려해야 합니다.</p>
        <p class="text-ocean-600 leading-relaxed">한국에서 출발한다면 일반적으로 서울 → 마나도 → 루욱을 거쳐 여행을 시작하고, 이후 살라칸과 펠렝 방향으로 이동합니다. 정확한 연결편은 여행 날짜에 맞춰 상담합니다.</p>
      </div>
    </section>
    <section class="bg-sand-50 py-16 md:py-24">
      <div class="max-w-5xl mx-auto px-5 sm:px-8">
        <h2 class="font-serif text-3xl md:text-5xl text-ocean-900 mb-8">추천 여행 구성</h2>
        <div class="grid md:grid-cols-2 gap-5">
          <article class="rounded-2xl border border-sand-200 bg-white p-7"><h3 class="font-serif text-2xl text-ocean-900 mb-3">짧은 일정 · 1–2일</h3><p class="text-ocean-600 leading-relaxed">루욱 중심의 짧은 여행. 도착 시간과 출발 시간을 기준으로 주변 목적지를 선택합니다.</p></article>,<article class="rounded-2xl border border-sand-200 bg-white p-7"><h3 class="font-serif text-2xl text-ocean-900 mb-3">파이수폭 중심 · 4D3N</h3><p class="text-ocean-600 leading-relaxed">파이수폭, 파이수 바탕고, 카왈루 베이, 포간다를 중심으로 구성하는 대표적인 섬 여행.</p></article>,<article class="rounded-2xl border border-sand-200 bg-white p-7"><h3 class="font-serif text-2xl text-ocean-900 mb-3">펠렝 탐험 · 5D4N</h3><p class="text-ocean-600 leading-relaxed">파이수폭 핵심 일정에 오야마, 롱비치 등 펠렝의 해안 목적지를 추가합니다.</p></article>,<article class="rounded-2xl border border-sand-200 bg-white p-7"><h3 class="font-serif text-2xl text-ocean-900 mb-3">방가이 익스플로러 · 6D5N 이상</h3><p class="text-ocean-600 leading-relaxed">더 긴 일정으로 펠렝과 주변 섬, 풀라우 두아까지 연결할 수 있습니다.</p></article>
        </div>
      </div>
    </section>
    <section class="bg-white py-16 md:py-24">
      <div class="max-w-4xl mx-auto px-5 sm:px-8">
        <h2 class="font-serif text-3xl md:text-5xl text-ocean-900 mb-8">여행 전에 알아둘 점</h2>
        <div class="space-y-4 text-ocean-600 leading-relaxed">
          <p><strong class="text-ocean-900">섬 이동:</strong> 페리와 현지 보트 운항은 날씨와 해상 상황에 영향을 받을 수 있습니다.</p>
          <p><strong class="text-ocean-900">일정 유연성:</strong> 방가이 여행은 이동 자체가 여행의 일부이므로 일정에 여유를 두는 것이 좋습니다.</p>
          <p><strong class="text-ocean-900">맞춤 일정:</strong> 같은 목적지라도 도착·출발 시간에 따라 가장 효율적인 순서가 달라질 수 있습니다.</p>
        </div>
      </div>
    </section>
    <section class="bg-ocean-900 text-white py-20">
      <div class="max-w-3xl mx-auto px-5 text-center">
        <h2 class="font-serif text-4xl md:text-6xl mb-5">나만의 방가이 트립을 계획하세요</h2>
        <p class="text-white/75 leading-relaxed mb-8">날짜와 인원을 보내주시면 가능한 여행 동선과 프로그램을 상담해 드립니다.</p>
        <a href="https://wa.me/6285820830530" target="_blank" rel="noopener noreferrer" class="inline-flex rounded-full bg-white text-ocean-900 px-7 py-3.5 text-sm font-semibold">여행 상담하기 →</a>
      </div>
    </section>
  </div>
  <WhatsAppButton />
</BaseLayout>