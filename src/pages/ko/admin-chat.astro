---
<!doctype html>
<html lang="ko"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>한국어 상담 관리자 | Banggai Wonderland</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#071d27;color:#edf7f8;font-family:Inter,system-ui,sans-serif}.wrap{width:min(1180px,94%);margin:auto;padding:28px 0 60px}.top{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:20px}.top h1{margin:0;font-size:28px}.top p{margin:7px 0 0;color:#91aeb5;font-size:12px}.card{background:#0b2a36;border:1px solid rgba(255,255,255,.1);padding:18px;margin-bottom:14px}input,textarea{width:100%;border:1px solid #31515c;background:#061923;color:#fff;padding:11px;font:inherit;outline:0}textarea{min-height:100px;resize:vertical}button{border:0;background:#d9ece9;color:#08232d;padding:11px 15px;font-weight:800;cursor:pointer}button.secondary{background:#173d49;color:#d8e8eb}.login{display:grid;grid-template-columns:1fr auto;gap:10px}.layout{display:grid;grid-template-columns:360px 1fr;gap:14px}.list{max-height:650px;overflow:auto}.item{padding:13px;border-bottom:1px solid rgba(255,255,255,.08);cursor:pointer}.item.active{background:#123946}.item strong{display:block;font-size:12px}.item small{display:block;color:#86a4ac;margin-top:5px;font-size:9px}.badge{float:right;font-size:8px;padding:4px 6px;background:#294e5a}.messages{height:430px;overflow:auto;padding:10px;background:#061923}.msg{max-width:75%;padding:10px;margin:7px 0;font-size:12px;line-height:1.6}.msg.visitor{margin-left:auto;background:#164654}.msg.admin{background:#edf5f3;color:#163942}.meta{font-size:9px;opacity:.55;margin-top:5px}.info{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:10px}.info div{background:#09232d;padding:10px}.info small{display:block;color:#7e9ba2;font-size:8px}.info strong{display:block;margin-top:4px;font-size:10px;word-break:break-word}.reply{margin-top:10px}.status{min-height:18px;color:#91aeb5;font-size:11px;margin-top:8px}@media(max-width:800px){.layout{grid-template-columns:1fr}.list{max-height:330px}.info{grid-template-columns:1fr 1fr}.login{grid-template-columns:1fr}}
</style></head>
<body><main class="wrap">
<header class="top"><div><h1>한국어 여행 상담</h1><p>Banggai Wonderland · Korean Chat Admin</p></div><button id="refresh" class="secondary" type="button">새로고침</button></header>
<section class="card"><div class="login"><input id="key" type="password" placeholder="CMS access key"/><button id="connect" type="button">관리자 연결</button></div><div id="status" class="status">CMS access key를 입력하면 상담 목록을 불러옵니다.</div></section>
<div class="layout"><section class="card list" id="list"></section><section class="card">
<div class="info" id="info" hidden><div><small>이름</small><strong id="name">-</strong></div><div><small>Kakao ID</small><strong id="kakao">-</strong></div><div><small>이메일</small><strong id="email">-</strong></div></div>
<div class="messages" id="messages"><div style="color:#78949c;font-size:12px;padding:15px">상담을 선택하세요.</div></div>
<div class="reply" id="reply" hidden><textarea id="replyText" placeholder="한국어로 답변을 입력하세요."></textarea><div style="display:flex;gap:8px;margin-top:8px"><button id="send" type="button">답변 보내기</button><button id="closeChat" class="secondary" type="button">상담 종료</button></div></div>
</section></div></main>
<script>
const endpoint='https://script.google.com/macros/s/AKfycbxGMuyFzq0K-gKIPaamp1ClFqo6zYJfNNvZfd0hxeJIJTj0N_DVPywUtkWbo5g0_F08/exec',keyEl=document.getElementById('key'),statusEl=document.getElementById('status'),listEl=document.getElementById('list'),messagesEl=document.getElementById('messages'),infoEl=document.getElementById('info'),replyEl=document.getElementById('reply'),replyText=document.getElementById('replyText');
let conversations=[],selected=null,timer=null;
const esc=v=>String(v??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const post=async payload=>{const r=await fetch(endpoint,{method:'POST',headers:{'Content-Type':'text/plain;charset=utf-8','Accept':'application/json'},body:JSON.stringify(payload),cache:'no-store'});const d=await r.json();if(!d.ok)throw new Error(d.error||'요청 실패');return d;};
const setStatus=t=>statusEl.textContent=t;
async function loadList(){const key=keyEl.value.trim();if(!key)return;try{const d=await post({action:'chatList',accessKey:key});conversations=d.conversations||[];renderList();if(selected)await openConversation(selected);setStatus('연결됨 · '+conversations.length+'개 상담');}catch(e){setStatus(e.message||'연결 실패');}}
function renderList(){listEl.innerHTML=conversations.length?conversations.map(c=>'<div class="item '+(selected===c.conversation_id?'active':'')+'" data-id="'+esc(c.conversation_id)+'"><span class="badge">'+esc(c.status)+'</span><strong>'+esc(c.name||'방문자')+'</strong><small>'+esc(c.kakao_id?'Kakao: '+c.kakao_id:'Kakao ID 없음')+' · '+new Date(c.updated_at).toLocaleString('ko-KR')+'</small><small>'+esc(c.conversation_id)+'</small></div>').join(''):'<div style="color:#78949c;font-size:12px">아직 상담 요청이 없습니다.</div>';listEl.querySelectorAll('.item').forEach(el=>el.addEventListener('click',()=>openConversation(el.dataset.id)));}
async function openConversation(id){selected=id;renderList();try{const c=conversations.find(x=>x.conversation_id===id)||{};const d=await post({action:'chatGet',language:'ko',admin:true,conversation_id:id,accessKey:keyEl.value.trim()});document.getElementById('name').textContent=c.name||d.conversation.name||'-';document.getElementById('kakao').textContent=c.kakao_id||'-';document.getElementById('email').textContent=c.email||'-';infoEl.hidden=false;messagesEl.innerHTML=(d.conversation.messages||[]).map(m=>'<div class="msg '+(m.sender==='admin'?'admin':'visitor')+'">'+esc(m.message).replace(/\n/g,'<br>')+'<div class="meta">'+(m.sender==='admin'?'Admin':'방문자')+' · '+new Date(m.created_at).toLocaleString('ko-KR')+'</div></div>').join('');messagesEl.scrollTop=messagesEl.scrollHeight;replyEl.hidden=d.conversation.status==='closed';}catch(e){setStatus(e.message||'상담을 불러오지 못했습니다.');}}
document.getElementById('connect').addEventListener('click',loadList);document.getElementById('refresh').addEventListener('click',loadList);
document.getElementById('send').addEventListener('click',async()=>{const m=replyText.value.trim();if(!selected||!m)return;try{await post({action:'chatReply',accessKey:keyEl.value.trim(),conversation_id:selected,message:m});replyText.value='';await loadList();}catch(e){setStatus(e.message||'답변 실패');}});
document.getElementById('closeChat').addEventListener('click',async()=>{if(!selected)return;try{await post({action:'chatStatus',accessKey:keyEl.value.trim(),conversation_id:selected,status:'closed'});await loadList();}catch(e){setStatus(e.message||'상담 종료 실패');}});
timer=setInterval(()=>{if(keyEl.value.trim())loadList();},5000);
</script></body></html>